ontinuous predictors (z-score). Use population std (ddof=0) for stability.\n    for c in cont_cols:\n        mean = df[c].mean()\n        std = df[c].std(ddof=0)\n        # If std is zero (unlikely), set z to 0 to avoid division by zero\n        if std == 0 or pd.isna(std):\n            df[c + '_z'] = 0.0\n        else:\n            df[c + '_z'] = (df[c] - mean) / std\n\n    # Final columns to keep for modeling (names must match those used in the model function)\n    final_cols = [\n        'accept',\n        'female',\n        'black',\n        'self_employed',\n        'married',\n        'bad_history',\n        'denied_PMI',\n        'housing_expense_ratio_z',\n        'PI_ratio_z',\n        'loan_to_value_z',\n        'mortgage_credit_z',\n        'consumer_credit_z'\n    ]\n\n    # Return only the final columns (preserves row index)\n    return df[final_cols]\n",
