  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    # Work on a copy\n    df = df.copy()\n\n    # Keep only rows with a player photo (ties), and with both rater scores available\n    df = df[df['ties'].notna()]\n    df = df[df['rater1'].notna() & df['rater2'].notna()]\n\n    # Ensure rater columns are numeric (they are normalized to a 0-1 scale representing the 5-point ratings)\n    df['rater1'] = pd.to_numeric(df['rater1'], errors='coerce')\n    df['rater2'] = pd.to_numeric(df['rater2'], errors='coerce')\n\n    # Average the two independent rater scores to get a continuous skin-tone measure\n    df['SkinToneAvg'] = (df['rater1'] + df['rater2']) / 2.0\n\n    # Create categorical skin tone groups so we can compare 'Dark' vs 'Light'.\n    # Based on the normalized 5-point scale mapping into {0, .25, .5, .75, 1.0},\n    # use thresholds: <=0.25 -> Light, >=0.75 -> Dark, middle values -> Medium.\n    df['SkinCategory'] = pd.cut(df['SkinToneAvg'], bins=[-0.01, 0.25, 0.75, 1.01], labels=['Light', 'Medium', 'Dark'])\n\n    # Keep only clear Light vs Dark cases for the primary comparison\n    df = df[df['SkinCategory'].isin(['Light', 'Dark'])].copy()\n\n    # Binary indicator for dark skin\n    df['DarkSkin'] = (df['SkinCategory'] == 'Dark').astype(int)\n\n    # Dependent variable: number of red cards received from the referee in this dyad\n    # (photoID column per schema corresponds to red-card count and ranges 0-2 in the dataset sample)\n    df['red_card_count'] = pd.to_numeric(df['photoID'], errors='coerce')\n\n    # Exposure: number of matches the player and referee encountered (redCards column per schema)\n    df['ExposureMatches'] = pd.to_numeric(df['redCards'], errors='coerce')\n\n    # Controls: coerce to numeric\n    df['meanIAT'] = pd.to_numeric(df['meanIAT'], errors='coerce')\n    df['club'] = pd.to_numeric(df['club'], errors='coerce')\n    df['playerShort'] = pd.to_numeric(df['playerShort'], errors='coerce')\n\n    # Keep only rows with non-missing dependent variable and a positive exposure\n    df = df[df['red_card_count'].notnull() & df['ExposureMatches'].notnull() & (df['ExposureMatches'] > 0)].copy()\n\n    # Drop rows missing any of the key controls (choose complete-case analysis for primary model)\n    df = df.dropna(subset=['meanIAT', 'club', 'playerShort', 'victories'])\n\n    # Reset index for cleanliness\n    df = df.reset_index(drop=True)\n\n    return df\n",
  "m_code": "def model(df: pd.DataFrame):\n    # Negative binomial regression for count outcome with exposure (number of matches)\n    # Uses a log-offset of ExposureMatches so coefficients represent rate ratios per match.\n    import statsmodels.formula.api as smf\n    import statsmodels.api as sm\n    import numpy as np\n\n    # Work on a copy\n    df = df.copy()\n\n    # Primary model specification: effect of DarkSkin on red card rate, controlling for\n    # meanIAT (implicit bias), club (explicit bias), playerShort (yellow cards from same referee),\n    # and league fixed effects (victories). Exposure is number of matches (ExposureMatches).\n    formula = 'red_card_count ~ DarkSkin + meanIAT + club + playerShort + C(victories)'\n\n    # Fit GLM with Negative Binomial family and offset = log(exposure)\n    # Note: offset takes the log of the exposure so modeled quantity is red cards per match.\n    model = smf.glm(formula=formula,\n                    data=df,\n                    family=sm.families.NegativeBinomial(),\n                    offset=np.log(df['ExposureMatches'])).fit()\n\n    # Return the fitted model object (caller can inspect summary(), params, conf_int(), etc.)\n    return model\n"
