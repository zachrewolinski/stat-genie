result_robust = result.get_robustcov_results(cov_type='cluster', groups=data['refNum'])\n        except Exception:\n            # Fall back to HC1 robust covariances\n            result_robust = result.get_robustcov_results(cov_type='HC1')\n    else:\n        result_robust = result.get_robustcov_results(cov_type='HC1')\n\n    # Return the robust result object (contains parameters, clustered SEs, p-values, and summary())\n    return result_robust\n"
