{
  "cvars": {
    "ivs": [
      {
        "description": "Instructor physical attractiveness (standardized). Original column 'beauty' is an average rating (mean shifted to zero); here we standardize to mean 0 and SD 1 for coefficient interpretability.",
        "columns": [
          "beauty_std"
        ]
      }
    ],
    "dv": {
      "description": "Teaching evaluation score (course overall evaluation). This is the original 'eval' column, renamed to 'Eval' in the transformed dataframe.",
      "columns": [
        "Eval"
      ]
    },
    "controls": [
      {
        "description": "Instructor gender (1 = female, 0 = male). Included as a main effect and tested as a moderator of beauty (interaction).",
        "is_moderator": true,
        "moderator_on": "beauty_std",
        "columns": [
          "IsFemale"
        ]
      },
      {
        "description": "Instructor minority status (1 = yes, 0 = no).",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "IsMinority"
        ]
      },
      {
        "description": "Tenure status (1 = on tenure track / yes, 0 = no).",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "IsTenure"
        ]
      },
      {
        "description": "Native English speaker (1 = yes, 0 = no).",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "IsNative"
        ]
      },
      {
        "description": "Single-credit course indicator (1 = single-credit elective, 0 = otherwise).",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "IsSingleCredit"
        ]
      },
      {
        "description": "Upper-division course indicator (1 = upper, 0 = lower).",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "IsUpperDivision"
        ]
      },
      {
        "description": "Instructor age (standardized).",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "Age_z"
        ]
      },
      {
        "description": "Number of students in evaluation (standardized).",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "Students_z"
        ]
      },
      {
        "description": "Professor identifier used for clustering standard errors (not a regression covariate).",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "prof"
        ]
      }
    ]
  },
  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw Hamermesh dataset into a modeling-ready dataframe.\n    Outputs the columns used in the model:\n      - Eval: dependent variable (same as 'eval')\n      - beauty_std: standardized beauty score\n      - IsFemale, IsMinority, IsTenure, IsNative, IsSingleCredit, IsUpperDivision: binary controls\n      - Age_z, Students_z: standardized continuous controls\n      - prof: professor id (kept for clustering)\n    \"\"\"\n    # Work on a copy\n    df = df.copy()\n\n    # Drop rows missing key variables: beauty, eval, and core covariates used below\n    required_cols = [\n        'beauty', 'eval', 'gender', 'minority', 'tenure', 'native',\n        'credits', 'division', 'age', 'students', 'prof'\n    ]\n    df = df.dropna(subset=required_cols)\n\n    # Dependent variable: keep original eval but rename for clarity\n    df['Eval'] = df['eval'].astype(float)\n\n    # Independent variable: standardized beauty\n    df['beauty_std'] = (df['beauty'] - df['beauty'].mean()) / df['beauty'].std(ddof=0)\n\n    # Binary control variables (explicit mappings)\n    df['IsFemale'] = (df['gender'].astype(str).str.lower() == 'female').astype(int)\n    df['IsMinority'] = (df['minority'].astype(str).str.lower() == 'yes').astype(int)\n    df['IsTenure'] = (df['tenure'].astype(str).str.lower() == 'yes').astype(int)\n    df['IsNative'] = (df['native'].astype(str).str.lower() == 'yes').astype(int)\n    df['IsSingleCredit'] = (df['credits'].astype(str).str.lower() == 'single').astype(int)\n    df['IsUpperDivision'] = (df['division'].astype(str).str.lower() == 'upper').astype(int)\n\n    # Standardize continuous covariates for interpretability\n    df['Age_z'] = (df['age'] - df['age'].mean()) / df['age'].std(ddof=0)\n    df['Students_z'] = (df['students'] - df['students'].mean()) / df['students'].std(ddof=0)\n\n    # Ensure professor id is integer (used for clustering)\n    df['prof'] = df['prof'].astype(int)\n\n    # Final: keep only columns needed for modeling to avoid accidental usage of others\n    keep_cols = [\n        'Eval', 'beauty_std', 'IsFemale', 'IsMinority', 'IsTenure', 'IsNative',\n        'IsSingleCredit', 'IsUpperDivision', 'Age_z', 'Students_z', 'prof'\n    ]\n    df = df.loc[:, keep_cols]\n\n    return df\n",
  "m_code": "def model(df: pd.DataFrame):\n    \"\"\"\n    Fit an OLS model estimating the effect of standardized beauty (beauty_std) on teaching evaluations (Eval).\n    The model includes covariates and an interaction testing whether the beauty effect differs by instructor gender.\n    Cluster-robust standard errors are computed at the professor level ('prof').\n\n    Model formula:\n      Eval ~ beauty_std * IsFemale + IsMinority + IsTenure + IsNative + IsSingleCredit + IsUpperDivision + Age_z + Students_z\n\n    Returns the fitted results object (statsmodels RegressionResultsWrapper) with clustered SEs.\n    \"\"\"\n    import statsmodels.formula.api as smf\n\n    # Ensure required columns exist\n    required = ['Eval', 'beauty_std', 'IsFemale', 'IsMinority', 'IsTenure', 'IsNative',\n                'IsSingleCredit', 'IsUpperDivision', 'Age_z', 'Students_z', 'prof']\n    missing = [c for c in required if c not in df.columns]\n    if missing:\n        raise ValueError(f\"Missing columns in dataframe required for modeling: {missing}\")\n\n    formula = (\n        'Eval ~ beauty_std * IsFemale + IsMinority + IsTenure + IsNative '\n        '+ IsSingleCredit + IsUpperDivision + Age_z + Students_z'\n    )\n\n    mod = smf.ols(formula=formula, data=df)\n    # Fit with cluster-robust SEs by professor id\n    results = mod.fit(cov_type='cluster', cov_kwds={'groups': df['prof']})\n\n    return results\n"
}
