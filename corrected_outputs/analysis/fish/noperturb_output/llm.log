        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "child"
        ]
      },
      {
        "description": "Binary indicator for whether any children are present in the group (1 = at least one child, 0 = no children). Controls for family groups vs adult-only groups.",
        "is_moderator": false,
