{
  "cvars": {
    "ivs": [
      {
        "description": "Use of live bait during the visit (binary: 1 = used live bait, 0 = did not). Hypothesized to increase catch rate.",
        "columns": [
          "livebait"
        ]
      },
      {
        "description": "Whether the group had a camper (binary: 1 = camper present, 0 = no camper). May correlate with effort/experience and influence catch rate.",
        "columns": [
