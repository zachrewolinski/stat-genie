        "hours"
      ]
    },
    "controls": [
      {
        "description": "Total number of people (adults + children) in the group. Larger groups are expected to catch more fish and this controls for group size.",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "total_people"
        ]
      },
      {
