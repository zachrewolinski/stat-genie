S(y_ols, X_rob).fit(cov_type='HC3')\n    else:\n        ols_rob = None\n\n    results = {\n        'ols': ols_res,\n        'nb': nb_res,\n        'ols_mturk': ols_rob\n    }\n\n    return results\n"
