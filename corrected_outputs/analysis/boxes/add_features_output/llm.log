  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw dataset into a dataframe suitable for modeling the emergence of majority preference.\n\n    Produces the following columns used in modeling:\n      - MajorityChoice: binary outcome (1 if y==2 [majority], 0 otherwise)\n      - Age_c: age centered at the sample mean\n      - Age2: quadratic term (Age_c squared)\n      - culture: cast to categorical (kept as original code but converted to category dtype)\n      - IsBoy: 1 if gender == 2 (boy), 0 if gender == 1 (girl)\n      - MajorityFirst: binary copy of majority_first\n      - religiousness: numeric (coerced)\n      - school: kept as provided (string)\n\n    Rows missing the essential variables (y, age, culture) are dropped.\n    \"\"\"\n    # Work on a copy\n    df = df.copy()\n\n    # Drop rows missing core variables\n    df = df.dropna(subset=['y', 'age', 'culture'])\n\n    # Outcome: majority choice (y==2 indicates majority option)\n    df['MajorityChoice'] = (df['y'] == 2).astype(int)\n\n    # Age: center and create quadratic term to capture non-linear development\n    df['Age_c'] = df['age'].astype(float) - df['age'].astype(float).mean()\n    df['Age2'] = df['Age_c'] ** 2\n\n    # Culture: keep original column name but ensure categorical dtype for formulas\n    df['culture'] = df['culture'].astype('category')\n\n    # Gender -> binary control (1 = boy, 0 = girl). If gender uses different coding, this preserves given mapping 1=girl, 2=boy\n    df['IsBoy'] = (df['gender'] == 2).astype(int)\n\n    # Majority demonstration order as binary control\n    df['MajorityFirst'] = df['majority_first'].astype(int)\n\n    # Ensure religiousness is numeric (coerce and keep NA if invalid)\n    df['religiousness'] = pd.to_numeric(df.get('religiousness', pd.Series(dtype=float)), errors='coerce')\n\n    # Ensure school column exists (kept for clustering / multilevel analyses). If missing, create NA column.\n    if 'school' not in df.columns:\n        df['school'] = pd.NA\n\n    # Optional: drop rows missing critical model variables (outcome and predictors/controls used explicitly)\n    # Keep religiousness optional (so we don't unnecessarily drop many rows); model fitting will handle any remaining NAs.\n    df = df.dropna(subset=['MajorityChoice', 'Age_c', 'culture', 'IsBoy', 'MajorityFirst'])\n\n    return df\n",
  "m_code": "def model(df: pd.DataFrame):\n    \"\"\"\n    Fit a logistic regression predicting the probability of choosing the majority option.\n\n    Primary model: a GLM with binomial family where the key terms are Age_c and its interaction with culture\n    to test whether developmental trajectories (age slopes) differ across cultural contexts.\n\n    Formula used:\n      MajorityChoice ~ Age_c * C(culture) + Age2 + IsBoy + MajorityFirst + religiousness\n\n    We compute cluster-robust standard errors clustered by culture (the moderator) to account for within-site dependence.\n\n    Returns the fitted results object with cluster-robust covariance.\n    \"\"\"\n    import statsmodels.formula.api as smf\n    import statsmodels.api as sm\n\n    # Ensure categorical culture is available in dataframe; formula uses C(culture)\n    df = df.copy()\n    if 'culture' not in df.columns:\n        raise ValueError(\"'culture' column required in dataframe\")\n\n    # Formula: main effect of age, interaction of age with culture (tests differing slopes), quadratic age term, and controls\n    formula = 'MajorityChoice ~ Age_c * C(culture) + Age2 + IsBoy + MajorityFirst + religiousness'\n\n    # Fit GLM (binomial)\n    glm_model = smf.glm(formula=formula, data=df, family=sm.families.Binomial())\n    res = glm_model.fit()\n\n    # Compute cluster-robust covariance (cluster on culture). If culture is categorical, use its codes for grouping.\n    try:\n        groups = df['culture'].cat.codes if hasattr(df['culture'], 'cat') else df['culture']\n    except Exception:\n        groups = df['culture']\n\n    robust_res = res.get_robustcov_results(cov_type='cluster', groups=groups)\n\n    # Print a concise summary and return the robust results object for inspection\n    print(robust_res.summary())\n    return robust_res\n"
