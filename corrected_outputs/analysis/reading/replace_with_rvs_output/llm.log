        ]
      }
    ],
    "dv": {
      "description": "Log-transformed reading speed (natural log of speed after winsorization). Log transformation reduces skew and makes model residuals more Gaussian; winsorization reduces influence of extreme outliers.",
      "columns": [
        "LogSpeed"
      ]
    },
    "controls": [
      {
        "description": "Binary indicator for whether the reader has dyslexia (1 = dyslexia present, 0 = no dyslexia). Treated as a moderator of the Reader View effect to test whether Reader View benefits readers with dyslexia differentially.",
        "is_moderator": true,
        "moderator_on": "reader_view",
        "columns": [
          "dyslexia_bin"
        ]
      },
      {
        "description": "Number of words on the page (centered). Controls for text length which directly affects speed.",
