        ]
      },
      {
        "description": "Page identifier (categorical fixed effect) to soak up variation due to particular passages (e.g., content, layout).",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "page_id"
        ]
      },
      {
        "description": "Unique participant identifier. Used for clustering standard errors (controls for within-participant correlation across trials).",
        "is_moderator": false,
