id', 'num_words', 'retake_trial', 'correct_rate']\n    existing_covs = [c for c in covs_to_check if c in df.columns]\n    if existing_covs:\n        df = df.dropna(subset=existing_covs)\n\n    # Final sanity: ensure dyslexia_bin is 0/1 (if originally 0/1/2, user-provided dyslexia_bin should already be binary)\n    # If dyslexia column exists but dyslexia_bin does not, create dyslexia_bin from dyslexia (map >=1 to 1)\n    if 'dyslexia_bin' not in df.columns and 'dyslexia' in df.columns:\n        df['dyslexia_bin'] = df['dyslexia'].apply(lambda x: 1 if x >= 1 else 0)\n\n    # Return the transformed dataframe containing all columns needed by the model\n    return df\n",
