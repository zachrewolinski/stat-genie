        ]
      },
      {
        "description": "Page identifier (categorical). Included as fixed-effect categorical control to adjust for page-specific differences in layout/content.",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "page_id"
        ]
      },
      {
        "description": "Participant identifier. Used for clustering standard errors to account for repeated observations per participant (not a regressor).",
        "is_moderator": false,
