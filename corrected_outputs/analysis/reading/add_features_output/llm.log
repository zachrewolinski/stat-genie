      ]
    },
    "controls": [
      {
        "description": "Whether the reader has dyslexia (binary). This is treated as a moderator on the effect of reader_view: we will include reader_view * dyslexia_bin interaction to test whether Reader View helps dyslexic readers more.",
        "is_moderator": true,
        "moderator_on": "reader_view",
        "columns": [
          "dyslexia_bin"
        ]
      },
      {
        "description": "Participant age (in years). Control for reading speed differences due to age.",
