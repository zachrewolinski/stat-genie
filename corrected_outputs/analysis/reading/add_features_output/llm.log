        "columns": [
          "uuid"
        ]
      }
    ]
  },
  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    # Work on a copy\n    df = df.copy()\n\n    # Ensure key numeric columns are numeric and drop rows missing essential fields\n    df['adjusted_running_time'] = pd.to_numeric(df['adjusted_running_time'], errors='coerce')\n    df['num_words'] = pd.to_numeric(df['num_words'], errors='coerce')\n    df['reader_view'] = pd.to_numeric(df['reader_view'], errors='coerce')\n    df['dyslexia_bin'] = pd.to_numeric(df['dyslexia_bin'], errors='coerce')\n\n    df = df.dropna(subset=['adjusted_running_time', 'num_words', 'reader_view', 'dyslexia_bin', 'uuid'])\n\n    # Remove non-positive or extremely small adjusted times\n    df = df[df['adjusted_running_time'] > 0]\n\n    # Compute reading speed in words per second\n    # adjusted_running_time is in milliseconds according to schema\n    df['reading_speed_wps'] = df['num_words'] / (df['adjusted_running_time'] / 1000.0)\n\n    # Remove implausible extreme speeds (very slow or extremely fast) to reduce influence of measurement errors.\n    # Thresholds chosen conservatively: keep speeds between 0.5 and 20 words/sec (~30 to 1200 wpm).\n    df = df[(df['reading_speed_wps'] > 0.5) & (df['reading_speed_wps'] < 20)].copy()\n\n    # Log-transform reading speed to reduce skew and make effect sizes multiplicative\n    df['log_reading_speed'] = np.log(df['reading_speed_wps'])\n\n    # Ensure dyslexia_bin is binary 0/1\n    df['dyslexia_bin'] = df['dyslexia_bin'].astype(int)\n    df.loc[~df['dyslexia_bin'].isin([0, 1]), 'dyslexia_bin'] = df['dyslexia_bin'].clip(lower=0, upper=1).astype(int)\n\n    # Map english_native Y/N to binary; treat missing as 0 (non-native) conservatively\n    if 'english_native' in df.columns:\n        df['english_native_bin'] = df['english_native'].map({'Y': 1, 'N': 0})\n        df['english_native_bin'] = df['english_native_bin'].fillna(0).astype(int)\n    else:\n        df['english_native_bin'] = 0\n\n    # Ensure other controls have sensible types\n    df['age'] = pd.to_numeric(df['age'], errors='coerce')\n    df['retake_trial'] = pd.to_numeric(df.get('retake_trial', 0), errors='coerce').fillna(0).astype(int)\n\n    df['device'] = df['device'].fillna('unknown').astype('category')\n    df['page_id'] = df['page_id'].astype('category')\n\n    # Keep only columns required for modeling\n    keep_cols = [\n        'uuid', 'reader_view', 'dyslexia_bin', 'reading_speed_wps', 'log_reading_speed',\n        'age', 'device', 'english_native_bin', 'Flesch_Kincaid', 'num_words', 'retake_trial', 'page_id'\n    ]\n\n    # Some of these columns may not exist in all datasets; select intersection to avoid KeyError\n    keep_cols = [c for c in keep_cols if c in df.columns]\n    return df[keep_cols]\n",
  "m_code": "def model(df: pd.DataFrame):\n    import statsmodels.formula.api as smf\n\n    # Formula: interaction between reader_view and dyslexia_bin tests whether Reader View effects differ for dyslexic readers\n    formula = (\n        'log_reading_speed ~ reader_view * dyslexia_bin '\n        '+ age + C(device) + english_native_bin + Flesch_Kincaid + num_words + retake_trial + C(page_id)'\n    )\n\n    # Fit OLS and compute cluster-robust standard errors by participant uuid to account for within-subject correlation\n    ols_mod = smf.ols(formula, data=df)\n    results = ols_mod.fit(cov_type='cluster', cov_kwds={'groups': df['uuid']})\n\n    # Return the fitted results object (contains params, p-values, summary, etc.)\n    return results\n"
}
