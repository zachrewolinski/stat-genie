        ]
      }
    ],
    "dv": {
      "description": "Log of reading speed measured in words per second (natural log). Derived as log(num_words / (adjusted_running_time / 1000)). Using log reduces skew and makes coefficients interpretable as approximate percent changes.",
      "columns": [
