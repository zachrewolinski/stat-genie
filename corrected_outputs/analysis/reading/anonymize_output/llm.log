  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform raw dataset into analysis-ready dataframe.\n\n    Produces these columns used in the model:\n      - ReaderView (0/1)\n      - Dyslexia (0/1)\n      - ReadingTime_ms (feature5)\n      - Words (feature7)\n      - ReadingSpeed_wps (Words per second)\n      - Comprehension (feature8)\n      - Age (feature10)\n      - Device (feature11)\n      - NativeEnglish (1 if feature18 == 'Y', else 0)\n      - Retake (feature16)\n      - Flesch (feature19)\n\n    Filters out invalid/zero reading times or zero words and extreme outliers in ReadingSpeed_wps.\n    \"\"\"\n    df = df.copy()\n\n    # Standardize/rename source columns for clarity (we keep originals but add derived columns)\n    # ReaderView: feature3 (1 activated, 0 not)\n    df['ReaderView'] = pd.to_numeric(df['feature3'], errors='coerce').astype('Float64')\n\n    # Raw reading time excluding scrolling (ms) and words\n    df['ReadingTime_ms'] = pd.to_numeric(df['feature5'], errors='coerce')\n    df['Words'] = pd.to_numeric(df['feature7'], errors='coerce')\n\n    # Basic covariates\n    df['Comprehension'] = pd.to_numeric(df['feature8'], errors='coerce')\n    df['Age'] = pd.to_numeric(df['feature10'], errors='coerce')\n    df['Device'] = df['feature11'].astype('category')\n    df['Retake'] = pd.to_numeric(df['feature16'], errors='coerce').astype('Float64')\n    df['Flesch'] = pd.to_numeric(df['feature19'], errors='coerce')\n\n    # Native English speaker flag\n    df['NativeEnglish'] = df['feature18'].astype(str).str.upper().map({'Y': 1, 'N': 0})\n    df['NativeEnglish'] = pd.to_numeric(df['NativeEnglish'], errors='coerce').astype('Float64')\n\n    # Dyslexia: prefer feature12 (0=no,1=dyslexia,2=severe). If missing, fall back to feature17 (0/1 indicator)\n    # Create binary Dyslexia indicator: 1 for any dyslexia (including severe), 0 otherwise.\n    has_feat12 = df['feature12'].notna()\n    df['Dyslexia'] = pd.NA\n    if 'feature12' in df.columns:\n        # convert to numeric then create binary\n        df.loc[has_feat12, 'Dyslexia'] = (pd.to_numeric(df.loc[has_feat12, 'feature12'], errors='coerce') >= 1).astype('Int64')\n    # fallback to feature17 when feature12 is missing\n    fallback_mask = df['Dyslexia'].isna() & (df.get('feature17') is not None)\n    if 'feature17' in df.columns:\n        df.loc[fallback_mask, 'Dyslexia'] = (pd.to_numeric(df.loc[fallback_mask, 'feature17'], errors='coerce') == 1).astype('Int64')\n    # If still NA, set to 0 (conservative) OR keep NA so rows drop later; we'll keep NA to allow explicit dropping\n\n    # Compute reading speed: words / seconds = words / (ms/1000)\n    # Need to filter zeros and negatives to avoid divide-by-zero\n    df['ReadingSpeed_wps'] = pd.NA\n    valid_time_words = (df['ReadingTime_ms'].notna()) & (df['Words'].notna()) & (df['ReadingTime_ms'] > 0) & (df['Words'] > 0)\n    df.loc[valid_time_words, 'ReadingSpeed_wps'] = (df.loc[valid_time_words, 'Words'] * 1000.0 / df.loc[valid_time_words, 'ReadingTime_ms']).astype('Float64')\n\n    # Drop rows with missing values in the core analysis columns\n    keep_cols = ['ReaderView', 'Dyslexia', 'ReadingTime_ms', 'Words', 'ReadingSpeed_wps', 'Comprehension', 'Age', 'Device', 'NativeEnglish', 'Retake', 'Flesch']\n    df = df.dropna(subset=keep_cols)\n\n    # Convert ReaderView and Dyslexia to integer 0/1\n    df['ReaderView'] = df['ReaderView'].astype(int)\n    df['Dyslexia'] = df['Dyslexia'].astype(int)\n\n    # Remove extreme outliers in ReadingSpeed_wps to reduce influence of measurement errors\n    # Keep observations between the 0.5th and 99.5th percentiles\n    lower = df['ReadingSpeed_wps'].quantile(0.005)\n    upper = df['ReadingSpeed_wps'].quantile(0.995)\n    df = df[(df['ReadingSpeed_wps'] >= lower) & (df['ReadingSpeed_wps'] <= upper)]\n\n    # Reset index and return only the columns needed for the model (plus ReadingTime_ms for diagnostics)\n    result_cols = ['ReaderView', 'Dyslexia', 'ReadingTime_ms', 'Words', 'ReadingSpeed_wps', 'Comprehension', 'Age', 'Device', 'NativeEnglish', 'Retake', 'Flesch']\n    df = df.loc[:, result_cols].reset_index(drop=True)\n\n    return df\n",
  "m_code": "def model(df: pd.DataFrame) -> any:\n    \"\"\"\n    Fit an OLS model testing whether ReaderView improves reading speed, and whether that effect is moderated by dyslexia.\n\n    Model specification:\n      ReadingSpeed_wps ~ ReaderView * Dyslexia + Age + C(Device) + NativeEnglish + Retake + Flesch + Comprehension + Words\n\n    Returns the fitted statsmodels regression results object (so caller can inspect summary, params, etc.).\n    Robust (heteroskedasticity-consistent) standard errors (HC3) are used when returning the results object.\n    \"\"\"\n    import statsmodels.formula.api as smf\n\n    # Ensure required columns are present\n    required = ['ReadingSpeed_wps', 'ReaderView', 'Dyslexia', 'Age', 'Device', 'NativeEnglish', 'Retake', 'Flesch', 'Comprehension', 'Words']\n    missing = [c for c in required if c not in df.columns]\n    if len(missing) > 0:\n        raise ValueError(f\"Missing required columns for modeling: {missing}\")\n\n    # Drop any remaining NAs in model variables\n    model_df = df.dropna(subset=required).copy()\n\n    # Build formula. Device is treated as categorical using C(Device).\n    formula = 'ReadingSpeed_wps ~ ReaderView * Dyslexia + Age + C(Device) + NativeEnglish + Retake + Flesch + Comprehension + Words'\n\n    # Fit OLS\n    fit = smf.ols(formula=formula, data=model_df).fit()\n\n    # Also compute robust (HC3) covariance\n    fit_robust = fit.get_robustcov_results(cov_type='HC3')\n\n    # Return the robust-fit object (has .summary(), .params, etc.)\n    return fit_robust\n"
}
