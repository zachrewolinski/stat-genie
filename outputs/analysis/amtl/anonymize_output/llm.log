  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw dataset into a dataframe suitable for binomial GLM.\n\n    Steps:\n    - Rename raw feature columns to meaningful names used in the model.\n    - Drop rows missing required fields.\n    - Ensure counts are integer and compute n_present = n_obs - n_missing.\n    - Remove rows with inconsistent counts (n_present < 0) or zero trials.\n    - Create amtl_prop for diagnostics and is_human, Sex_Male, Tooth class dummies, and centered age (Age_c).\n\n    The returned dataframe contains all columns referenced by the model code:\n    ['n_missing', 'n_present', 'amtl_prop', 'is_human', 'Sex_Male', 'Tooth_Anterior', 'Tooth_Premolar', 'Age_c', 'Genus', 'ToothClass']\n    \"\"\"\n    df = df.copy()\n\n    # Rename features to meaningful names used in modeling\n    rename_map = {\n        'feature1': 'ToothClass',    # Anterior, Posterior, Premolar\n        'feature2': 'SpecimenID',\n        'feature3': 'n_missing',     # number of teeth missing of given class\n        'feature4': 'n_obs',         # number of observable sockets\n        'feature5': 'Age',           # estimated age at death\n        'feature6': 'AgeSD',         # uncertainty of age\n        'feature7': 'SexEstimate',   # estimate of sex (continuous 0-1)\n        'feature8': 'Genus',         # genus name\n        'feature9': 'Region'\n    }\n    df = df.rename(columns=rename_map)\n\n    # Drop rows missing essential data\n    required_cols = ['n_missing', 'n_obs', 'Age', 'SexEstimate', 'ToothClass', 'Genus']\n    df = df.dropna(subset=required_cols)\n\n    # Ensure numeric types for counts\n    df['n_missing'] = pd.to_numeric(df['n_missing'], errors='coerce')\n    df['n_obs'] = pd.to_numeric(df['n_obs'], errors='coerce')\n    df = df.dropna(subset=['n_missing', 'n_obs'])\n\n    # Cast to integer (counts)\n    # Use rounding to nearest integer in case of float representations\n    df['n_missing'] = df['n_missing'].round().astype(int)\n    df['n_obs'] = df['n_obs'].round().astype(int)\n\n    # Compute number of present teeth (failures for the binomial)\n    df['n_present'] = df['n_obs'] - df['n_missing']\n\n    # Remove inconsistent rows where present is negative or where n_obs == 0\n    df = df[df['n_present'] >= 0]\n    df = df[df['n_obs'] > 0]\n\n    # Proportion for diagnostics\n    df['amtl_prop'] = df['n_missing'] / df['n_obs']\n\n    # Create binary indicator for modern humans (Homo sapiens)\n    # Normalize genus strings and compare\n    df['Genus'] = df['Genus'].astype(str).str.strip()\n    df['is_human'] = (df['Genus'].str.lower() == 'homo sapiens').astype(int)\n\n    # Create binary sex variable: Sex_Male = 1 if SexEstimate >= 0.5, else 0\n    # (SexEstimate often encodes male=1, female=0 with uncertainty; threshold at 0.5 is a pragmatic choice)\n    df['Sex_Male'] = (pd.to_numeric(df['SexEstimate'], errors='coerce') >= 0.5).astype(int)\n\n    # Tooth class dummies: make Posterior the reference category\n    df['ToothClass'] = df['ToothClass'].astype(str).str.strip()\n    df['Tooth_Anterior'] = (df['ToothClass'].str.lower() == 'anterior').astype(int)\n    df['Tooth_Premolar'] = (df['ToothClass'].str.lower() == 'premolar').astype(int)\n\n    # Center age for interpretability (Age_c)\n    df['Age'] = pd.to_numeric(df['Age'], errors='coerce')\n    df = df.dropna(subset=['Age'])\n    df['Age_c'] = df['Age'] - df['Age'].mean()\n\n    # Keep only columns needed for modeling and diagnostics\n    keep_cols = [\n        'SpecimenID', 'Genus', 'Region', 'ToothClass',\n        'n_missing', 'n_present', 'n_obs', 'amtl_prop',\n        'is_human', 'Sex_Male', 'Tooth_Anterior', 'Tooth_Premolar',\n        'Age', 'Age_c', 'AgeSD'\n    ]\n    existing_keep = [c for c in keep_cols if c in df.columns]\n    df = df[existing_keep]\n\n    return df\n",
  "m_code": "def model(df: pd.DataFrame):\n    \"\"\"\n    Fit a binomial GLM predicting antemortem tooth loss (AMTL) with the following specification:\n      Response: two-column array of counts [n_missing, n_present] (successes, failures)\n      Predictors: is_human + Age_c + Sex_Male + Tooth_Anterior + Tooth_Premolar\n\n    Returns the fitted GLM results object (statsmodels.genmod.generalized_linear_model.GLMResults).\n\n    Interpretation: The coefficient for 'is_human' is on the log-odds scale; exp(coef) gives the odds ratio for AMTL (missing vs present) for humans vs non-humans, controlling for the other covariates.\n    \"\"\"\n    df = df.copy()\n\n    # Ensure required columns exist\n    required = ['n_missing', 'n_present', 'is_human', 'Age_c', 'Sex_Male', 'Tooth_Anterior', 'Tooth_Premolar']\n    missing = [c for c in required if c not in df.columns]\n    if missing:\n        raise ValueError('The following required columns are missing from the input dataframe: ' + ','.join(missing))\n\n    # Construct endog as a two-column array [successes, failures]\n    endog = df[['n_missing', 'n_present']].values\n\n    # Construct exog (design matrix)\n    exog = df[['is_human', 'Age_c', 'Sex_Male', 'Tooth_Anterior', 'Tooth_Premolar']].astype(float)\n    exog = sm.add_constant(exog, has_constant='add')\n\n    # Fit binomial GLM using the two-column response format\n    glm_binom = sm.GLM(endog, exog, family=sm.families.Binomial())\n    results = glm_binom.fit()\n\n    # You can inspect results.summary() externally. Return the results object for further inspection.\n    return results\n"
