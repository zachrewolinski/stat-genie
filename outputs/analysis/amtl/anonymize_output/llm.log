  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw dataset into the analysis-ready dataframe.\n\n    Produces the following columns used by the model:\n      - MissingCount: feature3, number of teeth missing for that tooth class\n      - Trials: feature4, number of observable sockets (number of teeth that could be scored)\n      - NonMissing: Trials - MissingCount (derived)\n      - PropMissing: MissingCount / Trials (derived, informative)\n      - Age: feature5\n      - Sex: feature7\n      - ToothClass: feature1 (categorical: Anterior/Posterior/Premolar)\n      - Genus: feature8 (original genus string)\n      - IsHuman: binary indicator for Homo sapiens (1) vs non-human (0)\n      - SpecimenID: feature2\n    \"\"\"\n    df = df.copy()\n\n    # Rename columns to analysis-friendly names\n    df = df.rename(columns={\n        'feature1': 'ToothClass',\n        'feature2': 'SpecimenID',\n        'feature3': 'MissingCount',\n        'feature4': 'SocketCount',\n        'feature5': 'Age',\n        'feature6': 'AgeUncertainty',\n        'feature7': 'Sex',\n        'feature8': 'Genus',\n        'feature9': 'Region'\n    })\n\n    # Keep only rows with necessary data\n    required_cols = ['MissingCount', 'SocketCount', 'Age', 'Sex', 'ToothClass', 'Genus', 'SpecimenID']\n    df = df.dropna(subset=required_cols)\n\n    # Ensure numeric types for counts and age\n    df['MissingCount'] = pd.to_numeric(df['MissingCount'], errors='coerce')\n    df['SocketCount'] = pd.to_numeric(df['SocketCount'], errors='coerce')\n    df['Age'] = pd.to_numeric(df['Age'], errors='coerce')\n    df['Sex'] = pd.to_numeric(df['Sex'], errors='coerce')\n\n    # Remove rows with non-positive or invalid socket counts\n    df = df[df['SocketCount'] > 0]\n\n    # Remove rows where MissingCount is greater than SocketCount (invalid)\n    df = df[df['MissingCount'] <= df['SocketCount']]\n\n    # Derive trial counts and proportions\n    df['Trials'] = df['SocketCount'].astype(int)\n    # Ensure MissingCount is integer (counts)\n    df['MissingCount'] = df['MissingCount'].astype(int)\n    df['NonMissing'] = df['Trials'] - df['MissingCount']\n    df['PropMissing'] = df['MissingCount'] / df['Trials']\n\n    # Create binary indicator for modern humans\n    df['Genus'] = df['Genus'].astype(str)\n    df['IsHuman'] = (df['Genus'].str.strip() == 'Homo sapiens').astype(int)\n\n    # Normalize tooth class strings and set as categorical\n    df['ToothClass'] = df['ToothClass'].astype(str).str.strip().str.capitalize()\n    # If there are unexpected names, keep them but warn (not raised here)\n    df['ToothClass'] = df['ToothClass'].astype('category')\n\n    # Ensure SpecimenID is string (for clustering later)\n    df['SpecimenID'] = df['SpecimenID'].astype(str)\n\n    # Final drop of any rows with missing model-critical values introduced by coercion\n    df = df.dropna(subset=['MissingCount', 'Trials', 'IsHuman', 'Age', 'Sex', 'ToothClass', 'SpecimenID'])\n\n    # Reset index for cleanliness\n    df = df.reset_index(drop=True)\n\n    return df\n",
  "m_code": "def model(df: pd.DataFrame) -> Any:\n    \"\"\"\n    Fit a binomial GLM to test whether modern humans have higher AMTL than non-human primates,\n    controlling for age, sex, and tooth class. Clustered standard errors by specimen are computed\n    to account for multiple tooth-class observations per specimen.\n\n    Model specification (proportion form with frequency weights = Trials):\n      MissingCount / Trials ~ IsHuman + Age + Sex + C(ToothClass)\n\n    Returns the fitted GLM object and a clustered-robust-covariance version of the results.\n    \"\"\"\n    import statsmodels.formula.api as smf\n    import statsmodels.api as sm\n\n    # Drop any remaining rows with NA in columns used by the model\n    df = df.dropna(subset=['MissingCount', 'Trials', 'IsHuman', 'Age', 'Sex', 'ToothClass', 'SpecimenID'])\n\n    # Build formula: proportion modeled with binomial family and frequency weights = Trials\n    formula = 'MissingCount / Trials ~ IsHuman + Age + Sex + C(ToothClass)'\n\n    # Fit binomial GLM using proportion as endog and freq_weights as number of trials\n    glm_model = smf.glm(formula=formula, data=df, family=sm.families.Binomial(), freq_weights=df['Trials']).fit()\n\n    # Compute clustered (by specimen) robust covariance results\n    # groups parameter must align with the dataframe used to fit the model\n    try:\n        clustered_results = glm_model.get_robustcov_results(cov_type='cluster', groups=df['SpecimenID'])\n    except Exception:\n        # Fallback: if clustering fails, return the original model and raise no error here\n        clustered_results = glm_model\n\n    # Return both the original glm fit and the clustered-results object\n    return {\n        'glm_fit': glm_model,\n        'clustered_results': clustered_results\n    }\n"
