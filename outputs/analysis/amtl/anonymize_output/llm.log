        ]
      }
    ],
    "dv": {
      "description": "Women's religiosity",
      "columns": [
        "AvgReligiosity"
      ]
    },
    "controls": [
      {
        "description": "Relationship status of the individual",
        "is_moderator": true,
        "moderator_on": "Women's fertility",
