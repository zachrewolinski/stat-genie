  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw dataset to the analysis-ready dataframe.\n\n    Produces the following columns used in modeling:\n    - Choice: original response (1=undemonstrated, 2=majority, 3=minority)\n    - Gender: categorical ('Girl' / 'Boy')\n    - Age: numeric (years)\n    - MajorityFirst: indicator (0/1) whether majority was demonstrated first\n    - SiteID: original site id numeric\n    - Site: categorical label 'Site_<id>' used for fixed-effect site terms\n    - ChoseMajority: binary dependent variable (1 if Choice==2 else 0)\n    - Age_c: mean-centered age used in the model\n    \"\"\"\n    # Work on a copy to avoid modifying original\n    df = df.copy()\n\n    # Rename raw feature columns to meaningful names\n    df = df.rename(columns={\n        'feature1': 'Choice',        # 1 = undemonstrated, 2 = majority, 3 = minority\n        'feature2': 'Gender',        # 1 = girl, 2 = boy\n        'feature3': 'Age',           # age in years\n        'feature4': 'MajorityFirst', # whether majority option was demonstrated first (0/1)\n        'feature5': 'SiteID'         # site numeric id\n    })\n\n    # Drop rows with missing values in key variables necessary for the analysis\n    df = df.dropna(subset=['Choice', 'Age', 'SiteID', 'Gender', 'MajorityFirst'])\n\n    # Make sure types are correct\n    df['Choice'] = df['Choice'].astype(int)\n    df['Age'] = pd.to_numeric(df['Age'], errors='coerce')\n    df['SiteID'] = df['SiteID'].astype(int)\n    df['MajorityFirst'] = df['MajorityFirst'].astype(int)\n    df['Gender'] = df['Gender'].astype(int)\n\n    # Create binary dependent variable: 1 if child chose the majority option (feature1 == 2)\n    df['ChoseMajority'] = (df['Choice'] == 2).astype(int)\n\n    # Create categorical site label used in the model (fixed-effect categorical variable)\n    df['Site'] = 'Site_' + df['SiteID'].astype(str)\n    df['Site'] = df['Site'].astype('category')\n\n    # Recode Gender to categorical labels for clearer modeling\n    df['Gender'] = df['Gender'].map({1: 'Girl', 2: 'Boy'})\n    df['Gender'] = df['Gender'].astype('category')\n\n    # Mean-center age for interpretability and to reduce collinearity with interaction terms\n    df['Age_c'] = df['Age'] - df['Age'].mean()\n\n    # Return only the columns needed for modeling plus useful metadata columns\n    cols_needed = ['Choice', 'ChoseMajority', 'Age', 'Age_c', 'Gender', 'MajorityFirst', 'SiteID', 'Site']\n    # Keep any additional columns if present, but ensure needed ones exist\n    for c in cols_needed:\n        if c not in df.columns:\n            raise ValueError(f\"Expected column {c} not found after transformation\")\n\n    return df",
  "m_code": "def model(df: pd.DataFrame) -> Any:\n    \"\"\"\n    Fit a logistic regression (binomial GLM) predicting the probability of choosing the majority option.\n\n    The key term of interest is the interaction between mean-centered age (Age_c) and Site (C(Site)),\n    which tests whether developmental trajectories (age slopes) differ across cultural contexts.\n\n    Controls: Gender (categorical) and MajorityFirst (0/1) to account for gender differences and order effects.\n\n    Model formula:\n      ChoseMajority ~ Age_c * C(Site) + C(Gender) + MajorityFirst\n\n    Returns the fitted GLM results object (statsmodels.genmod.generalized_linear_model.GLMResults).\n    \"\"\"\n    import statsmodels.formula.api as smf\n\n    # Check required columns\n    required = ['ChoseMajority', 'Age_c', 'Site', 'Gender', 'MajorityFirst']\n    missing = [c for c in required if c not in df.columns]\n    if missing:\n        raise ValueError(f\"Missing columns for modeling: {missing}\")\n\n    # Formula with Age x Site interaction to capture differing age slopes by site\n    formula = 'ChoseMajority ~ Age_c * C(Site) + C(Gender) + MajorityFirst'\n\n    # Fit binomial GLM (logistic regression)\n    model = smf.glm(formula=formula, data=df, family=sm.families.Binomial())\n    results = model.fit()\n\n    # results is a statsmodels fitted object; caller can inspect results.summary(), results.params, etc.\n    return results"
