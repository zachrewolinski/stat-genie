  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw Boston mortgage dataset into a dataframe suitable for modeling.\n\n    Steps performed:\n    - Copy dataframe to avoid modifying input in-place.\n    - Coerce original feature columns to numeric where present.\n    - Derive the outcome Approved using feature14 when available or 1 - feature11 otherwise.\n    - Derive binary control variables for demographics and indicators.\n    - Keep continuous controls and standardize (z-score) them to aid model convergence and interpretation.\n    - Drop rows with missing values in any variable used in the model.\n    - Return dataframe containing only the final columns (both derived binary and standardized continuous variables).\n    \"\"\"\n    df = df.copy()\n\n    # List of expected raw columns; coerce to numeric where present\n    raw_cols = [\n        'feature1','feature2','feature3','feature4','feature5','feature6','feature7','feature8',\n        'feature9','feature10','feature11','feature12','feature13','feature14'\n    ]\n    for c in raw_cols:\n        if c in df.columns:\n            df[c] = pd.to_numeric(df[c], errors='coerce')\n\n    # Independent variable: Female (1 if female, 0 if male)\n    if 'feature2' in df.columns:\n        df['Female'] = df['feature2'].astype('Int64')\n    else:\n        df['Female'] = pd.Series([pd.NA] * len(df))\n\n    # Dependent variable: Approved\n    # Prefer feature14 (accepted) when present; otherwise derive as 1 - feature11 (denied)\n    df['Approved'] = pd.NA\n    if 'feature14' in df.columns:\n        df['Approved'] = df['feature14']\n    if 'feature11' in df.columns:\n        # If Approved still NA, fill using 1 - denied\n        df['Approved'] = df['Approved'].fillna(1 - df['feature11'])\n\n    # Force integer dtype for Approved where possible\n    df['Approved'] = df['Approved'].astype('Int64')\n\n    # Control (binary) variables\n    df['Black'] = df['feature3'].astype('Int64') if 'feature3' in df.columns else pd.Series([pd.NA] * len(df))\n    df['SelfEmployed'] = df['feature5'].astype('Int64') if 'feature5' in df.columns else pd.Series([pd.NA] * len(df))\n    df['Married'] = df['feature6'].astype('Int64') if 'feature6' in df.columns else pd.Series([pd.NA] * len(df))\n    df['BadCreditHistory'] = df['feature9'].astype('Int64') if 'feature9' in df.columns else pd.Series([pd.NA] * len(df))\n    df['PMI_Denied'] = df['feature13'].astype('Int64') if 'feature13' in df.columns else pd.Series([pd.NA] * len(df))\n\n    # Continuous controls (keep raw values)\n    df['MortgageCreditScore'] = df['feature7'] if 'feature7' in df.columns else pd.Series([pd.NA] * len(df))\n    df['ConsumerCreditScore'] = df['feature8'] if 'feature8' in df.columns else pd.Series([pd.NA] * len(df))\n    df['HousingExpenseRatio'] = df['feature4'] if 'feature4' in df.columns else pd.Series([pd.NA] * len(df))\n    df['DebtToIncomeRatio'] = df['feature10'] if 'feature10' in df.columns else pd.Series([pd.NA] * len(df))\n    df['LoanToValue'] = df['feature12'] if 'feature12' in df.columns else pd.Series([pd.NA] * len(df))\n    df['LoanAmount'] = df['feature1'] if 'feature1' in df.columns else pd.Series([pd.NA] * len(df))\n\n    # Standardize continuous controls (z-score). Use population std (ddof=0) to avoid small-sample ddof issues.\n    cont_cols = [\n        'MortgageCreditScore','ConsumerCreditScore','HousingExpenseRatio',\n        'DebtToIncomeRatio','LoanToValue','LoanAmount'\n    ]\n    for c in cont_cols:\n        # compute mean and std on available values\n        if df[c].notna().any():\n            mean = df[c].mean()\n            std = df[c].std(ddof=0)\n            # if std is 0 or NaN (constant), create zeros to avoid division by zero\n            if pd.isna(std) or std == 0:\n                df['z_' + c] = 0.0\n            else:\n                df['z_' + c] = (df[c] - mean) / std\n        else:\n            df['z_' + c] = pd.Series([pd.NA] * len(df))\n\n    # List of final model columns to ensure complete cases\n    model_cols = [\n        'Approved','Female','Black','SelfEmployed','Married','BadCreditHistory','PMI_Denied',\n        'z_MortgageCreditScore','z_ConsumerCreditScore','z_HousingExpenseRatio','z_DebtToIncomeRatio','z_LoanToValue','z_LoanAmount'\n    ]\n\n    # Drop rows with missing data in any of the model columns\n    df = df.dropna(subset=model_cols)\n\n    # Ensure binary columns are actual integers (0/1)\n    for b in ['Approved','Female','Black','SelfEmployed','Married','BadCreditHistory','PMI_Denied']:\n        df[b] = df[b].astype(int)\n\n    # Return only the columns needed for modeling (keeps transformed columns documented above)\n    final_cols = ['Approved','Female','Black','SelfEmployed','Married','BadCreditHistory','PMI_Denied',\n                  'z_MortgageCreditScore','z_ConsumerCreditScore','z_HousingExpenseRatio','z_DebtToIncomeRatio','z_LoanToValue','z_LoanAmount']\n    return df[final_cols]\n",
  "m_code": "def model(df: pd.DataFrame) -> Any:\n    \"\"\"\n    Fit a logistic regression (logit) to estimate the effect of applicant gender on mortgage approval\n    controlling for applicant and loan characteristics.\n\n    Model: logit( P(Approved=1) ) = beta0 + beta1 * Female + beta2 * Black + beta3 * SelfEmployed + ... + eps\n\n    Returns the fitted statsmodels results object (LogitResults).\n    \"\"\"\n    # Copy to avoid side-effects\n    data = df.copy()\n\n    # Predictor columns (as constructed by transform)\n    X_cols = [\n        'Female', 'Black', 'SelfEmployed', 'Married', 'BadCreditHistory', 'PMI_Denied',\n        'z_MortgageCreditScore','z_ConsumerCreditScore','z_HousingExpenseRatio','z_DebtToIncomeRatio','z_LoanToValue','z_LoanAmount'\n    ]\n\n    # Ensure all predictors present\n    missing = [c for c in X_cols if c not in data.columns]\n    if len(missing) > 0:\n        raise ValueError(f\"Missing required columns for modeling: {missing}\")\n\n    X = data[X_cols]\n    X = sm.add_constant(X, has_constant='add')\n    y = data['Approved']\n\n    # Fit logistic regression using statsmodels Logit\n    logit_model = sm.Logit(y, X)\n    results = logit_model.fit(disp=False)\n\n    # Optionally: attach design info for easier inspection downstream\n    results.model_data = {\n        'n_obs': int(results.nobs),\n        'predictor_columns': X_cols,\n        'outcome': 'Approved'\n    }\n\n    return results\n"
