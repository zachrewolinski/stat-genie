n as e2:\n            raise RuntimeError(f'Logit failed to converge with errors: {e}; {e2}')\n\n    # Prepare results for return\n    odds_ratios = np.exp(res.params)\n\n    results = {\n        'model': res,\n        'summary': res.summary().as_text(),\n        'odds_ratios': odds_ratios,\n        'pvalues': res.pvalues,\n        'n_obs': int(res.nobs)\n    }\n\n    return results\n"
