  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Prepare and clean the Boston mortgage dataset for a logistic regression analysis of Gender on Approval.\n\n    Outputs (columns used in modeling):\n      - Approval: 1 = accepted, 0 = denied\n      - Gender: 1 = female, 0 = male\n      - Black: 1 = applicant is Black, 0 otherwise\n      - Gender_Black: interaction term Gender * Black\n      - MortgageScore_z, ConsumerScore_z, DebtToIncome_z, LoanToValue_z, HousingExpenseRatio_z, Income_z: standardized continuous controls\n      - BadCredit, SelfEmployed, Married: binary controls\n    \"\"\"\n    df = df.copy()\n\n    # Create Approval column: prefer feature14 (1 if accepted) when present; otherwise derive from feature11 (1 if denied)\n    if 'feature14' in df.columns:\n        df['Approval'] = pd.to_numeric(df['feature14'], errors='coerce')\n    else:\n        # feature11 is 1 if denied -> Approval = 1 - feature11\n        df['Approval'] = 1 - pd.to_numeric(df['feature11'], errors='coerce')\n\n    # Independent variable: Gender (feature2: 1 female, 0 male)\n    df['Gender'] = pd.to_numeric(df['feature2'], errors='coerce')\n\n    # Race: Black indicator\n    df['Black'] = pd.to_numeric(df['feature3'], errors='coerce')\n\n    # Binary controls\n    df['BadCredit'] = pd.to_numeric(df['feature9'], errors='coerce')\n    df['SelfEmployed'] = pd.to_numeric(df['feature5'], errors='coerce')\n    df['Married'] = pd.to_numeric(df['feature6'], errors='coerce')\n\n    # Continuous controls -- coerce to numeric, create standardized versions\n    cont_map = {\n        'Income': 'feature1',\n        'HousingExpenseRatio': 'feature4',\n        'MortgageScore': 'feature7',\n        'ConsumerScore': 'feature8',\n        'DebtToIncome': 'feature10',\n        'LoanToValue': 'feature12'\n    }\n    for new_name, src in cont_map.items():\n        df[new_name] = pd.to_numeric(df[src], errors='coerce')\n\n    # Standardize continuous variables (z-scores). Use population std (ddof=0) for stability.\n    for base in cont_map.keys():\n        col_z = base + '_z'\n        mean = df[base].mean()\n        std = df[base].std(ddof=0)\n        # if std is zero or NaN, result will be NaN; keep as-is\n        df[col_z] = (df[base] - mean) / std\n\n    # Interaction (explicit) for moderation test\n    df['Gender_Black'] = df['Gender'] * df['Black']\n\n    # Define the columns required for the model and drop rows with missing values in those columns\n    required_cols = [\n        'Approval', 'Gender', 'Black', 'Gender_Black',\n        'MortgageScore_z', 'ConsumerScore_z', 'BadCredit', 'SelfEmployed', 'Married',\n        'DebtToIncome_z', 'LoanToValue_z', 'HousingExpenseRatio_z', 'Income_z'\n    ]\n\n    df = df.dropna(subset=required_cols)\n\n    # Ensure numeric dtype for modeling\n    df[required_cols] = df[required_cols].astype(float)\n\n    return df\n",
  "m_code": "def model(df: pd.DataFrame):\n    \"\"\"\n    Fit a logistic regression of Approval on Gender with controls. Includes an interaction Gender * Black to test whether the gender effect differs by race.\n\n    Returns the fitted statsmodels Logit result object.\n    \"\"\"\n    import statsmodels.formula.api as smf\n\n    # Formula: Approval (binary) modeled by Gender, Black, interaction, and controls\n    formula = (\n        'Approval ~ Gender + Black + Gender_Black'\n        ' + MortgageScore_z + ConsumerScore_z + BadCredit + SelfEmployed + Married'\n        ' + DebtToIncome_z + LoanToValue_z + HousingExpenseRatio_z + Income_z'\n    )\n\n    # Fit logistic regression (maximum likelihood). Suppress iterative output with disp=False.\n    logit_res = smf.logit(formula=formula, data=df).fit(disp=False)\n\n    # It's often useful to inspect robust standard errors; returning the fitted object allows downstream summary calls.\n    return logit_res\n"
