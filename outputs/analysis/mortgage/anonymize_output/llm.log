  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    # Work on a copy\n    df = df.copy()\n\n    # Rename columns to meaningful names for the analysis\n    rename_map = {\n        'feature1': 'LoanAmount',\n        'feature2': 'Female',               # 1 if female, 0 male\n        'feature3': 'Black',                # 1 if Black, 0 otherwise\n        'feature4': 'HousingExpenseRatio',  # housing expense / income\n        'feature5': 'SelfEmployed',         # 1 if self-employed\n        'feature6': 'Married',              # 1 if married\n        'feature7': 'MortgageCreditScore',  # mortgage credit score (ordinal/continuous)\n        'feature8': 'ConsumerCreditScore',  # consumer credit score (ordinal/continuous)\n        'feature9': 'BadCreditHistory',     # 1 if has bad credit history\n        'feature10': 'DebtToIncome',        # debt payments / income\n        'feature11': 'Denied',              # 1 if denied, 0 if accepted\n        'feature12': 'LoanToValue',         # loan amount / appraised value\n        'feature13': 'PMIDenied',           # 1 if denied private mortgage insurance\n        'feature14': 'Approved'             # 1 if accepted, 0 if denied\n    }\n    df = df.rename(columns=rename_map)\n\n    # Ensure binary columns are numeric (0/1)\n    binary_cols = ['Female', 'Black', 'SelfEmployed', 'Married', 'BadCreditHistory', 'Denied', 'PMIDenied', 'Approved']\n    for c in binary_cols:\n        if c in df.columns:\n            df[c] = pd.to_numeric(df[c], errors='coerce')\n\n    # Use 'Approved' as the outcome if available; if not, create from 'Denied' (Approved = 1 - Denied)\n    if 'Approved' not in df.columns or df['Approved'].isnull().all():\n        if 'Denied' in df.columns:\n            df['Approved'] = 1 - df['Denied']\n\n    # Define continuous variables used in modeling\n    cont_cols = ['LoanAmount', 'HousingExpenseRatio', 'MortgageCreditScore', 'ConsumerCreditScore', 'DebtToIncome', 'LoanToValue']\n\n    # Convert continuous columns to numeric\n    for c in cont_cols:\n        if c in df.columns:\n            df[c] = pd.to_numeric(df[c], errors='coerce')\n\n    # Drop rows with missing values in the core model variables (outcome, main IV, key controls)\n    required_for_model = ['Approved', 'Female', 'Black', 'Married', 'SelfEmployed', 'BadCreditHistory'] + cont_cols\n    required_for_model = [c for c in required_for_model if c in df.columns]\n    df = df.dropna(subset=required_for_model)\n\n    # Standardize continuous controls (z-scores) and add as new columns used in the model\n    for c in cont_cols:\n        if c in df.columns:\n            zname = 'z_' + c\n            # use sample std (ddof=0 or 1 - use pandas default ddof=1)\n            mean = df[c].mean()\n            std = df[c].std()\n            # Avoid division by zero\n            if std == 0 or np.isnan(std):\n                df[zname] = 0.0\n            else:\n                df[zname] = (df[c] - mean) / std\n\n    # Ensure binary columns are integers (0/1)\n    for c in ['Female', 'Black', 'SelfEmployed', 'Married', 'BadCreditHistory', 'Approved']:\n        if c in df.columns:\n            df[c] = df[c].astype(int)\n\n    # Final dataframe contains the original meaningful columns and z-scored continuous controls used in the model\n    # Return df for modeling\n    return df\n",
  "m_code": "def model(df: pd.DataFrame) -> dict:\n    import statsmodels.formula.api as smf\n\n    # Specify logistic regression formula. We include an interaction Female:Black to test whether the\n    # effect of gender differs for Black applicants. Continuous controls are the z-scored versions.\n    formula = (\n        'Approved ~ Female + Black + Female:Black + Married + SelfEmployed + BadCreditHistory '\n        '+ z_MortgageCreditScore + z_ConsumerCreditScore + z_DebtToIncome + z_LoanToValue + z_LoanAmount + z_HousingExpenseRatio'\n    )\n\n    # Fit logistic regression (binomial family)\n    # Use statsmodels' logit via formula interface\n    logit_res = smf.logit(formula=formula, data=df).fit(disp=False)\n\n    # Compute odds ratios and 95% confidence intervals on odds ratio scale\n    params = logit_res.params\n    conf = logit_res.conf_int()\n    conf.columns = ['2.5%', '97.5%']\n\n    odds_ratios = np.exp(params)\n    conf_odds = np.exp(conf)\n\n    # Pack results into a dictionary. Return the fitted object and convenient summaries.\n    results = {\n        'fitted_model': logit_res,\n        'summary_text': logit_res.summary().as_text(),\n        'params': params,\n        'odds_ratios': odds_ratios,\n        'conf_int_odds': conf_odds\n    }\n\n    return results\n"
