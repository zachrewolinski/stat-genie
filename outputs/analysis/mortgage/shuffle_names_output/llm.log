  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw Boston mortgage dataset into the final dataframe used for modeling.\n\n    Final columns created and returned:\n      - Approved: 1 if application approved, 0 if denied\n      - Female: 1 if female applicant, 0 if male\n      - Black, BadHistory, LoanToValue, DeniedPMI, HousingExpenseRatio, SelfEmployed, Married, PI_ratio\n\n    The function attempts to robustly map multiple possible source columns (given the schema's inconsistent descriptions).\n    \"\"\"\n    df = df.copy()\n\n    # --- Create Female (IV) ---\n    if 'consumer_credit' in df.columns:\n        # dataset schema: consumer_credit is 1 if female, 0 if male\n        df['Female'] = pd.to_numeric(df['consumer_credit'], errors='coerce')\n    elif 'female' in df.columns:\n        # Some datasets contain a 'female' column that may be non-binary; threshold at 0.5 if not already 0/1\n        df['female'] = pd.to_numeric(df['female'], errors='coerce')\n        unique_vals = pd.Series(df['female'].dropna().unique())\n        if set(unique_vals.astype(int).unique()).issubset({0, 1}):\n            df['Female'] = df['female'].astype('Int64')\n        else:\n            df['Female'] = (df['female'] > 0.5).astype('Int64')\n    else:\n        raise KeyError(\"No gender column found. Expected 'consumer_credit' or 'female'.\")\n\n    # --- Create Approved (DV) ---\n    # Prefer 'mortgage_credit' (schema says 1=denied,0=accepted) -> Approved = 1 - mortgage_credit\n    if 'mortgage_credit' in df.columns:\n        df['mortgage_credit'] = pd.to_numeric(df['mortgage_credit'], errors='coerce')\n        df['Approved'] = (1 - df['mortgage_credit']).astype('Int64')\n    elif 'Unnamed: 0' in df.columns:\n        # Some exports use Unnamed: 0 to store accepted/denied flags\n        df['Approved'] = pd.to_numeric(df['Unnamed: 0'], errors='coerce').astype('Int64')\n    elif 'accept' in df.columns:\n        # 'accept' in schema shows 1..6 categories; as a fallback treat larger values as more acceptance.\n        # We convert to a binary Approved flag by thresholding at the median (>=4 treated as accepted).\n        df['accept'] = pd.to_numeric(df['accept'], errors='coerce')\n        df['Approved'] = (df['accept'] >= df['accept'].median()).astype('Int64')\n    else:\n        raise KeyError(\"No approval/denial column found. Expected 'mortgage_credit', 'Unnamed: 0', or 'accept'.\")\n\n    # --- Map and standardize control variables (if present) ---\n    mapping = {\n        'loan_to_value': 'LoanToValue',\n        'denied_PMI': 'DeniedPMI',\n        'housing_expense_ratio': 'HousingExpenseRatio',\n        'self_employed': 'SelfEmployed',\n        'married': 'Married',\n        'PI_ratio': 'PI_ratio',\n        'bad_history': 'BadHistory',\n        'black': 'Black'\n    }\n\n    for src_col, out_col in mapping.items():\n        if src_col in df.columns:\n            df[out_col] = pd.to_numeric(df[src_col], errors='coerce')\n        else:\n            # create column with NaNs so downstream code can rely on consistent column names\n            df[out_col] = np.nan\n\n    # --- Drop rows missing DV or IV ---\n    df = df.dropna(subset=['Approved', 'Female'])\n\n    # --- For numeric controls, fill remaining missing values with the column median ---\n    control_cols = [mapping[c] for c in mapping]\n    for c in control_cols:\n        if df[c].dtype.kind in 'biufc':\n            # If entire column is NaN, leave as NaN (will be handled downstream); otherwise fill median\n            if df[c].notna().any():\n                median = df[c].median()\n                df[c] = df[c].fillna(median)\n        else:\n            # non-numeric fallback\n            df[c] = pd.to_numeric(df[c], errors='coerce')\n            if df[c].notna().any():\n                df[c] = df[c].fillna(df[c].median())\n\n    # Ensure final types for Approved and Female are integers (0/1)\n    df['Approved'] = df['Approved'].astype(int)\n    df['Female'] = df['Female'].astype(int)\n\n    # Return only the columns needed for modeling (keeps order predictable)\n    final_cols = ['Approved', 'Female'] + control_cols\n    return df[final_cols]\n",
  "m_code": "def model(df: pd.DataFrame) -> dict:\n    \"\"\"\n    Fit a logistic regression predicting Approved (1 = approved) from Female and controls.\n\n    Returns a dictionary with keys:\n      - 'result': the fitted statsmodels Logit result object\n      - 'summary_table': a pandas DataFrame with odds ratios, 95% CI and p-values for coefficients\n\n    The model includes a constant and uses robust (HC1) standard errors when reporting CIs/p-values.\n    \"\"\"\n    df = df.copy()\n\n    # Define regressors to include in the model. Keep the order stable.\n    regressors = ['Female', 'Black', 'BadHistory', 'LoanToValue', 'DeniedPMI',\n                  'HousingExpenseRatio', 'SelfEmployed', 'Married', 'PI_ratio']\n\n    # Keep only regressors present in df (they should all be present as columns; if some are entirely NaN, they will be dropped)\n    available_regs = [r for r in regressors if r in df.columns]\n\n    # Drop rows with missing values in any of the model variables (DV or chosen regressors)\n    model_cols = ['Approved'] + available_regs\n    df_model = df[model_cols].dropna()\n\n    if df_model.shape[0] == 0:\n        raise ValueError('No rows available for modeling after dropping NaNs.')\n\n    y = df_model['Approved'].astype(int)\n    X = df_model[available_regs]\n    X = sm.add_constant(X, has_constant='add')\n\n    # Fit logistic regression\n    logit = sm.Logit(y, X)\n    result = logit.fit(disp=False)\n\n    # Robust covariance (HC1) for standard errors and CI\n    robust_cov = result.get_robustcov_results(cov_type='HC1')\n\n    # Odds ratios and confidence intervals\n    params = robust_cov.params\n    conf = robust_cov.conf_int()\n    or_est = np.exp(params)\n    conf_odds = np.exp(conf)\n\n    summary_table = pd.DataFrame({\n        'OR': or_est,\n        '2.5%': conf_odds[0],\n        '97.5%': conf_odds[1],\n        'pvalue': robust_cov.pvalues\n    })\n\n    # Return both the fitted object and a neat summary table\n    return {\n        'result': result,\n        'robust_result': robust_cov,\n        'summary_table': summary_table\n    }\n"
}
