h non-missing values for outcome, IV, and controls used in the model\n    required_cols = ['Approved', 'Female'] + present_controls\n    df = df.dropna(subset=required_cols).reset_index(drop=True)\n\n    # 5) Cast binary columns to integer dtype (0/1)\n    df['Approved'] = df['Approved'].astype(int)\n    df['Female'] = df['Female'].astype(int)\n    for c in present_controls:\n        # If control is clearly binary (unique values subset of {0,1}), cast to int for clarity\n        unique_vals = pd.unique(df[c].dropna())\n        if set(unique_vals).issubset({0, 1}):\n            df[c] = df[c].astype(int)\n\n    # 6) Final dataframe includes only the variables used in the model (keeps present controls)\n    final_cols = ['Approved', 'Female'] + present_controls\n    df = df[final_cols]\n\n    return df\n",
