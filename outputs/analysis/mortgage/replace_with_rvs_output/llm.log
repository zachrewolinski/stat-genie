ns are integer (0/1)\n    df[binary_cols] = df[binary_cols].astype(int)\n\n    # Keep the final set of columns (no renaming) - model expects these exact names\n    final_cols = required_cols\n    df = df[final_cols].reset_index(drop=True)\n\n    return df\n",
