  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw dataset into a dataframe with variables used in the models.\n\n    Produces:\n    - AffairFreq: numeric outcome from feature2\n    - HasChildren: binary indicator from feature6 (1=yes, 0=no)\n    - Female: binary gender (1=female, 0=male)\n    - Age, YearsMarried, Religious, Education, Occupation, MaritalHappiness: control variables\n    - AnyAffair: binary indicator (AffairFreq > 0)\n    - Age_c, YearsMarried_c: centered versions of Age and YearsMarried for modelling\n    \"\"\"\n    df = df.copy()\n\n    # Dependent variable: frequency of extramarital intercourse\n    df['AffairFreq'] = pd.to_numeric(df['feature2'], errors='coerce')\n\n    # Independent variable: are there children in the marriage? Expect values like 'yes'/'no'\n    # Be robust to capitalization and occasional non-string entries\n    df['HasChildren'] = df['feature6'].astype(str).str.strip().str.lower().map({'yes': 1, 'no': 0})\n\n    # Controls\n    df['Female'] = df['feature3'].astype(str).str.strip().str.lower().map({'female': 1, 'male': 0})\n    df['Age'] = pd.to_numeric(df['feature4'], errors='coerce')\n    df['YearsMarried'] = pd.to_numeric(df['feature5'], errors='coerce')\n    df['Religious'] = pd.to_numeric(df['feature7'], errors='coerce')\n    df['Education'] = pd.to_numeric(df['feature8'], errors='coerce')\n    df['Occupation'] = pd.to_numeric(df['feature9'], errors='coerce')\n    df['MaritalHappiness'] = pd.to_numeric(df['feature10'], errors='coerce')\n\n    # Binary indicator for any affair (useful for robustness binary/logistic model)\n    df['AnyAffair'] = (df['AffairFreq'] > 0).astype(int)\n\n    # Drop rows with missing values in the variables required for the modeling\n    required_cols = [\n        'AffairFreq', 'HasChildren', 'Female', 'Age', 'YearsMarried',\n        'Religious', 'Education', 'Occupation', 'MaritalHappiness'\n    ]\n    df = df.dropna(subset=required_cols).reset_index(drop=True)\n\n    # Center continuous covariates to aid model interpretation / convergence\n    df['Age_c'] = df['Age'] - df['Age'].mean()\n    df['YearsMarried_c'] = df['YearsMarried'] - df['YearsMarried'].mean()\n\n    # Keep only columns needed for downstream modeling (but keep originals if desired)\n    keep_cols = [\n        'AffairFreq', 'HasChildren', 'Female', 'Age', 'Age_c', 'YearsMarried', 'YearsMarried_c',\n        'Religious', 'Education', 'Occupation', 'MaritalHappiness', 'AnyAffair'\n    ]\n    # If the user wants to keep the full frame, you can return df; here we return a frame with the required columns\n    return df[keep_cols].copy()\n",
  "m_code": "def model(df: pd.DataFrame) -> dict:\n    \"\"\"\n    Fit a censored (Tobit) regression of AffairFreq on HasChildren and controls.\n    Also fit a logistic regression of AnyAffair (binary) on the same predictors as a robustness check.\n\n    Returns a dictionary with the fitted Tobit and Logit results objects.\n    \"\"\"\n    import numpy as np\n    import statsmodels.api as sm\n    from scipy import stats\n    from statsmodels.base.model import GenericLikelihoodModel\n\n    # Prepare design matrix\n    predictors = ['HasChildren', 'Female', 'Age_c', 'YearsMarried_c',\n                  'Religious', 'Education', 'Occupation', 'MaritalHappiness']\n\n    X = df[predictors].astype(float)\n    X = sm.add_constant(X)\n    y = df['AffairFreq'].astype(float)\n\n    # Tobit (left-censored at 0) implemented via GenericLikelihoodModel\n    class Tobit(GenericLikelihoodModel):\n        def __init__(self, endog, exog, left_censor=0.0, **kwargs):\n            self.left_censor = left_censor\n            super(Tobit, self).__init__(endog, exog, **kwargs)\n\n        def loglike(self, params):\n            # params: [beta_0, ..., beta_k, log_sigma]\n            k = self.exog.shape[1]\n            beta = params[:k]\n            log_sigma = params[k]\n            sigma = np.exp(log_sigma)\n\n            Xb = np.dot(self.exog, beta)\n            y = self.endog\n\n            # For censored observations y <= left_censor\n            cens = (y <= self.left_censor)\n            uncens = ~cens\n\n            # Avoid numerical issues by bounding cdf inputs\n            z_cens = (self.left_censor - Xb[cens]) / (sigma + 1e-20)\n            ll_cens = np.log(stats.norm.cdf(z_cens) + 1e-20)\n\n            # For uncensored observations: density of normal\n            z_uncens = (y[uncens] - Xb[uncens]) / (sigma + 1e-20)\n            ll_uncens = -np.log(sigma + 1e-20) + stats.norm.logpdf(z_uncens)\n\n            total_ll = np.sum(ll_cens) + np.sum(ll_uncens)\n            return total_ll\n\n        def start_params(self):\n            # OLS start for betas\n            ols_res = sm.OLS(self.endog, self.exog).fit()\n            beta_start = ols_res.params\n            resid = ols_res.resid\n            sigma_start = np.log(np.std(resid) + 1e-8)\n            return np.concatenate([beta_start, [sigma_start]])\n\n    # Fit Tobit\n    tobit_model = Tobit(y.values, X.values, left_censor=0.0)\n    try:\n        tobit_res = tobit_model.fit(method='bfgs', disp=False)\n    except Exception:\n        # fallback to default method if bfgs fails\n        tobit_res = tobit_model.fit(disp=False)\n\n    # Robustness: logistic regression on binary any-affair outcome\n    y_bin = df['AnyAffair'].astype(int)\n    logit_model = sm.Logit(y_bin, X)\n    try:\n        logit_res = logit_model.fit(disp=False)\n    except Exception:\n        # If perfect separation or convergence issues occur, use method='lbfgs'\n        logit_res = logit_model.fit(method='lbfgs', disp=False)\n\n    # Return fitted result objects for further inspection (e.g., .summary())\n    return {\n        'tobit_results': tobit_res,\n        'logit_results': logit_res,\n        'predictors': predictors\n    }\n"
