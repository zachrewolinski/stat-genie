nary (1 = female, 0 = male)\n    df['Female'] = df['Gender'].map({'female': 1, 'male': 0})\n    if df['Female'].isnull().any():\n        df['Female'] = df['Gender'].str.lower().map({'female': 1, 'male': 0})\n\n    # Drop rows with missing values in variables required for modeling\n    required = ['AffairsCount', 'HasChildren', 'Female', 'Age', 'YearsMarried', 'Religiosity', 'Education', 'Occupation', 'MaritalHappiness']\n    df = df.dropna(subset=required)\n\n    # Cast binary columns to integer type\n    df['HasChildren'] = df['HasChildren'].astype(int)\n    df['Female'] = df['Female'].astype(int)\n\n    # Keep only the columns needed for modeling (plus ID for reference)\n    final_cols = ['ID', 'AffairsCount', 'HasChildren', 'Female', 'Age', 'YearsMarried', 'Religiosity', 'Education', 'Occupation', 'MaritalHappiness']\n    df = df[final_cols]\n\n    return df\n",
