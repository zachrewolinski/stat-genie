{
  "cvars": {
    "ivs": [
      {
        "description": "Relative group size of the focal group vs the other group. Calculated as the ratio n_focal / n_other (RelSize) and standardized (RelSize_z). Positive values >1 indicate focal larger than other. Model uses the standardized ratio column 'RelSize_z'.",
        "columns": [
