      },
      {
        "description": "Contest location relative to group home-range centers. Categorical variable with values 'FocalHome' (contest closer to focal group's home), 'OtherHome' (closer to other group's home), and 'Neutral' (within a small distance of both). Stored in column 'Location'. The model uses dummy variables derived from this column (Loc_FocalHome and Loc_OtherHome), with 'Neutral' as the reference category.",
        "columns": [
          "Location",
          "Loc_FocalHome",
          "Loc_OtherHome"
        ]
      }
    ],
    "dv": {
      "description": "Outcome of the contest: whether the focal group won (1) or lost (0). Binary dependent variable stored in column 'win'.",
      "columns": [
        "win"
      ]
    },
    "controls": [
      {
        "description": "Relative number of adult males: difference m_focal - m_other, standardized (RelMales_z). Controls for sex-composition advantage that might affect contest outcome.",
