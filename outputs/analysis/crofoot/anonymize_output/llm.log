  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw dataset into a dataframe ready for modeling.\n    Produces the following columns (used by the model):\n      - FocalID, OtherID, DyadID, FocalWon,\n      - FocalDist, OtherDist, FocalSize, OtherSize,\n      - FocalMales, OtherMales, FocalFemales, OtherFemales,\n      - SizeRatio, LogSizeRatio, SizeDiff,\n      - LocationAdvantage (categorical), LocationAdv_binary (0/1),\n      - MalesDiff, FemalesDiff, TotalSize\n    \"\"\"\n    df = df.copy()\n\n    # Rename raw feature columns to descriptive names\n    rename_map = {\n        'feature1': 'FocalID',\n        'feature2': 'OtherID',\n        'feature3': 'DyadID',\n        'feature4': 'FocalWon',\n        'feature5': 'FocalDist',\n        'feature6': 'OtherDist',\n        'feature7': 'FocalSize',\n        'feature8': 'OtherSize',\n        'feature9': 'FocalMales',\n        'feature10': 'OtherMales',\n        'feature11': 'FocalFemales',\n        'feature12': 'OtherFemales'\n    }\n    df = df.rename(columns=rename_map)\n\n    # Ensure numeric types where expected\n    numeric_cols = ['FocalWon', 'FocalDist', 'OtherDist', 'FocalSize', 'OtherSize',\n                    'FocalMales', 'OtherMales', 'FocalFemales', 'OtherFemales']\n    for col in numeric_cols:\n        df[col] = pd.to_numeric(df[col], errors='coerce')\n\n    # Drop rows with missing critical information\n    df = df.dropna(subset=['FocalWon', 'FocalDist', 'OtherDist', 'FocalSize', 'OtherSize'])\n\n    # Derived group size measures\n    # Avoid division by zero by adding a very small epsilon if OtherSize==0 (shouldn't occur biologically but safe)\n    eps = 1e-6\n    df['SizeRatio'] = df['FocalSize'] / (df['OtherSize'] + eps)\n    # Log transform to model multiplicative effects and to reduce skew\n    # Add small eps to SizeRatio to avoid log(0)\n    df['LogSizeRatio'] = np.log(df['SizeRatio'] + eps)\n    df['SizeDiff'] = df['FocalSize'] - df['OtherSize']\n\n    # Location advantage: contest is closer to focal group's home-range center if focal distance < other distance\n    # Categorical label for interpretability and a binary indicator used in modeling\n    df['LocationAdvantage'] = np.where(\n        df['FocalDist'] < df['OtherDist'],\n        'FocalHome',\n        np.where(df['FocalDist'] > df['OtherDist'], 'OtherHome', 'Neutral')\n    )\n    df['LocationAdv_binary'] = (df['FocalDist'] < df['OtherDist']).astype(int)\n\n    # Sex-composition and size controls\n    df['MalesDiff'] = df['FocalMales'] - df['OtherMales']\n    df['FemalesDiff'] = df['FocalFemales'] - df['OtherFemales']\n    df['TotalSize'] = df['FocalSize'] + df['OtherSize']\n\n    # Cast DyadID to categorical for later inclusion as fixed effects\n    df['DyadID'] = df['DyadID'].astype('category')\n\n    # Ensure binary dependent variable is integer (0/1)\n    df['FocalWon'] = df['FocalWon'].astype(int)\n\n    # Final minimal NA drop for newly created columns (if any)\n    df = df.dropna(subset=['LogSizeRatio', 'LocationAdv_binary', 'MalesDiff', 'FemalesDiff', 'TotalSize'])\n\n    return df\n",
