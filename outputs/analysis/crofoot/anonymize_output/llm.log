ses\n    # Define threshold (meters) to categorize contests as focal_home, neutral, other_home.\n    # We pick 50 m as a heuristic threshold given distances in the dataset; this is for description only.\n    df['ContestLocation'] = pd.cut(\n        df['LocationAdvantage'],\n        bins=[-np.inf, -50, 50, np.inf],\n        labels=['OtherHome', 'Neutral', 'FocalHome']\n    )\n\n    # For modeling purposes we will use SizeRatio and LocationAdvantage (continuous). Keep additional columns for diagnostics.\n\n    # Reset index for cleanliness\n    df = df.reset_index(drop=True)\n\n    return df\n",
