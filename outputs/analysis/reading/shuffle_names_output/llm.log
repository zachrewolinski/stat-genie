  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw dataset to produce the variables required for the analysis.\n\n    Output dataframe will include the following columns used by the model:\n      - reading_speed_wpm: dependent variable (words per minute)\n      - reader_view_bin: independent variable (0/1)\n      - is_dyslexic: moderator (0/1)\n      - age, gender, Flesch_Kincaid, num_words, log_num_words, device, img_width\n\n    Notes on column mapping (based on provided schema):\n      - 'language' column contains reading time in milliseconds excluding scrolling (reading_time_ms)\n      - 'dyslexia' column (despite its name) contains number of words on the page\n      - 'dyslexia_bin' contains dyslexia status: 0=no,1=dyslexia,2=severe\n      - 'reader_view' contains 'Y'/'N'\n    \"\"\"\n    df = df.copy()\n\n    # Required raw columns we will use: 'language' (reading time ms), 'dyslexia' (num words),\n    # 'reader_view', 'dyslexia_bin', 'age', 'gender', 'Flesch_Kincaid', 'device', 'img_width'\n\n    required_cols = ['language', 'dyslexia', 'reader_view', 'dyslexia_bin']\n    # Drop rows missing essential pieces for computing reading speed and moderator/treatment\n    df = df.dropna(subset=required_cols)\n\n    # Ensure numeric types where appropriate\n    # reading time in ms\n    df['language'] = pd.to_numeric(df['language'], errors='coerce')\n    # number of words on page (from column named 'dyslexia' in provided schema)\n    df['dyslexia'] = pd.to_numeric(df['dyslexia'], errors='coerce')\n    # dyslexia_bin (0/1/2)\n    df['dyslexia_bin'] = pd.to_numeric(df['dyslexia_bin'], errors='coerce')\n\n    # Filter out non-positive reading times or non-positive word counts\n    df = df[(df['language'] > 0) & (df['dyslexia'] > 0)]\n\n    # Create final columns with clear names\n    # Dependent variable: reading speed (words per minute)\n    df['num_words'] = df['dyslexia']\n    df['reading_time_ms'] = df['language']\n\n    # words per minute = num_words / (reading_time_minutes) = num_words * 60000 / reading_time_ms\n    df['reading_speed_wpm'] = df['num_words'] * 60000.0 / df['reading_time_ms']\n\n    # Independent: Reader View ON/OFF\n    df['reader_view'] = df['reader_view'].astype(str).str.upper()\n    df['reader_view_bin'] = df['reader_view'].map({'Y': 1, 'N': 0})\n    # If mapping created NaNs (unexpected levels), treat non-'Y' as 0\n    df['reader_view_bin'] = df['reader_view_bin'].fillna(0).astype(int)\n\n    # Moderator: dyslexia status. Define dyslexic if dyslexia_bin >= 1 (includes severe)\n    df['is_dyslexic'] = (df['dyslexia_bin'] >= 1).astype(int)\n\n    # Controls: make sure present and numeric where expected\n    for col in ['age', 'gender', 'Flesch_Kincaid', 'device', 'img_width']:\n        if col in df.columns:\n            df[col] = pd.to_numeric(df[col], errors='coerce')\n        else:\n            # If control missing, create NA column so code downstream won't error\n            df[col] = np.nan\n\n    # Log-transformed page length to reduce skew\n    # add a tiny constant if needed (shouldn't be necessary since we filtered num_words>0)\n    df['log_num_words'] = np.log(df['num_words'])\n\n    # Drop rows with NA in the final variables used in the model\n    model_cols = ['reading_speed_wpm', 'reader_view_bin', 'is_dyslexic', 'age', 'gender', 'Flesch_Kincaid', 'log_num_words', 'device', 'img_width']\n    df = df.dropna(subset=['reading_speed_wpm', 'reader_view_bin', 'is_dyslexic'])\n\n    # Note: we keep rows with some NA in optional controls but model will drop them automatically when fitting.\n\n    # Return only the columns that will be used / helpful for modeling/diagnostics\n    keep_cols = ['reading_speed_wpm', 'reader_view_bin', 'is_dyslexic', 'age', 'gender', 'Flesch_Kincaid', 'num_words', 'log_num_words', 'device', 'img_width', 'reading_time_ms', 'reader_view']\n    # also keep original index\n    return df[keep_cols]\n",
  "m_code": "def model(df: pd.DataFrame):\n    \"\"\"\n    Fit an OLS model estimating the effect of Reader View on reading speed, and whether that effect\n    differs for readers with dyslexia (interaction). Control for age, gender, readability, page length,\n    device type, and image width.\n\n    Model specification (linear OLS):\n      reading_speed_wpm ~ reader_view_bin * is_dyslexic + age + gender + Flesch_Kincaid + log_num_words + C(device) + img_width\n\n    Returns the fitted statsmodels RegressionResults object.\n    \"\"\"\n    import statsmodels.formula.api as smf\n\n    # Ensure model columns exist\n    required = ['reading_speed_wpm', 'reader_view_bin', 'is_dyslexic', 'age', 'gender', 'Flesch_Kincaid', 'log_num_words', 'device', 'img_width']\n    missing = [c for c in required if c not in df.columns]\n    if missing:\n        raise ValueError(f\"Missing required columns for modeling: {missing}\")\n\n    # Drop any remaining rows with missing values in model variables (statsmodels will do this as well)\n    model_df = df.dropna(subset=required).copy()\n\n    # Cast device to categorical for fixed-effect style control\n    model_df['device'] = model_df['device'].astype('category')\n\n    formula = 'reading_speed_wpm ~ reader_view_bin * is_dyslexic + age + gender + Flesch_Kincaid + log_num_words + C(device) + img_width'\n\n    results = smf.ols(formula=formula, data=model_df).fit(cov_type='HC3')\n\n    # return full results so caller can inspect .summary(), .params, etc.\n    return results\n"
