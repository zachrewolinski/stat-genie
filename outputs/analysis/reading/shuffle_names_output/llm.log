  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    # Work on a copy\n    df = df.copy()\n\n    # ---- Create/clean numeric columns used for modelling ----\n    # Prefer 'language' as reading time excluding scrolling (ms). If missing, fall back to 'adjusted_running_time'.\n    if 'language' in df.columns:\n        df['ReadingTime_ms'] = pd.to_numeric(df['language'], errors='coerce')\n    else:\n        df['ReadingTime_ms'] = pd.to_numeric(df.get('adjusted_running_time'), errors='coerce')\n\n    # Number of words on page\n    df['NumWords'] = pd.to_numeric(df.get('num_words'), errors='coerce')\n\n    # Reader View indicator: running_time documented as 1 = Reader View on, 0 = off\n    df['ReaderViewOn'] = pd.to_numeric(df.get('running_time'), errors='coerce')\n\n    # Controls: coerce to numeric where appropriate\n    df['Age'] = pd.to_numeric(df.get('age'), errors='coerce')\n    df['Device'] = pd.to_numeric(df.get('device'), errors='coerce')\n    df['Gender'] = pd.to_numeric(df.get('gender'), errors='coerce')\n    df['Flesch_Kincaid'] = pd.to_numeric(df.get('Flesch_Kincaid'), errors='coerce')\n\n    # Dyslexia status: use dyslexia_bin if present (expected codes 0,1,2). Map to categorical labels.\n    df['Dyslexia_bin'] = pd.to_numeric(df.get('dyslexia_bin'), errors='coerce')\n    dys_map = {0: 'NoDyslexia', 1: 'Dyslexia', 2: 'SevereDyslexia'}\n    df['Dyslexia_cat'] = df['Dyslexia_bin'].map(dys_map)\n\n    # ---- Filter invalid / impossible rows ----\n    # Need positive reading time and positive number of words to compute speed\n    df = df[(df['ReadingTime_ms'].notnull()) & (df['ReadingTime_ms'] > 0) &\n            (df['NumWords'].notnull()) & (df['NumWords'] > 0) &\n            (df['ReaderViewOn'].notnull())]\n\n    # ---- Compute outcome: reading speed in words per second ----\n    # ReadingTime_ms is milliseconds -> convert to seconds\n    df['ReadingSpeed_wps'] = df['NumWords'] * 1000.0 / df['ReadingTime_ms']\n\n    # ---- Drop rows with missing covariates used in the model ----\n    model_cols = ['ReadingSpeed_wps', 'ReaderViewOn', 'Dyslexia_cat', 'NumWords', 'Age', 'Gender', 'Device', 'Flesch_Kincaid']\n    df = df.dropna(subset=model_cols)\n\n    # Ensure categorical Dyslexia_cat is of type string (useful for formulas)\n    df['Dyslexia_cat'] = df['Dyslexia_cat'].astype(str)\n\n    # Return only columns needed for modeling (keep originals if desired)\n    # We return the full df (copy) but at minimum it contains the columns listed in the conceptual model.\n    return df\n",
  "m_code": "def model(df: pd.DataFrame):\n    import statsmodels.formula.api as smf\n\n    # Formula: main effect of ReaderViewOn, main effect of Dyslexia (categorical), and their interaction.\n    # Include numeric controls for text length (NumWords), Age, Gender, Device, and Flesch_Kincaid readability.\n    formula = 'ReadingSpeed_wps ~ ReaderViewOn * C(Dyslexia_cat) + NumWords + Age + Gender + Device + Flesch_Kincaid'\n\n    # Fit OLS with robust standard errors (HC3) to reduce sensitivity to heteroskedasticity.\n    model_fit = smf.ols(formula=formula, data=df).fit(cov_type='HC3')\n\n    # Return the fitted model object (contains summary, params, pvalues, conf_int, etc.)\n    return model_fit\n"
