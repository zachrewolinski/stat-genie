{
  "cvars": {
    "ivs": [
      {
        "description": "Whether the Reader View layout was activated for the page (binary treatment). This is the primary independent variable: 1 = Reader View ON, 0 = Reader View OFF.",
        "columns": [
          "reader_view"
        ]
      }
    ],
    "dv": {
      "description": "Reading speed. I use the log-transformed 'speed' measure to reduce skew and make the outcome approximately Gaussian for OLS. ('log_speed' = log(speed)).",
      "columns": [
        "log_speed"
      ]
    },
    "controls": [
      {
        "description": "Binary indicator for whether the reader has dyslexia (1 = dyslexia; 0 = no dyslexia). This is treated as a moderator of the effect of Reader View.",
        "is_moderator": true,
        "moderator_on": "reader_view",
        "columns": [
          "dyslexia_bin"
        ]
      },
      {
        "description": "Age of the reader in years (numeric). Controls for age-related differences in reading speed.",
        "is_moderator": false,
        "moderator_on": "",
        "columns": [
          "age"
        ]
      },
      {
        "description": "Device used by the reader (categorical). Included as a factor to control for device-specific differences (e.g., smartphone vs desktop).",
        "is_moderator": false,
        "moderator_on": "",
        "columns": [
          "device"
        ]
      },
      {
        "description": "Language of the text (categorical). Controls for differences in reading speed across languages.",
        "is_moderator": false,
        "moderator_on": "",
        "columns": [
          "language"
        ]
      },
      {
        "description": "Indicator whether the reader is a native English speaker (1 = Y/native, 0 = N/non-native). Controls for language familiarity.",
        "is_moderator": false,
        "moderator_on": "",
        "columns": [
          "english_native"
        ]
      },
      {
        "description": "Number of words on the page (numeric). Controls for text length which affects reading time and speed.",
        "is_moderator": false,
        "moderator_on": "",
        "columns": [
          "num_words"
        ]
      },
      {
        "description": "Flesch-Kincaid readability score of the text (numeric). Controls for text difficulty.",
        "is_moderator": false,
