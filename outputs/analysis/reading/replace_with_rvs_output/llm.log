  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform raw dataset into analysis-ready dataframe.\n\n    Steps:\n    - Drop rows missing essential variables.\n    - Exclude retake trials (retake_trial == 1) to keep first attempts only.\n    - Ensure adjusted_running_time > 0 and num_words > 0.\n    - Require a minimum comprehension threshold (correct_rate >= 0.5) so speed reflects actual reading.\n    - Compute words_per_sec and take natural log to create log_wps (dependent variable).\n    - Create english_native_bin from english_native ('Y'->1, 'N'->0).\n    - Clip extreme log_wps values at the 1st and 99th percentiles to reduce influence of outliers.\n    - Return a dataframe with the exact columns used in the model.\n    \"\"\"\n    df = df.copy()\n\n    # Drop rows missing essential columns\n    required_cols = ['adjusted_running_time', 'num_words', 'reader_view', 'dyslexia_bin', 'uuid', 'page_id', 'correct_rate']\n    df = df.dropna(subset=required_cols)\n\n    # Exclude retake trials (we focus on first attempt trials)\n    if 'retake_trial' in df.columns:\n        df = df[df['retake_trial'] == 0]\n\n    # Keep only positive adjusted running time and positive word counts\n    df = df[df['adjusted_running_time'] > 0]\n    df = df[df['num_words'] > 0]\n\n    # Require a minimum comprehension threshold (adjustable). This removes trials where readers didn't understand the text.\n    df = df[df['correct_rate'] >= 0.5]\n\n    # Compute words per second using adjusted_running_time (milliseconds -> seconds)\n    df['words_per_sec'] = df['num_words'] / (df['adjusted_running_time'] / 1000.0)\n\n    # Drop infinite / NaN and extremely small/large values\n    df = df.replace([np.inf, -np.inf], np.nan).dropna(subset=['words_per_sec'])\n    df = df[df['words_per_sec'] > 0]\n\n    # Dependent variable: log-transformed words-per-second\n    df['log_wps'] = np.log(df['words_per_sec'])\n\n    # Encode english native speaker indicator\n    if 'english_native' in df.columns:\n        df['english_native_bin'] = df['english_native'].map({'Y': 1, 'N': 0})\n        # If mapping yields NaN (other values), treat as non-native (0)\n        df['english_native_bin'] = df['english_native_bin'].fillna(0).astype(int)\n    else:\n        df['english_native_bin'] = 0\n\n    # Ensure key columns are the right dtype\n    df['reader_view'] = df['reader_view'].astype(int)\n    df['dyslexia_bin'] = df['dyslexia_bin'].astype(int)\n\n    # Winsorize/clamp log_wps to reduce influence of extreme outliers (1st-99th percentile)\n    lower = df['log_wps'].quantile(0.01)\n    upper = df['log_wps'].quantile(0.99)\n    df['log_wps'] = df['log_wps'].clip(lower=lower, upper=upper)\n\n    # Keep only the columns needed for the analysis and modeling\n    out_cols = ['uuid', 'page_id', 'reader_view', 'dyslexia_bin', 'age', 'Flesch_Kincaid', 'num_words', 'img_width', 'english_native_bin', 'log_wps', 'device']\n    # Some datasets may lack certain optional columns; add them with NA if missing, then drop NA where required later in modeling\n    for c in out_cols:\n        if c not in df.columns:\n            df[c] = pd.NA\n\n    df = df[out_cols]\n\n    # Convert categorical columns to appropriate dtypes\n    df['device'] = df['device'].astype('category')\n    df['page_id'] = df['page_id'].astype('category')\n    df['uuid'] = df['uuid'].astype('category')\n\n    return df\n",
  "m_code": "def model(df: pd.DataFrame):\n    \"\"\"\n    Fit an OLS model testing whether Reader View improves reading speed for readers with dyslexia.\n\n    Model:\n    log_wps ~ reader_view * dyslexia_bin + age + Flesch_Kincaid + num_words + img_width + english_native_bin + C(device) + C(page_id)\n\n    - Interaction term (reader_view:dyslexia_bin) tests whether the effect of reader_view differs for dyslexic readers.\n    - Clustered standard errors by participant uuid to account for repeated measures.\n\n    Returns:\n    - A statsmodels Results object with clustered robust standard errors (if clustering succeeds). If clustering fails, returns the fitted OLS result.\n    \"\"\"\n    import statsmodels.formula.api as smf\n\n    # Drop rows missing essential modeling columns\n    model_df = df.dropna(subset=['log_wps', 'reader_view', 'dyslexia_bin', 'uuid'])\n\n    # Construct formula including categorical fixed effects for device and page_id\n    formula = (\n        'log_wps ~ reader_view * dyslexia_bin + age + Flesch_Kincaid + num_words + img_width + '\n        'english_native_bin + C(device) + C(page_id)'\n    )\n\n    # Fit OLS\n    ols_fit = smf.ols(formula, data=model_df).fit()\n\n    # Attempt clustered robust covariance by participant (uuid). If it fails, return the plain ols_fit.\n    try:\n        # statsmodels expects groups as array-like aligned with the model_df index\n        clustered = ols_fit.get_robustcov_results(cov_type='cluster', groups=model_df['uuid'])\n        results = clustered\n    except Exception:\n        # If clustering fails (e.g., only one cluster), fall back to heteroskedasticity-robust (HC3)\n        try:\n            results = ols_fit.get_robustcov_results(cov_type='HC3')\n        except Exception:\n            results = ols_fit\n\n    return results\n"
