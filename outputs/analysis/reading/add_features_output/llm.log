{
  "cvars": {
    "ivs": [
      {
        "description": "Whether the Reader View layout was activated for the trial (1 = activated, 0 = not activated). Primary manipulation whose effect on reading speed is tested.",
        "columns": [
          "reader_view"
        ]
      }
    ],
    "dv": {
      "description": "Log-transformed reading speed for the trial (log_speed). Log transform reduces skew in the raw speed measure and is the outcome in the regression.",
      "columns": [
        "log_speed"
      ]
    },
    "controls": [
      {
        "description": "Indicator if reader has dyslexia (1) or not (0). Treated as a moderator on the effect of Reader View (we test the interaction reader_view * dyslexia_bin).",
        "is_moderator": true,
        "moderator_on": "reader_view",
        "columns": [
          "dyslexia_bin"
        ]
      },
      {
        "description": "Number of words on the page (controls for text length).",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "num_words"
        ]
      },
      {
        "description": "Flesch-Kincaid readability score of the text (controls for text difficulty).",
