        "columns": [
          "retake_trial"
        ]
      },
      {
        "description": "Indicator whether the reader is a native English speaker (1 = Y/native, 0 = N/non-native).",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "english_native_bin"
        ]
      },
      {
        "description": "Comprehension correctness rate for the trial (controls for engagement/effort).",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "correct_rate"
        ]
      },
      {
        "description": "Device used for the trial (categorical: smartphone/tablet/desktop). Included as a categorical control (fixed effect).",
        "is_moderator": false,
