  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    # Make a copy to avoid modifying original\n    df = df.copy()\n\n    # Rename raw features to meaningful names used in modeling\n    # feature1: participant or record id\n    # feature2: page id\n    # feature3: reader view activated (1/0)\n    # feature5: time spent on page minus scrolling (ms)\n    # feature7: number of words on page\n    # feature10: age\n    # feature11: device\n    # feature12: dyslexia status (0/1/2)\n    # feature13: education\n    # feature14: gender (0/1/2)\n    # feature16: retake flag (1/0)\n    # feature17: dyslexia binary (1 = dyslexia, 0 = not)\n    # feature18: native english ('Y'/'N')\n    # feature19: readability score\n\n    df = df.rename(columns={\n        'feature1': 'ParticipantID',\n        'feature2': 'PageID',\n        'feature3': 'ReaderView_raw',\n        'feature4': 'TotalTime_ms',\n        'feature5': 'ReadTime_ms',\n        'feature6': 'ScrollTime_ms',\n        'feature7': 'Words',\n        'feature8': 'ComprehensionRate',\n        'feature9': 'ImageWidth',\n        'feature10': 'Age',\n        'feature11': 'Device',\n        'feature12': 'Dyslexia_multiclass',\n        'feature13': 'Education',\n        'feature14': 'Gender_raw',\n        'feature15': 'Language',\n        'feature16': 'Retake',\n        'feature17': 'Dyslexia',\n        'feature18': 'NativeEnglish_raw',\n        'feature19': 'Readability',\n        'feature20': 'feature20'\n    })\n\n    # Keep only rows with necessary fields non-missing\n    required = ['ReaderView_raw', 'ReadTime_ms', 'Words', 'Dyslexia', 'Age']\n    df = df.dropna(subset=required)\n\n    # Ensure ReaderView and Dyslexia are numeric ints (0/1)\n    df['ReaderView'] = df['ReaderView_raw'].astype(float).fillna(0).astype(int)\n    df['Dyslexia'] = df['Dyslexia'].astype(float).fillna(0).astype(int)\n\n    # ReadTime_ms should be positive; replace zeros or extremely small values with a small floor to avoid division by zero\n    df['ReadTime_ms'] = pd.to_numeric(df['ReadTime_ms'], errors='coerce')\n    df = df.dropna(subset=['ReadTime_ms'])\n    df.loc[df['ReadTime_ms'] < 50, 'ReadTime_ms'] = 50.0  # set floor 50 ms to avoid unrealistic divisions\n\n    # Words as numeric\n    df['Words'] = pd.to_numeric(df['Words'], errors='coerce')\n    df = df.dropna(subset=['Words'])\n    df = df[df['Words'] > 0]\n\n    # Compute Words Per Minute (WPM) using ReadTime_ms (ms). WPM = words / (time_min)\n    # time_min = ReadTime_ms / (1000 * 60)\n    df['ReadingSpeed_wpm'] = df['Words'] / (df['ReadTime_ms'] / 1000.0) * 60.0\n\n    # Remove extreme outliers in ReadingSpeed_wpm (e.g., > 1000 wpm) which are likely measurement errors\n    df = df[(df['ReadingSpeed_wpm'] > 1) & (df['ReadingSpeed_wpm'] < 2000)]\n\n    # Log-transform the reading speed to stabilize variance and reduce skew\n    df['log_ReadingSpeed'] = np.log(df['ReadingSpeed_wpm'])\n\n    # Age numeric\n    df['Age'] = pd.to_numeric(df['Age'], errors='coerce')\n\n    # Device categorical: keep as is but fill missing as 'unknown'\n    df['Device'] = df['Device'].fillna('unknown').astype(str)\n\n    # Education categorical: fill missing\n    df['Education'] = df['Education'].fillna('unknown').astype(str)\n\n    # Gender: convert to string categories to treat as categorical in model\n    df['Gender'] = df['Gender_raw'].astype(str).fillna('unknown')\n\n    # Native English: convert 'Y'/'N' to binary (1/0). If other encoding, attempt mapping.\n    df['NativeEnglish'] = df['NativeEnglish_raw'].map({'Y': 1, 'N': 0})\n    # If mapping produced NaN (other encodings), coerce: non-null strings -> 0/1 fallback\n    df['NativeEnglish'] = df['NativeEnglish'].fillna(0).astype(int)\n\n    # Retake numeric 0/1\n    df['Retake'] = pd.to_numeric(df['Retake'], errors='coerce').fillna(0).astype(int)\n\n    # Readability numeric\n    df['Readability'] = pd.to_numeric(df['Readability'], errors='coerce')\n\n    # ParticipantID: keep as-is for clustering; ensure no missing\n    df['ParticipantID'] = df['ParticipantID'].astype(str).fillna('unknown')\n\n    # Final filtering: ensure DV available and key covariates present\n    model_cols = ['log_ReadingSpeed', 'ReaderView', 'Dyslexia', 'Age', 'Device', 'Education', 'Gender', 'NativeEnglish', 'Retake', 'Readability', 'ParticipantID']\n    df = df.dropna(subset=model_cols)\n\n    # Optionally, cap extreme log values to reduce influence of remaining outliers (winsorize at 1st/99th percentile)\n    lower = df['log_ReadingSpeed'].quantile(0.01)\n    upper = df['log_ReadingSpeed'].quantile(0.99)\n    df['log_ReadingSpeed'] = df['log_ReadingSpeed'].clip(lower=lower, upper=upper)\n\n    # Keep only columns needed for modeling (but retain some raw columns for diagnostics)\n    keep_cols = model_cols + ['ReadingSpeed_wpm', 'Words', 'ReadTime_ms', 'PageID', 'TotalTime_ms', 'ScrollTime_ms', 'ComprehensionRate']\n    keep_cols = [c for c in keep_cols if c in df.columns]\n\n    return df[keep_cols]\n"
  ,
  "m_code": "def model(df: pd.DataFrame) -> any:\n    import statsmodels.formula.api as smf\n    import statsmodels.api as sm\n\n    # Use formula with ReaderView * Dyslexia interaction and categorical controls for Device, Education, Gender\n    # Dependent variable: log_ReadingSpeed\n    formula = (\n        'log_ReadingSpeed ~ ReaderView * Dyslexia + Age + C(Device) + C(Education) + C(Gender)'\n        ' + NativeEnglish + Retake + Readability'\n    )\n\n    # Fit OLS\n    ols_res = smf.ols(formula, data=df).fit()\n\n    # Compute cluster-robust standard errors by ParticipantID (repeated measures per participant)\n    try:\n        clustered = ols_res.get_robustcov_results(cov_type='cluster', groups=df['ParticipantID'])\n    except Exception:\n        # Fallback to heteroskedasticity-robust (HC3) if clustering fails\n        clustered = ols_res.get_robustcov_results(cov_type='HC3')\n\n    # Return the robust results object (has summary(), params, pvalues, conf_int(), etc.)\n    return clustered\n"
}
