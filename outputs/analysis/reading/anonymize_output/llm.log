          "NumWords"
        ]
      }
    ]
  },
  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform raw dataset into analysis-ready dataframe.\n\n    Produces the following new columns (used in modeling):\n      - ReaderView: binary (0/1) from feature3\n      - ReadingTimeMs: reading time excluding scrolling (feature5)\n      - NumWords: number of words on page (feature7)\n      - ReadingSpeedWPM: NumWords / (ReadingTimeMs in minutes)\n      - LogReadingSpeed: np.log1p(ReadingSpeedWPM)  (DV)\n      - Dyslexia: binary indicator from feature17 (0/1)\n      - Age, Device, Education, Gender, IsNativeEnglish, Comprehension, Readability, IsRetake\n\n    Rows with missing or invalid essential values (nonpositive reading time or words) are dropped.\n    \"\"\"\n    # Make a shallow copy to avoid modifying caller's dataframe in-place\n    df = df.copy()\n\n    # Core variables\n    # Reader view: feature3 is coded 0/1 already; ensure integer\n    df['ReaderView'] = pd.to_numeric(df.get('feature3', None), errors='coerce').astype('float')\n\n    # Reading time excluding scrolling in milliseconds (feature5)\n    df['ReadingTimeMs'] = pd.to_numeric(df.get('feature5', None), errors='coerce')\n\n    # Number of words on page (feature7)\n    df['NumWords'] = pd.to_numeric(df.get('feature7', None), errors='coerce')\n\n    # Dyslexia indicator: feature17 is 0/1 in schema (1 = dyslexia)\n    df['Dyslexia'] = pd.to_numeric(df.get('feature17', None), errors='coerce').fillna(0).astype(int)\n\n    # Other controls\n    df['Age'] = pd.to_numeric(df.get('feature10', None), errors='coerce')\n    # Device and Education are categorical text fields\n    df['Device'] = df.get('feature11', None).astype(str).fillna('unknown')\n    df['Education'] = df.get('feature13', None).astype(str).fillna('unknown')\n\n    # Gender: original encoding 0/1/2; convert to string categories if possible\n    # Map common numeric encodings to strings; otherwise cast to string\n    try:\n        df['Gender'] = df['feature14'].map({0: 'Male', 1: 'Female', 2: 'Other'}).fillna(df['feature14'].astype(str)).astype(str)\n    except Exception:\n        df['Gender'] = df.get('feature14', None).astype(str).fillna('unknown')\n\n    # IsNativeEnglish: feature18 'Y'/'N'\n    df['IsNativeEnglish'] = df.get('feature18', None).map({'Y': 1, 'N': 0})\n    # If feature18 missing or other, fill with 0\n    df['IsNativeEnglish'] = df['IsNativeEnglish'].fillna(0).astype(int)\n\n    # Comprehension rate (feature8) already proportion [0,1]\n    df['Comprehension'] = pd.to_numeric(df.get('feature8', None), errors='coerce')\n\n    # Readability score (feature19)\n    df['Readability'] = pd.to_numeric(df.get('feature19', None), errors='coerce')\n\n    # Retake indicator (feature16) 0/1\n    df['IsRetake'] = pd.to_numeric(df.get('feature16', None), errors='coerce').fillna(0).astype(int)\n\n    # Compute reading speed (words per minute)\n    # Exclude invalid nonpositive times or words\n    # Convert ReadingTimeMs to minutes and compute WPM\n    df['ReadingTimeMin'] = df['ReadingTimeMs'] / 1000.0 / 60.0\n\n    # Avoid division by zero -> set invalid if ReadingTimeMin <= 0\n    df.loc[df['ReadingTimeMin'] <= 0, 'ReadingSpeedWPM'] = np.nan\n    valid_time_mask = df['ReadingTimeMin'] > 0\n    df.loc[valid_time_mask, 'ReadingSpeedWPM'] = df.loc[valid_time_mask, 'NumWords'] / df.loc[valid_time_mask, 'ReadingTimeMin']\n\n    # Log-transform the reading speed for modeling (stabilizes variance)\n    df['LogReadingSpeed'] = np.log1p(df['ReadingSpeedWPM'])\n\n    # Drop rows missing essential modeling columns\n    essential_cols = ['ReaderView', 'LogReadingSpeed', 'Dyslexia', 'Age', 'Device', 'Education', 'Gender', 'IsNativeEnglish', 'Comprehension', 'Readability', 'IsRetake', 'NumWords']\n    df = df.dropna(subset=essential_cols)\n\n    # Optional trimming of extreme speeds: keep a wide range but remove numerical infinities\n    df = df[np.isfinite(df['LogReadingSpeed'])]\n\n    # Ensure proper dtypes\n    df['ReaderView'] = df['ReaderView'].astype(int)\n    df['Dyslexia'] = df['Dyslexia'].astype(int)\n    df['IsRetake'] = df['IsRetake'].astype(int)\n    df['IsNativeEnglish'] = df['IsNativeEnglish'].astype(int)\n\n    # Return the transformed dataframe containing all required columns\n    return df\n",
  "m_code": "def model(df: pd.DataFrame):\n    \"\"\"\n    Fit a linear model estimating whether Reader View improves reading speed for dyslexic readers.\n\n    Model: LogReadingSpeed ~ ReaderView * Dyslexia + controls\n    Controls: Age + C(Device) + C(Education) + C(Gender) + IsNativeEnglish + Comprehension + Readability + IsRetake + NumWords\n\n    Uses heteroskedasticity-robust standard errors (HC3).\n    Returns the fitted statsmodels results object.\n    \"\"\"\n    import statsmodels.formula.api as smf\n\n    # Make sure categorical columns are treated as strings (they were prepared in transform)\n    df = df.copy()\n\n    # Formula with interaction between ReaderView and Dyslexia (tests whether ReaderView effect differs for dyslexic readers)\n    formula = (\n        'LogReadingSpeed ~ ReaderView * Dyslexia + Age '\n        '+ C(Device) + C(Education) + C(Gender) '\n        '+ IsNativeEnglish + Comprehension + Readability + IsRetake + NumWords'\n    )\n\n    # Fit OLS with robust (HC3) standard errors\n    model = smf.ols(formula, data=df)\n    results = model.fit(cov_type='HC3')\n\n    # Return the results object for inspection (summary, params, confidence intervals, etc.)\n    return results\n"
}
