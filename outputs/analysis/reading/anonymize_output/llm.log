  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw dataset into a dataframe suitable for modeling.\n\n    - Computes time-per-word in seconds and its log (LogTimePerWord).\n    - Creates clean/explicit column names used in the model.\n    - Drops rows with invalid or missing timing or word counts.\n    - Maps categorical variables to consistent string categories where appropriate.\n\n    Returns the transformed dataframe containing all columns listed in the conceptual variables.\n    \"\"\"\n    df = df.copy()\n\n    # Rename raw columns to more descriptive local names for clarity (keep original feature names in source)\n    # feature3: Reader View indicator (1 on, 0 off)\n    # feature5: page time minus scrolling in ms (reading time in ms)\n    # feature7: number of words on page\n    # feature10: age\n    # feature11: device\n    # feature12: dyslexia severity (0,1,2)\n    # feature16: retake (1/0)\n    # feature17: dyslexia binary (1 dyslexia, 0 no)\n    # feature18: native english 'Y'/'N'\n    # feature19: readability score\n    # feature2: page id\n    # feature8: comprehension rate (0-1)\n\n    # Keep only rows that have the necessary columns\n    required_cols = ['feature3','feature5','feature7','feature10','feature11','feature12',\n                     'feature16','feature17','feature18','feature19','feature2','feature8']\n    # If any required column missing in incoming df, raise informative error\n    missing = [c for c in required_cols if c not in df.columns]\n    if len(missing) > 0:\n        raise KeyError(f\"Input dataframe is missing required columns: {missing}\")\n\n    # Ensure numeric types where expected\n    df['ReadingTime_ms'] = pd.to_numeric(df['feature5'], errors='coerce')\n    df['Words'] = pd.to_numeric(df['feature7'], errors='coerce')\n\n    # Drop rows with invalid or missing reading time or words\n    df = df.dropna(subset=['ReadingTime_ms','Words'])\n    df = df[(df['ReadingTime_ms'] > 0) & (df['Words'] > 0)]\n\n    # Compute seconds per word and log transform (dependent variable)\n    df['TimePerWord_s'] = (df['ReadingTime_ms'] / 1000.0) / df['Words']\n    # drop any pathological values\n    df = df[df['TimePerWord_s'] > 0]\n    df['LogTimePerWord'] = np.log(df['TimePerWord_s'])\n\n    # Independent variable: ReaderView\n    df['ReaderView'] = pd.to_numeric(df['feature3'], errors='coerce').fillna(0).astype(int)\n\n    # Control: Dyslexia (binary) and severity\n    df['Dyslexia'] = pd.to_numeric(df['feature17'], errors='coerce').fillna(0).astype(int)\n    # feature12: 0 = No, 1 = Dyslexia, 2 = Severe Dyslexia (as provided). Map to categorical strings for clarity.\n    def _map_severity(x):\n        try:\n            xi = int(x)\n        except Exception:\n            return 'NoDyslexia'\n        if xi == 0:\n            return 'NoDyslexia'\n        elif xi == 1:\n            return 'Dyslexia'\n        elif xi == 2:\n            return 'SevereDyslexia'\n        else:\n            return 'NoDyslexia'\n    df['DyslexiaSeverity'] = df['feature12'].apply(_map_severity).astype('category')\n\n    # Age\n    df['Age'] = pd.to_numeric(df['feature10'], errors='coerce')\n\n    # Device as categorical string\n    df['Device'] = df['feature11'].astype(str)\n\n    # Education categorical\n    df['Education'] = df['feature13'].astype(str)\n\n    # Gender: map numeric codes to readable categories if possible (0,1,2 per schema)\n    def _map_gender(x):\n        try:\n            xi = int(float(x))\n        except Exception:\n            return str(x)\n        if xi == 0:\n            return 'Male'\n        elif xi == 1:\n            return 'Female'\n        elif xi == 2:\n            return 'Other'\n        else:\n            return str(x)\n    df['Gender'] = df['feature14'].apply(_map_gender).astype('category')\n\n    # Native English\n    df['NativeEnglish'] = df['feature18'].astype(str).str.upper().map({'Y': 1, 'N': 0}).fillna(0).astype(int)\n\n    # Retake\n    df['Retake'] = pd.to_numeric(df['feature16'], errors='coerce').fillna(0).astype(int)\n\n    # Readability numeric\n    df['Readability'] = pd.to_numeric(df['feature19'], errors='coerce')\n\n    # Page ID categorical\n    df['PageID'] = df['feature2'].astype(str)\n\n    # Comprehension rate (0-1)\n    df['ComprehensionRate'] = pd.to_numeric(df['feature8'], errors='coerce')\n\n    # Drop rows with missing values in the covariates we will include in the model (conservative approach)\n    model_cols = ['LogTimePerWord','ReaderView','Dyslexia','Age','Device','Education','Gender',\n                  'NativeEnglish','Retake','Readability','PageID','ComprehensionRate']\n    df = df.dropna(subset=model_cols)\n\n    # Keep only columns needed for modeling plus a few raw identifiers for diagnostics\n    keep_cols = model_cols + ['DyslexiaSeverity','ReadingTime_ms','Words','feature1']\n    # If feature1 (unique record id) exists, keep it; else ignore\n    keep_cols = [c for c in keep_cols if c in df.columns]\n\n    return df[keep_cols]\n",
  "m_code": "def model(df: pd.DataFrame) -> any:\n    \"\"\"\n    Fit an OLS regression of log(seconds per word) on ReaderView and its interaction with Dyslexia,\n    controlling for demographic and trial-level covariates. Returns the fitted model results.\n\n    Model specification:\n      LogTimePerWord ~ ReaderView * Dyslexia + Age + C(Device) + C(Education) + C(Gender)\n                       + NativeEnglish + Retake + Readability + C(PageID) + ComprehensionRate\n\n    We use heteroskedasticity-robust standard errors (HC3).\n    \"\"\"\n    import statsmodels.formula.api as smf\n\n    # Build formula\n    formula = (\n        'LogTimePerWord ~ ReaderView * Dyslexia + Age + '\n        'C(Device) + C(Education) + C(Gender) + NativeEnglish + Retake + Readability + '\n        'C(PageID) + ComprehensionRate'\n    )\n\n    # Fit OLS with robust standard errors (HC3)\n    model_fit = smf.ols(formula=formula, data=df).fit(cov_type='HC3')\n\n    # Return the fitted results object (RegressionResultsWrapper). The caller can inspect summary(), params, etc.\n    return model_fit\n"
