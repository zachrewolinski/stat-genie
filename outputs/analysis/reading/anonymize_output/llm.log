{
  "cvars": {
    "ivs": [
      {
        "description": "Whether the Reader View (modified layout) was activated for the trial (1 = activated, 0 = not activated). Primary independent variable.",
        "columns": [
          "ReaderView"
        ]
      }
    ],
    "dv": {
      "description": "Reading speed measured in words per second computed as (Number of words on the page) / (reading time in seconds). Higher values indicate faster reading.",
      "columns": [
        "ReadingSpeed_wps"
      ]
    },
    "controls": [
      {
        "description": "Whether the reader has dyslexia (1) or not (0). This is the moderator of interest: we test whether the effect of ReaderView differs for readers with dyslexia.",
        "is_moderator": true,
        "moderator_on": "ReaderView",
        "columns": [
          "Dyslexia"
        ]
      },
      {
        "description": "Comprehension accuracy on post-reading questions (proportion correct). Controls for speed-accuracy tradeoff.",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "Comprehension"
        ]
      },
      {
        "description": "Age of the reader (in years). Controls for age-related reading speed differences.",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "Age"
        ]
      },
      {
        "description": "Binary indicator whether the trial was a retake (1) or original (0). Controls for practice effects.",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "Retake"
        ]
      },
      {
        "description": "Native language indicator (1 = native English speaker, 0 = not). Controls for language familiarity effects.",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "LanguageNative"
        ]
      },
      {
        "description": "Flesch-Kincaid readability score of the text. Controls for text difficulty.",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "Readability"
        ]
      },
      {
        "description": "Gender of reader encoded as numeric (0 male, 1 female, 2 other); included as a demographic control.",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "Gender"
        ]
      },
      {
        "description": "Device dummies for device used (baseline: smartphone). Created via get_dummies(drop_first=True). Controls for device/form factor effects.",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "Device_tablet",
          "Device_desktop"
        ]
      },
      {
        "description": "Interaction term between ReaderView and Dyslexia (ReaderView * Dyslexia) used to estimate whether ReaderView has a different effect for readers with dyslexia.",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "ReaderView_x_Dyslexia"
        ]
      }
    ]
