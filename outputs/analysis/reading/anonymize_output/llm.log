{
  "cvars": {
    "ivs": [
      {
        "description": "Whether Reader View was activated for the trial (1 = Reader View ON, 0 = Reader View OFF). Primary manipulated variable whose effect on reading speed we estimate.",
        "columns": [
          "ReaderView"
        ]
      }
    ],
    "dv": {
      "description": "Log-transformed reading speed in words-per-minute: LogReadingSpeed = log1p(Words / (ReadingTimeMs/1000/60)). Log transform improves normality and reduces influence of extreme speeds.",
      "columns": [
        "LogReadingSpeed"
      ]
    },
    "controls": [
      {
        "description": "Binary indicator whether the reader has dyslexia (1 = dyslexia, 0 = no dyslexia). This is the subgroup of interest and will be used as a moderator (interaction with ReaderView).",
        "is_moderator": true,
        "moderator_on": "ReaderView",
        "columns": [
          "Dyslexia"
        ]
      },
      {
        "description": "Reader age in years (continuous).",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "Age"
        ]
      },
      {
        "description": "Device category used by the reader (categorical). Will be included as a categorical control (C(Device)) in the model.",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "Device"
        ]
      },
      {
        "description": "Education level of the reader (categorical). Included as C(Education).",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "Education"
        ]
      },
      {
        "description": "Reader gender as categorical string ('Male','Female','Other','Unknown'). Included as C(Gender).",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "Gender"
        ]
      },
      {
        "description": "Native English indicator (1 = text language is native for reader, 0 = not).",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "IsNativeEnglish"
        ]
      },
      {
        "description": "Comprehension correctness rate after reading (proportion correct, continuous).",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "Comprehension"
        ]
      },
      {
        "description": "Flesch-Kincaid or readability score of the text (continuous).",
