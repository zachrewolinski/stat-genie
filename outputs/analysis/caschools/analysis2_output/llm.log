  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw dataset to produce the columns required for the statistical model.\n\n    Output columns:\n    - StudentTeacherRatio: enrollment / teachers (winsorized at 1st/99th percentiles)\n    - AvgScore: mean of feature14 (reading) and feature15 (math)\n    - ExpPerStudent: feature11 (expenditure per student)\n    - PctReducedLunch: feature9\n    - PctCalWorks: feature8\n    - PctEngLearners: feature13\n    - AvgIncomeK: feature12 (already in thousands USD)\n    - ComputersPerStudent: feature10 / feature6\n    - GradeSpan_KK08: binary indicator from feature5 ('KK-08' -> 1, else 0)\n    - County: feature4 (categorical identifier)\n    \"\"\"\n    # Make a copy to avoid mutating the input\n    df = df.copy()\n\n    # Required raw columns (as per schema)\n    required_cols = [\n        'feature6',  # enrollment\n        'feature7',  # number of teachers (FTE)\n        'feature14', # avg reading score\n        'feature15', # avg math score\n        'feature11', # expenditure per student\n        'feature9',  # percent reduced-price lunch\n        'feature8',  # percent CalWorks\n        'feature13', # percent English learners\n        'feature12', # district average income (in 1,000s)\n        'feature10', # number of computers\n        'feature5',  # grade span\n        'feature4'   # county\n    ]\n\n    # Drop rows missing any of the required columns\n    df = df.dropna(subset=required_cols)\n\n    # Avoid division by zero for teacher counts\n    df.loc[df['feature7'] == 0, 'feature7'] = np.nan\n    df = df.dropna(subset=['feature7'])\n\n    # Dependent variable: average of reading and math\n    df['AvgScore'] = df[['feature14', 'feature15']].mean(axis=1)\n\n    # Independent variable: student-teacher ratio = enrollment / teachers\n    df['StudentTeacherRatio'] = df['feature6'] / df['feature7']\n\n    # Winsorize StudentTeacherRatio to reduce influence of extreme outliers (1st and 99th percentiles)\n    lower = df['StudentTeacherRatio'].quantile(0.01)\n    upper = df['StudentTeacherRatio'].quantile(0.99)\n    df['StudentTeacherRatio'] = df['StudentTeacherRatio'].clip(lower=lower, upper=upper)\n\n    # Controls and auxiliary variables\n    df['ExpPerStudent'] = df['feature11']\n    df['PctReducedLunch'] = df['feature9']\n    df['PctCalWorks'] = df['feature8']\n    df['PctEngLearners'] = df['feature13']\n    df['AvgIncomeK'] = df['feature12']\n\n    # Computers per student\n    # Avoid division by zero for enrollment\n    df.loc[df['feature6'] == 0, 'feature6'] = np.nan\n    df['ComputersPerStudent'] = df['feature10'] / df['feature6']\n\n    # Grade span indicator (KK-08 vs KK-06)\n    df['GradeSpan_KK08'] = df['feature5'].apply(lambda x: 1 if str(x).strip() == 'KK-08' else 0)\n\n    # County (categorical) - keep as-is for use with C(County) in model formula\n    df['County'] = df['feature4'].astype(str)\n\n    # Keep only the columns needed for modeling to avoid accidental use of raw features\n    model_cols = [\n        'AvgScore',\n        'StudentTeacherRatio',\n        'ExpPerStudent',\n        'PctReducedLunch',\n        'PctCalWorks',\n        'PctEngLearners',\n        'AvgIncomeK',\n        'ComputersPerStudent',\n        'GradeSpan_KK08',\n        'County'\n    ]\n\n    df = df[model_cols].reset_index(drop=True)\n    return df\n",
  "m_code": "def model(df: pd.DataFrame) -> any:\n    \"\"\"\n    Fit an OLS regression of AvgScore on StudentTeacherRatio controlling for district covariates.\n\n    Formula:\n      AvgScore ~ StudentTeacherRatio + ExpPerStudent + PctReducedLunch + PctCalWorks\n                 + PctEngLearners + AvgIncomeK + ComputersPerStudent + GradeSpan_KK08\n                 + C(County)\n\n    County is included as a categorical fixed effect to absorb county-level unobserved heterogeneity.\n    Robust (HC3) standard errors are used to reduce sensitivity to heteroskedasticity.\n\n    Returns the fitted statsmodels results object.\n    \"\"\"\n    import statsmodels.formula.api as smf\n\n    # Drop any remaining missing values in model columns\n    df_model = df.dropna(subset=[\n        'AvgScore', 'StudentTeacherRatio', 'ExpPerStudent', 'PctReducedLunch',\n        'PctCalWorks', 'PctEngLearners', 'AvgIncomeK', 'ComputersPerStudent', 'GradeSpan_KK08', 'County'\n    ])\n\n    formula = (\n        'AvgScore ~ StudentTeacherRatio + ExpPerStudent + PctReducedLunch + PctCalWorks '\n        '+ PctEngLearners + AvgIncomeK + ComputersPerStudent + GradeSpan_KK08 + C(County)'\n    )\n\n    model_fit = smf.ols(formula, data=df_model).fit(cov_type='HC3')\n\n    # Print a compact summary to assist users; also return the full results object\n    try:\n        print(model_fit.summary())\n    except Exception:\n        # In contexts where printing is not desired, ignore\n        pass\n\n    return model_fit\n"
}
