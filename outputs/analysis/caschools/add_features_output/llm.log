dLunch', 'IncomeK',\n                  'PercentEnglishLearners', 'ExpenditurePerStudent', 'ComputersPerStudent', 'LogEnrollment',\n                  'Grades', 'County']\n    df = df[model_cols].reset_index(drop=True)\n\n    return df\n",
