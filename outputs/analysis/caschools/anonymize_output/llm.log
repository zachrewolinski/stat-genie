  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw dataset into a dataframe suitable for modeling.\n\n    Produces the following new columns used in the model:\n      - Enrollment: feature6 (float)\n      - NumTeachers: feature7 (float), NaN if <= 0\n      - StudentTeacherRatio: Enrollment / NumTeachers (winsorized at 1st/99th pct)\n      - ReadingScore: feature14 (float)\n      - MathScore: feature15 (float)\n      - AvgScore: mean of ReadingScore and MathScore\n      - PctCalWorks: feature8 (float)\n      - PctReducedLunch: feature9 (float)\n      - Computers: feature10 (float)\n      - ComputersPerStudent: Computers / Enrollment\n      - ExpenditurePerStudent: feature11 (float)\n      - DistrictIncomeK: feature12 (float)\n      - PctEnglishLearners: feature13 (float)\n      - GradeSpan: feature5 (string)\n      - County: feature4 (string)\n      - LogEnrollment: log1p(Enrollment)\n\n    Drops rows with missing values in core variables.\n    \"\"\"\n    df = df.copy()\n\n    # Required raw columns\n    required = [\n        'feature6',  # enrollment\n        'feature7',  # num teachers (FTE)\n        'feature14', # reading score\n        'feature15', # math score\n        'feature8',  # pct CalWorks\n        'feature9',  # pct reduced lunch\n        'feature10', # num computers\n        'feature11', # expenditure per student\n        'feature12', # district income (k)\n        'feature13', # pct english learners\n        'feature5',  # grade span\n        'feature4'   # county\n    ]\n\n    # Drop rows missing critical raw values\n    df = df.dropna(subset=required)\n\n    # Copy / coerce types\n    df['Enrollment'] = pd.to_numeric(df['feature6'], errors='coerce')\n    df['NumTeachers'] = pd.to_numeric(df['feature7'], errors='coerce')\n\n    # Remove invalid teacher counts (<= 0) because ratio would be infinite/invalid\n    df.loc[df['NumTeachers'] <= 0, 'NumTeachers'] = np.nan\n    df = df.dropna(subset=['Enrollment', 'NumTeachers'])\n\n    # Student-teacher ratio\n    df['StudentTeacherRatio'] = df['Enrollment'] / df['NumTeachers']\n\n    # Winsorize student-teacher ratio at 1st and 99th percentiles to reduce influence of extreme outliers\n    lower = df['StudentTeacherRatio'].quantile(0.01)\n    upper = df['StudentTeacherRatio'].quantile(0.99)\n    df['StudentTeacherRatio'] = df['StudentTeacherRatio'].clip(lower, upper)\n\n    # Scores\n    df['ReadingScore'] = pd.to_numeric(df['feature14'], errors='coerce')\n    df['MathScore'] = pd.to_numeric(df['feature15'], errors='coerce')\n    df['AvgScore'] = df[['ReadingScore', 'MathScore']].mean(axis=1)\n\n    # Controls\n    df['PctCalWorks'] = pd.to_numeric(df['feature8'], errors='coerce')\n    df['PctReducedLunch'] = pd.to_numeric(df['feature9'], errors='coerce')\n    df['Computers'] = pd.to_numeric(df['feature10'], errors='coerce')\n    df['ComputersPerStudent'] = df['Computers'] / df['Enrollment']\n    df['ExpenditurePerStudent'] = pd.to_numeric(df['feature11'], errors='coerce')\n    df['DistrictIncomeK'] = pd.to_numeric(df['feature12'], errors='coerce')\n    df['PctEnglishLearners'] = pd.to_numeric(df['feature13'], errors='coerce')\n\n    # Categorical controls\n    df['GradeSpan'] = df['feature5'].astype(str)\n    df['County'] = df['feature4'].astype(str)\n\n    # Log-transform of enrollment to reduce skew\n    df['LogEnrollment'] = np.log1p(df['Enrollment'])\n\n    # Drop rows still missing any key modeling variables\n    model_vars = [\n        'StudentTeacherRatio', 'AvgScore', 'PctReducedLunch', 'PctEnglishLearners',\n        'ExpenditurePerStudent', 'ComputersPerStudent', 'PctCalWorks', 'LogEnrollment'\n    ]\n    df = df.dropna(subset=model_vars)\n\n    # Reset index and return\n    df = df.reset_index(drop=True)\n    return df\n",
  "m_code": "def model(df: pd.DataFrame):\n    \"\"\"\n    Fit an OLS regression to estimate the association between student-teacher ratio and average test score.\n\n    Model specification:\n      AvgScore ~ StudentTeacherRatio + LogEnrollment + ExpenditurePerStudent + DistrictIncomeK\n                 + PctReducedLunch + PctEnglishLearners + ComputersPerStudent + PctCalWorks\n                 + C(GradeSpan)\n\n    Uses robust (HC1) standard errors to guard against heteroskedasticity. Returns the fitted results object.\n    \"\"\"\n    import statsmodels.formula.api as smf\n\n    # Ensure a copy so we don't modify caller frame\n    df_model = df.copy()\n\n    formula = (\n        'AvgScore ~ StudentTeacherRatio + LogEnrollment + ExpenditurePerStudent + DistrictIncomeK '\n        '+ PctReducedLunch + PctEnglishLearners + ComputersPerStudent + PctCalWorks + C(GradeSpan)'\n    )\n\n    fit = smf.ols(formula=formula, data=df_model).fit(cov_type='HC1')\n\n    # Return the fitted results object (has .summary(), .params, .bse, etc.)\n    return fit\n"
