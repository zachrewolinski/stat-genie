  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the original dataframe into the analysis dataframe.\n\n    Creates the following columns (all used in the model):\n      - AvgScore: mean of feature14 (reading) and feature15 (math)\n      - StudentTeacherRatio: feature6 / feature7\n      - STR_log: natural log of StudentTeacherRatio\n      - ExpenditurePerStudent: feature11\n      - ComputersPerClassroom: feature10\n      - PercentCalWorks: feature8\n      - PercentReducedLunch: feature9\n      - PercentEnglishLearners: feature13\n      - AvgIncome: feature12\n      - GradeSpan_KK08: binary indicator from feature5\n      - County_*: dummy columns generated from feature4 (drop_first=True)\n\n    Drops rows with missing key variables required for the regression.\n    \"\"\"\n    df = df.copy()\n\n    # Create dependent variable: average of reading and math scores\n    df['AvgScore'] = df[['feature14', 'feature15']].mean(axis=1)\n\n    # Create student-teacher ratio, guard against division by zero\n    df['Enrollment'] = df['feature6']\n    df['NumTeachers'] = df['feature7']\n    # If NumTeachers is zero or missing, ratio will be set to NaN\n    df['StudentTeacherRatio'] = df['Enrollment'] / df['NumTeachers']\n    df.loc[~np.isfinite(df['StudentTeacherRatio']), 'StudentTeacherRatio'] = np.nan\n\n    # Log-transform the ratio for more symmetric distribution\n    # Add a small positive offset only if ratio is non-positive (should not be, but guard anyway)\n    df.loc[df['StudentTeacherRatio'] <= 0, 'StudentTeacherRatio'] = np.nan\n    df['STR_log'] = np.log(df['StudentTeacherRatio'])\n\n    # Map control variables to clearer column names\n    df['ExpenditurePerStudent'] = df['feature11']\n    df['ComputersPerClassroom'] = df['feature10']\n    df['PercentCalWorks'] = df['feature8']\n    df['PercentReducedLunch'] = df['feature9']\n    df['PercentEnglishLearners'] = df['feature13']\n    df['AvgIncome'] = df['feature12']\n\n    # Binary indicator for grade span; treat unknowns as 0\n    df['GradeSpan_KK08'] = df['feature5'].apply(lambda x: 1 if str(x).strip() == 'KK-08' else 0)\n\n    # County dummies (drop first to avoid perfect multicollinearity)\n    # Keep original county column for traceability\n    df['County'] = df['feature4']\n    county_dummies = pd.get_dummies(df['County'], prefix='County', dummy_na=False, drop_first=True)\n    df = pd.concat([df, county_dummies], axis=1)\n\n    # Drop rows missing dependent variable, independent variable, or core controls.\n    required_cols = [\n        'AvgScore',\n        'STR_log',\n        'ExpenditurePerStudent',\n        'ComputersPerClassroom',\n        'PercentCalWorks',\n        'PercentReducedLunch',\n        'PercentEnglishLearners',\n        'AvgIncome',\n        'GradeSpan_KK08'\n    ]\n    df = df.dropna(subset=required_cols)\n\n    # Optionally, you may want to inspect distribution and winsorize extreme values.\n    # For reproducibility we do not modify values further here.\n\n    return df\n",
  "m_code": "def model(df: pd.DataFrame) -> Any:\n    \"\"\"\n    Fit an OLS regression of AvgScore on STR_log and controls.\n\n    Model specification:\n        AvgScore = beta0 + beta1 * STR_log + beta2 * ExpenditurePerStudent + ... + county fixed effects + error\n\n    Uses robust (HC3) standard errors.\n    Returns the fitted statsmodels regression results object.\n    \"\"\"\n    # Identify county dummy columns (those created in transform)\n    county_cols = [col for col in df.columns if col.startswith('County_')]\n\n    # Define regressors\n    X_cols = [\n        'STR_log',\n        'ExpenditurePerStudent',\n        'ComputersPerClassroom',\n        'PercentCalWorks',\n        'PercentReducedLunch',\n        'PercentEnglishLearners',\n        'AvgIncome',\n        'GradeSpan_KK08'\n    ] + county_cols\n\n    X = df[X_cols]\n    # Add constant\n    X = sm.add_constant(X)\n    y = df['AvgScore']\n\n    # Fit OLS with heteroskedasticity-robust standard errors\n    model_res = sm.OLS(y, X).fit(cov_type='HC3')\n\n    # Return the fitted model object (contains params, summary, etc.)\n    return model_res\n"
