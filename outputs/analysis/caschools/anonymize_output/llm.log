                                df['feature10'] / df['feature6'],\n                                         np.nan)\n\n    # Keep only rows with the variables needed for modeling\n    model_cols = ['AvgScore', 'StuTeacherRatio', 'PctReducedLunch', 'PctEnglishLearners',\n                  'ExpPerStudent', 'AvgIncome', 'ComputersPerStudent']\n    # If any of the expected source columns are missing entirely, raise an informative error\n    missing_source = [c for c in ['feature6','feature7','feature14','feature15','feature9','feature13','feature11','feature12','feature10'] if c not in df.columns]\n    if len(missing_source) > 0:\n        raise ValueError(f\"Missing expected source columns in input dataframe: {missing_source}\")\n\n    df = df.dropna(subset=model_cols)\n\n    # Light winsorization to reduce influence of extreme outliers on ratios/resources\n    # (cap at 1st and 99th percentiles for continuous predictors)\n    def winsorize_series(s):\n        lower = s.quantile(0.01)\n        upper = s.quantile(0.99)\n        return s.clip(lower=lower, upper=upper)\n\n    df['StuTeacherRatio'] = winsorize_series(df['StuTeacherRatio'])\n    df['ComputersPerStudent'] = winsorize_series(df['ComputersPerStudent'])\n    df['ExpPerStudent'] = winsorize_series(df['ExpPerStudent'])\n    df['AvgIncome'] = winsorize_series(df['AvgIncome'])\n\n    # Final returned dataframe contains all original columns plus the derived variables\n    return df\n",
