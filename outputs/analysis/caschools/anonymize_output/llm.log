  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw dataset into a dataframe with the variables required for modeling.\n\n    Final columns produced/used by the model (important exact names):\n      - StudentTeacherRatio: Enrollment / TeacherFTE\n      - AvgTestScore: mean of feature14 (avg reading) and feature15 (avg math)\n      - PercentReducedLunch: feature9\n      - PercentEnglishLearners: feature13\n      - ExpenditurePerStudent: feature11\n      - AvgDistrictIncome: feature12\n      - ComputersPerStudent: feature10 / Enrollment\n      - GradeSpan_* : dummy(s) created from feature5 (prefix 'GradeSpan_', drop_first=True)\n\n    Notes:\n      - Drops rows with missing enrollment, teacher FTE, or average scores.\n      - Removes rows with TeacherFTE <= 0 to avoid division by zero.\n    \"\"\"\n    df = df.copy()\n\n    # Ensure numeric conversion for numeric fields (coerce invalid to NaN)\n    numeric_cols = [\n        'feature6',  # Enrollment\n        'feature7',  # Number of teachers (FTE)\n        'feature9',  # Percent reduced-price lunch\n        'feature10', # Number of computers\n        'feature11', # Expenditure per student\n        'feature12', # Avg district income\n        'feature13', # Percent English learners\n        'feature14', # Avg reading score\n        'feature15'  # Avg math score\n    ]\n    for c in numeric_cols:\n        df[c] = pd.to_numeric(df[c], errors='coerce')\n\n    # Drop rows missing essential variables\n    df = df.dropna(subset=['feature6', 'feature7', 'feature14', 'feature15'])\n\n    # Remove impossible teacher counts (avoid division by zero)\n    df = df[df['feature7'] > 0]\n\n    # Create clear variable names used in modeling\n    df['Enrollment'] = df['feature6']\n    df['TeacherFTE'] = df['feature7']\n    df['StudentTeacherRatio'] = df['Enrollment'] / df['TeacherFTE']\n\n    df['AvgReading'] = df['feature14']\n    df['AvgMath'] = df['feature15']\n    df['AvgTestScore'] = df[['AvgReading', 'AvgMath']].mean(axis=1)\n\n    df['PercentReducedLunch'] = df['feature9']\n    df['PercentEnglishLearners'] = df['feature13']\n    df['ExpenditurePerStudent'] = df['feature11']\n    df['AvgDistrictIncome'] = df['feature12']\n\n    # Computers per student; guard against division errors\n    df['ComputersPerStudent'] = df['feature10'] / df['Enrollment']\n    df['ComputersPerStudent'].replace([np.inf, -np.inf], np.nan, inplace=True)\n\n    # Create grade-span dummies from feature5; drop first to avoid multicollinearity\n    # This will create e.g. GradeSpan_KK-08 if KK-08 is present and KK-06 is reference\n    if 'feature5' in df.columns:\n        df['feature5'] = df['feature5'].astype('category')\n        dummies = pd.get_dummies(df['feature5'], prefix='GradeSpan', drop_first=True)\n        # Ensure consistent column naming when only a single non-reference level exists\n        df = pd.concat([df, dummies], axis=1)\n\n    # Return transformed dataframe with the new columns (keep original columns too)\n    return df\n",
