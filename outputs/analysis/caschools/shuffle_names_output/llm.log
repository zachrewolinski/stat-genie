on)\n    df['StudentTeacherRatio'] = df['calworks'] / df['teachers']\n\n    # Controls: rename source columns into clear names used in the model\n    # Percent reduced-price lunch (socioeconomic disadvantage proxy)\n    if 'math' in df.columns:\n        df['PercentReducedLunch'] = df['math']\n    else:\n        df['PercentReducedLunch'] = np.nan\n\n    # Percent English learners\n    if 'district' in df.columns:\n        df['PercentEnglishLearners'] = df['district']\n    else:\n        df['PercentEnglishLearners'] = np.nan\n\n    # Number of computers (district total)\n    if 'english' in df.columns:\n        df['NumComputers'] = df['english']\n    else:\n        df['NumComputers'] = np.nan\n\n    # Expenditure per student\n    if 'expenditure' in df.columns:\n        df['ExpenditurePerStudent'] = df['expenditure']\n    else:\n        df['ExpenditurePerStudent'] = np.nan\n\n    # District income indicator (whatever 'income' represents in the file)\n    if 'income' in df.columns:\n        df['DistrictIncome'] = df['income']\n    else:\n        df['DistrictIncome'] = np.nan\n\n    # Drop rows with missing values in any predictors or controls used in the model\n    model_vars = ['StudentTeacherRatio', 'ExpenditurePerStudent', 'PercentReducedLunch',\n                  'PercentEnglishLearners', 'NumComputers', 'DistrictIncome', 'AvgTestScore']\n    df = df.dropna(subset=model_vars)\n\n    # Standardize (z-score) the independent variable and controls for interpretability\n    def zscore(series):\n        return (series - series.mean()) / (series.std(ddof=0) if series.std(ddof=0) != 0 else 1.0)\n\n    df['STR_z'] = zscore(df['StudentTeacherRatio'])\n    df['Expenditure_z'] = zscore(df['ExpenditurePerStudent'])\n    df['Lunch_z'] = zscore(df['PercentReducedLunch'])\n    df['EnglishLearners_z'] = zscore(df['PercentEnglishLearners'])\n    df['Computers_z'] = zscore(df['NumComputers'])\n    df['Income_z'] = zscore(df['DistrictIncome'])\n\n    # Keep only columns necessary for modeling (but preserve original raw columns too)\n    model_columns = [\n        'AvgTestScore',\n        'StudentTeacherRatio', 'STR_z',\n        'ExpenditurePerStudent', 'Expenditure_z',\n        'PercentReducedLunch', 'Lunch_z',\n        'PercentEnglishLearners', 'EnglishLearners_z',\n        'NumComputers', 'Computers_z',\n        'DistrictIncome', 'Income_z'\n    ]\n\n    # Return the dataframe with model columns plus raw columns (so users can inspect)\n    return df.loc[:, df.columns.intersection(model_columns)]\n",
  "m_code": "def model(df: pd.DataFrame) -> Any:\n    \"\"\"\n    Fit an OLS regression to estimate the association between student-teacher ratio and academic performance.\n\n    Model specification:\n      AvgTestScore_i = beta0 + beta1 * STR_z_i + beta2 * Expenditure_z_i + beta3 * Lunch_z_i\n                       + beta4 * EnglishLearners_z_i + beta5 * Computers_z_i + beta6 * Income_z_i + eps_i\n\n    - Uses heteroskedasticity-robust standard errors (HC3).\n    - Returns the fitted statsmodels regression results object.\n    \"\"\"\n    df = df.copy()\n\n    # Ensure required columns exist\n    required = ['AvgTestScore', 'STR_z', 'Expenditure_z', 'Lunch_z', 'EnglishLearners_z', 'Computers_z', 'Income_z']\n    missing = [c for c in required if c not in df.columns]\n    if len(missing) > 0:\n        raise ValueError(f\"Missing required columns for model: {missing}\")\n\n    # Build design matrix\n    X = df[['STR_z', 'Expenditure_z', 'Lunch_z', 'EnglishLearners_z', 'Computers_z', 'Income_z']]\n    X = sm.add_constant(X)\n    y = df['AvgTestScore']\n\n    # Fit OLS with robust (HC3) standard errors\n    model = sm.OLS(y, X).fit(cov_type='HC3')\n\n    # Return the fitted results object (user can call .summary() or inspect params)\n    return model\n"
