  "transform_code": "# Transformations to prepare data for analysis\n# Assumptions mapping dataset fields to conceptual variables:\n# - 'calworks' contains total enrollment (TotalEnrollment)\n# - 'teachers' contains number of teachers (NumTeachers)\n# - 'grades' contains the district average test score (AcademicPerformance)\n# - 'expenditure' contains expenditure per student (ExpenditurePerStudent)\n# - 'math' contains percent qualifying for reduced-price lunch (PctReducedLunch)\n# - 'district' contains percent English learners (PctEnglishLearners)\n\n# Convert columns to numeric, coercing parse errors to NaN\ndf['TotalEnrollment'] = pd.to_numeric(df.get('calworks', pd.Series(dtype='float')), errors='coerce')\ndf['NumTeachers'] = pd.to_numeric(df.get('teachers', pd.Series(dtype='float')), errors='coerce')\ndf['AcademicPerformance'] = pd.to_numeric(df.get('grades', pd.Series(dtype='float')), errors='coerce')\ndf['ExpenditurePerStudent'] = pd.to_numeric(df.get('expenditure', pd.Series(dtype='float')), errors='coerce')\ndf['PctReducedLunch'] = pd.to_numeric(df.get('math', pd.Series(dtype='float')), errors='coerce')\ndf['PctEnglishLearners'] = pd.to_numeric(df.get('district', pd.Series(dtype='float')), errors='coerce')\n\n# Basic data cleaning: remove observations with missing core variables or invalid values\n# Need enrollment, teachers, and outcome\ndf = df.dropna(subset=['TotalEnrollment', 'NumTeachers', 'AcademicPerformance'])\n\n# Remove observations with nonpositive teachers to avoid division by zero or implausible values\ndf = df[df['NumTeachers'] > 0]\n\n# Compute the student-teacher ratio\n# If enrollment is 0 (rare), that row will be removed as not meaningful for ratio-based analysis\ndf = df[df['TotalEnrollment'] >= 1]\ndf['StudentTeacherRatio'] = df['TotalEnrollment'] / df['NumTeachers']\n\n# Create log-transformed variants for potential nonlinearity\n# add small constant to avoid log(0) just in case\ndf['log_STR'] = np.log1p(df['StudentTeacherRatio'])\ndf['log_Expenditure'] = np.log1p(df['ExpenditurePerStudent'].fillna(0))\n\n# Keep control columns (they may contain NaNs; model will handle with listwise deletion)\n# For transparency, create analytic sample indicator\nrequired_cols = ['StudentTeacherRatio', 'AcademicPerformance', 'ExpenditurePerStudent', 'PctReducedLunch', 'PctEnglishLearners', 'TotalEnrollment', 'NumTeachers', 'log_STR', 'log_Expenditure']\ndf['analytic_sample'] = ~df[required_cols].isnull().any(axis=1)\n\n# Return the transformed dataframe containing the new variables and original columns for reference\nreturn df\n",
  "m_code": "# Statistical model: OLS estimating association between student-teacher ratio and academic performance\n# The model includes key controls and reports robust standard errors (HC3).\n# Input: df should be the result of transform(df).\n\n# Subset to analytic sample (complete cases for modeling variables)\nmodel_df = df[df['analytic_sample']].copy()\n\n# Define dependent and independent variables\ny = model_df['AcademicPerformance']\nX = model_df[['StudentTeacherRatio', 'ExpenditurePerStudent', 'PctReducedLunch', 'PctEnglishLearners']]\n\n# Add constant\nX = sm.add_constant(X)\n\n# Fit OLS with robust standard errors (HC3)\nols_model = sm.OLS(y, X).fit(cov_type='HC3')\n\n# Secondary specification: log functional form for STR and Expenditure\nX_log = model_df[['log_STR', 'log_Expenditure', 'PctReducedLunch', 'PctEnglishLearners']]\nX_log = sm.add_constant(X_log)\nols_model_log = sm.OLS(y, X_log).fit(cov_type='HC3')\n\n# Return both models in a dict for downstream inspection\nresults = {\n    'ols_model': ols_model,\n    'ols_model_log': ols_model_log,\n    'n_obs': int(model_df.shape[0])\n}\n\nreturn results\n"
