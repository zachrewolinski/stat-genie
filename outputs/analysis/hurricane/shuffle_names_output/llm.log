t('\\n=== Negative-Binomial / Poisson (fallback) Results ===')\n        print(nb_res.summary())\n    except Exception:\n        print('NB/Poisson model summary unavailable')\n\n    print('\\n=== OLS (log-deaths) Results ===')\n    print(ols_res.summary())\n\n    return {\n        'nb_result': nb_res,\n        'ols_result': ols_res\n    }\n"
