me\")\n    df['MaxWind'] = pd.to_numeric(df['wind'], errors='coerce')\n\n    # Category (Saffir-Simpson)\n    if 'masfem' not in df.columns:\n        raise KeyError(\"Expected column 'masfem' (category) not found in dataframe\")\n    df['Category'] = pd.to_numeric(df['masfem'], errors='coerce')\n\n    # Year (note: schema labels 'alldeaths' as year)\n    if 'alldeaths' not in df.columns:\n        raise KeyError(\"Expected column 'alldeaths' (year) not found in dataframe\")\n    df['Year'] = pd.to_numeric(df['alldeaths'], errors='coerce')\n\n    # Economic damage control (ind) -> log transform\n    if 'ind' not in df.columns:\n        raise KeyError(\"Expected column 'ind' (normalized damage) not found in dataframe\")\n    df['LogDamage'] = pd.to_numeric(df['ind'], errors='coerce')\n    # Replace negative or missing damages with NaN then log-transform (add 1 to handle zeros)\n    df.loc[df['LogDamage'] < 0, 'LogDamage'] = np.nan\n    df['LogDamage'] = np.log(df['LogDamage'].fillna(0) + 1)\n\n    # Log-transform of deaths for OLS robustness\n    df['LogDeaths'] = np.log(df['Deaths'] + 1)\n\n    # Standardize name femininity for descriptives/interpretation\n    df['NameFem_z'] = (df['NameFemininity'] - df['NameFemininity'].mean()) / (df['NameFemininity'].std(ddof=0) if df['NameFemininity'].std(ddof=0) != 0 else 1)\n\n    # Keep only rows with complete data for the variables used in the models\n    required_cols = ['Deaths', 'LogDeaths', 'NameFemininity', 'NameFem_z', 'FemaleName', 'MaxWind', 'Category', 'Year', 'LogDamage']\n    df = df.dropna(subset=required_cols)\n\n    # Return only the columns required for subsequent modeling to make the modeling function simpler\n    return df[required_cols]\n",
