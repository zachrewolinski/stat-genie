= pd.to_numeric(df.get('wind'), errors='coerce')\n    df['min_pressure'] = pd.to_numeric(df.get('min'), errors='coerce')\n    # Saffir/Sinpson category as 'masfem' per schema description (1-5). Keep as numeric ordinal.\n    df['saffir'] = pd.to_numeric(df.get('masfem'), errors='coerce')\n    # Year of occurrence: schema labels this as 'alldeaths' (odd name). Use that if present.\n    if 'alldeaths' in df.columns:\n        df['year'] = pd.to_numeric(df['alldeaths'], errors='coerce')\n    else:\n        df['year'] = pd.to_numeric(df.get('year'), errors='coerce')\n\n    # Property damage adjusted (named 'ind' in the schema) -> log transform as control\n    df['property_damage'] = pd.to_numeric(df.get('ind'), errors='coerce')\n    df['log_property_damage'] = np.log1p(df['property_damage'].fillna(0.0))\n\n    # Drop rows with missing values on the variables we need for the main analysis\n    needed_cols = [\n        'deaths', 'femininity', 'female_name', 'wind', 'min_pressure',\n        'saffir', 'year', 'log_property_damage'\n    ]\n    df = df.dropna(subset=needed_cols)\n\n    # Filter to reasonable non-negative death counts and numeric types\n    df = df[df['deaths'].ge(0)]\n\n    # Standardize femininity for interpretability (z-score)\n    # Use population std (ddof=0) for standardization to make coefficients comparable\n    femininity_mean = df['femininity'].mean()\n    femininity_std = df['femininity'].std(ddof=0)\n    if (femininity_std == 0) or np.isnan(femininity_std):\n        # If for some reason there is no variation, set z to zero\n        df['femininity_z'] = 0.0\n    else:\n        df['femininity_z'] = (df['femininity'] - femininity_mean) / femininity_std\n\n    # Ensure binary female_name is coded 0/1\n    df['female_name'] = df['female_name'].apply(lambda x: 1 if x == 1 else 0)\n\n    # Final dataframe: keep only columns required for the model\n    final_cols = [\n        'deaths', 'femininity_z', 'female_name', 'wind', 'min_pressure',\n        'saffir', 'year', 'log_property_damage'\n    ]\n    df = df[final_cols].reset_index(drop=True)\n\n    return df\n"
