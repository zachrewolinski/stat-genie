  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    # Work on a copy\n    df = df.copy()\n\n    # Coerce key columns to numeric where appropriate; coerce errors to NaN\n    df['name'] = pd.to_numeric(df['name'], errors='coerce')          # femininity index (continuous)\n    df['ndam15'] = pd.to_numeric(df['ndam15'], errors='coerce')      # total deaths (count)\n    df['min'] = pd.to_numeric(df['min'], errors='coerce')            # max wind (named 'min' in dataset)\n    df['ind'] = pd.to_numeric(df['ind'], errors='coerce')            # normalized property damage\n    # elapsedyrs in dataset is a binary gender indicator (0 male, 1 female)\n    if 'elapsedyrs' in df.columns:\n        df['elapsedyrs'] = pd.to_numeric(df['elapsedyrs'], errors='coerce')\n    df['alldeaths'] = pd.to_numeric(df['alldeaths'], errors='coerce')  # used as event year per schema\n\n    # Ensure category is string (will be converted to dummies later)\n    if 'category' in df.columns:\n        df['category'] = df['category'].fillna('Unknown').astype(str)\n    else:\n        df['category'] = 'Unknown'\n\n    # Drop rows missing the primary independent or dependent variables or key controls\n    df = df.dropna(subset=['name', 'ndam15', 'min', 'ind', 'alldeaths'])\n\n    # Derived / transformed columns used in the model\n    # Standardize the femininity index for interpretability\n    df['name_z'] = (df['name'] - df['name'].mean()) / (df['name'].std(ddof=0) if df['name'].std(ddof=0) != 0 else 1)\n\n    # Keep the count outcome for count modeling and also a logged version for diagnostics\n    df['ndam15'] = df['ndam15'].astype(int)\n    df['log_ndam15'] = np.log1p(df['ndam15'])\n\n    # Rename / copy columns to analysis-friendly names\n    df['max_wind'] = df['min']\n    df['log_damage_ind'] = np.log1p(df['ind'])\n    df['event_year'] = df['alldeaths'].astype(int)\n\n    # Binary indicator from elapsedyrs column (if absent, default to 0)\n    if 'elapsedyrs' in df.columns:\n        # ensure values are 0/1\n        df['is_female_name'] = df['elapsedyrs'].fillna(0).astype(int).clip(0,1)\n    else:\n        df['is_female_name'] = 0\n\n    # Final check: drop any rows that still have NA in variables used in the model\n    needed_cols = ['name_z', 'ndam15', 'max_wind', 'log_damage_ind', 'event_year', 'is_female_name', 'category']\n    df = df.dropna(subset=needed_cols)\n\n    return df\n",
  "m_code": "def model(df: pd.DataFrame) -> Any:\n    # Work on a copy\n    df = df.copy()\n\n    # Prepare predictors (controls + IV). Include category as dummies (drop first to avoid collinearity).\n    predictors = ['name_z', 'max_wind', 'log_damage_ind', 'event_year', 'is_female_name']\n    X = df[predictors].copy()\n\n    # Add categorical dummies for 'category'\n    cat_dummies = pd.get_dummies(df['category'].astype(str), prefix='cat', drop_first=True)\n    if not cat_dummies.empty:\n        X = pd.concat([X, cat_dummies], axis=1)\n\n    # Add intercept\n    X = sm.add_constant(X, has_constant='add')\n\n    # Outcome: count of deaths\n    y = df['ndam15']\n\n    # Fit a Negative Binomial GLM to account for over-dispersion in counts.\n    # If convergence issues arise one can fall back to Poisson with robust SEs.\n    model_nb = sm.GLM(y, X, family=sm.families.NegativeBinomial())\n    results_nb = model_nb.fit()\n\n    # Return the fitted results object (has summary(), params, pvalues, etc.)\n    return results_nb\n"
