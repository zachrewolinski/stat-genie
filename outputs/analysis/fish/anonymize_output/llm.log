0]\n\n    # Cast integer-like columns to integers\n    df['FishCaught'] = df['FishCaught'].round().astype(int)\n    # For binary indicators, ensure 0/1\n    df['LiveBait'] = df['LiveBait'].astype(int).clip(0, 1)\n    df['Camper'] = df['Camper'].astype(int).clip(0, 1)\n\n    df['NumAdults'] = df['NumAdults'].round().astype(int)\n    df['NumChildren'] = df['NumChildren'].round().astype(int)\n\n    # Derived variables\n    df['TotalPeople'] = df['NumAdults'] + df['NumChildren']\n\n    # Descriptive rate (not used directly as DV in model but useful for checks)\n    df['FishPerHour'] = df['FishCaught'] / df['Hours']\n\n    # Optionally cap extremely large FishPerHour values for diagnostics only (no dropping) - commented out\n    # df.loc[df['FishPerHour'] > 200, 'FishPerHour'] = 200\n\n    # Reset index for a clean dataframe\n    df = df.reset_index(drop=True)\n\n    return df\n",
