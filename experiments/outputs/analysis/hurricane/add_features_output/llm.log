  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw hurricane dataframe into analysis-ready dataframe.\n\n    Produces standardized femininity score(s), log outcomes, a severity index, and basic cleaning.\n    \"\"\"\n    # Make a copy to avoid modifying original\n    df = df.copy()\n\n    # Ensure numeric columns are numeric\n    numeric_cols = ['masfem', 'masfem_mturk', 'gender_mf', 'alldeaths', 'ndam15', 'wind', 'min', 'category', 'year', 'elapsedyrs']\n    for c in numeric_cols:\n        if c in df.columns:\n            df[c] = pd.to_numeric(df[c], errors='coerce')\n\n    # Drop rows missing primary IV or primary DVs and key severity controls\n    required = []\n    if 'masfem' in df.columns:\n        required.append('masfem')\n    required += [c for c in ['alldeaths', 'ndam15', 'wind', 'min', 'category'] if c in df.columns]\n    if len(required) > 0:\n        df = df.dropna(subset=required)\n\n    # Create binary female name indicator from gender_mf (if present)\n    if 'gender_mf' in df.columns:\n        df['name_female'] = df['gender_mf'].astype(int)\n\n    # Log-transform outcomes (add 1 to avoid log(0))\n    if 'alldeaths' in df.columns:\n        df['log_alldeaths'] = np.log(df['alldeaths'].fillna(0) + 1)\n    if 'ndam15' in df.columns:\n        df['log_ndam15'] = np.log(df['ndam15'].fillna(0) + 1)\n\n    # Standardize masfem and masfem_mturk (z-scores)\n    if 'masfem' in df.columns:\n        df['z_masfem'] = (df['masfem'] - df['masfem'].mean()) / (df['masfem'].std(ddof=0) if df['masfem'].std(ddof=0) != 0 else 1.0)\n    if 'masfem_mturk' in df.columns:\n        df['z_masfem_mturk'] = (df['masfem_mturk'] - df['masfem_mturk'].mean()) / (df['masfem_mturk'].std(ddof=0) if df['masfem_mturk'].std(ddof=0) != 0 else 1.0)\n\n    # Build a simple severity index combining wind (higher worse), category (higher worse) and pressure (lower worse)\n    # Standardize components first (use population std to match z-score above)\n    for comp in ['wind', 'category', 'min']:\n        if comp in df.columns:\n            df[f'z_{comp}'] = (df[comp] - df[comp].mean()) / (df[comp].std(ddof=0) if df[comp].std(ddof=0) != 0 else 1.0)\n\n    # For pressure (min), lower pressure is more severe, so invert its z-score before combining\n    if all(c in df.columns for c in ['wind', 'category', 'min']):\n        df['severity_raw'] = df['z_wind'] + df['z_category'] + (-1.0 * df['z_min'])\n        df['severity_z'] = (df['severity_raw'] - df['severity_raw'].mean()) / (df['severity_raw'].std(ddof=0) if df['severity_raw'].std(ddof=0) != 0 else 1.0)\n    else:\n        # If insufficient components, try to create severity_z from available standardized components\n        comps = [c for c in ['z_wind', 'z_category', 'z_min'] if c in df.columns]\n        if len(comps) > 0:\n            # invert z_min if present\n            arr = []\n            for c in comps:\n                if c == 'z_min':\n                    arr.append(-1.0 * df[c])\n                else:\n                    arr.append(df[c])\n            df['severity_raw'] = np.sum(arr, axis=0)\n            df['severity_z'] = (df['severity_raw'] - df['severity_raw'].mean()) / (df['severity_raw'].std(ddof=0) if df['severity_raw'].std(ddof=0) != 0 else 1.0)\n\n    # Keep only the columns useful for analysis (but preserve original numeric columns too)\n    keep_cols = []\n    for c in ['ind', 'year', 'name', 'masfem', 'z_masfem', 'masfem_mturk', 'z_masfem_mturk', 'gender_mf', 'name_female', 'alldeaths', 'log_alldeaths', 'ndam15', 'log_ndam15', 'wind', 'category', 'min', 'severity_z', 'elapsedyrs']:\n        if c in df.columns:\n            keep_cols.append(c)\n\n    df = df[keep_cols].reset_index(drop=True)\n\n    return df\n",
  "m_code": "def model(df: pd.DataFrame) -> dict:\n    \"\"\"\n    Fit a set of models testing the association between feminine hurricane names and (proxy) public precaution outcomes.\n\n    Models returned:\n      - OLS on log_alldeaths (robust HC3 SEs)\n      - OLS on log_ndam15 (robust HC3 SEs)\n      - Negative binomial (GLM) on raw alldeaths counts\n\n    Returns a dict with fitted results objects.\n    \"\"\"\n    results = {}\n    # Require that the essential transformed columns exist\n    required = ['z_masfem', 'severity_z', 'wind', 'category', 'min', 'year', 'elapsedyrs']\n    for c in required:\n        if c not in df.columns:\n            raise ValueError(f\"Required column for modeling missing: {c}\")\n\n    # Build common control matrix\n    controls = ['severity_z', 'wind', 'category', 'min', 'year', 'elapsedyrs']\n\n    # Include binary female name as a covariate as well (if present)\n    if 'name_female' in df.columns:\n        controls_with_binary = controls + ['name_female']\n    else:\n        controls_with_binary = controls\n\n    # Prepare design matrix\n    X = df[controls_with_binary].copy()\n    X = sm.add_constant(X)\n\n    # 1) OLS on log_alldeaths\n    if 'log_alldeaths' in df.columns:\n        y = df['log_alldeaths']\n        X1 = X.copy()\n        # Add main independent variable\n        X1['z_masfem'] = df['z_masfem']\n        # Fit OLS with robust (HC3) standard errors\n        ols_deaths = sm.OLS(y, X1).fit(cov_type='HC3')\n        results['ols_log_alldeaths'] = ols_deaths\n\n    # 2) OLS on log_ndam15\n    if 'log_ndam15' in df.columns:\n        y2 = df['log_ndam15']\n        X2 = X.copy()\n        X2['z_masfem'] = df['z_masfem']\n        ols_damage = sm.OLS(y2, X2).fit(cov_type='HC3')\n        results['ols_log_ndam15'] = ols_damage\n\n    # 3) Negative binomial on raw alldeaths (counts)\n    if 'alldeaths' in df.columns:\n        # For count models, ensure non-negative integer counts. If there are non-integers, round.\n        counts = df['alldeaths'].fillna(0).round().astype(int)\n        X3 = X.copy()\n        X3['z_masfem'] = df['z_masfem']\n        # Use GLM Negative Binomial to allow overdispersion\n        try:\n            nb_model = sm.GLM(counts, X3, family=sm.families.NegativeBinomial()).fit()\n            results['nb_alldeaths'] = nb_model\n        except Exception:\n            # fallback to Poisson if NegativeBinomial fails to converge\n            pois_model = sm.GLM(counts, X3, family=sm.families.Poisson()).fit()\n            results['pois_alldeaths'] = pois_model\n\n    # Return the fitted model objects (caller can inspect .summary())\n    return results\n"
}
