ositeScore ~ StudentsPerTeacher_z + controls')\n    print(f'StudentsPerTeacher_z coefficient: {spt_coef:.4f} (SE={spt_se:.4f}), p={spt_p:.4f}')\n    print('\\nFull model summary:')\n    print(results.summary())\n\n    return results\n"
