{
  "cvars": {
    "ivs": [
      {
        "description": "Developmental stage (age) capturing children's age in years. We include raw age and derived centered and quadratic age terms to model linear and nonlinear developmental trends. Also include coarse age groups for descriptive/interaction checks.",
        "columns": [
          "Age",
