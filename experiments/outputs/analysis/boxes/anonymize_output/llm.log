        ]
      },
      {
        "description": "Coarse age group (4-6, 7-9, 10-12, 13-14). Included as a potential moderator to check whether cultural effects differ by broad developmental stage (i.e., tests Culture x AgeGroup interaction if added later).",
        "is_moderator": true,
