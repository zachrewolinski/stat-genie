{
  "cvars": {
    "ivs": [
      {
        "description": "Binary indicator for dark (top tertile) vs light (bottom tertile) skin tone, derived from the mean of two independent raters' skin-tone ratings (rater1 and rater2). This operationalizes the research question contrast (dark vs light). Rows with medium/ambiguous skin tone (middle tertile) are excluded so the comparison is between clear 'Dark' and 'Light' categories.",
        "columns": [
          "DarkSkin"
        ]
      }
    ],
    "dv": {
      "description": "Count of red cards given by a referee to the player across all matches in the player-referee dyad. This is a count outcome modeled with a count regression (negative binomial) with the number of matches as exposure.",
      "columns": [
        "redCards"
      ]
    },
    "controls": [
      {
        "description": "Number of matches between the player and the referee in the dyad; treated as the exposure (offset) in the count model. Kept as a positive numeric column.",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "exposure_games"
        ]
      },
      {
        "description": "Player's historical number of yellow cards received from the same referee in the dyad (used as a proxy for player behavior / referee familiarity). This variable is standardized (z-scored) prior to modeling.",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "playerShort_z"
        ]
      },
      {
        "description": "Country-level implicit bias (mean IAT) for the referee's country. Standardized (z-scored) prior to modeling to aid interpretation.",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "meanIAT_z"
        ]
      },
      {
        "description": "Country-level explicit bias (thermometer) for the referee's country. Standardized (z-scored) prior to modeling.",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "club_z"
        ]
      },
      {
        "description": "Continuous mean skin rating (average of rater1 and rater2, 0-1 normalized). Kept as a control (continuous) in the model in addition to the categorical DarkSkin indicator to account for residual linear variation in rating.",
        "is_moderator": false,
        "moderator_on": null,
        "columns": [
          "rater_mean"
        ]
      }
    ]
