cept',\n        'female',\n        'black',\n        'self_employed',\n        'married',\n        'bad_history',\n        'denied_PMI',\n        'z_housing_expense_ratio',\n        'z_PI_ratio',\n        'z_loan_to_value',\n        'z_mortgage_credit',\n        'z_consumer_credit'\n    ]\n\n    return df[final_cols]\n",
