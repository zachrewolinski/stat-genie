  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw Boston mortgage dataset into an analysis-ready dataframe.\n\n    Steps:\n    - Keep only columns required for the analysis.\n    - Drop rows with missing values on those columns (complete-case analysis).\n    - Ensure binary indicators are integer-typed.\n    - Standardize numeric continuous controls (z-score) and create new columns with suffix '_std'.\n\n    Returns the transformed dataframe containing all columns listed in the conceptual variables.\n    \"\"\"\n    df = df.copy()\n\n    # Columns required for analysis (IV, DV, controls as provided in schema)\n    required_cols = [\n        'accept', 'female', 'black', 'self_employed', 'married', 'bad_history',\n        'mortgage_credit', 'consumer_credit', 'PI_ratio', 'loan_to_value', 'housing_expense_ratio'\n    ]\n\n    # Keep only required columns (will raise KeyError if any are missing)\n    df = df.loc[:, [c for c in required_cols if c in df.columns]]\n\n    # Drop rows missing any required column values (complete-case)\n    df = df.dropna(subset=required_cols)\n\n    # Ensure binary columns are integer-coded 0/1\n    binary_cols = ['accept', 'female', 'black', 'self_employed', 'married', 'bad_history']\n    for col in binary_cols:\n        if col in df.columns:\n            # convert floats like 0.0/1.0 to ints\n            df[col] = df[col].astype(int)\n\n    # Standardize continuous control variables and store as new columns with suffix '_std'\n    cont_cols = ['mortgage_credit', 'consumer_credit', 'PI_ratio', 'loan_to_value', 'housing_expense_ratio']\n    for col in cont_cols:\n        if col in df.columns:\n            # use sample standard deviation (ddof=0 for population-style; ddof=1 would also be acceptable)\n            mu = df[col].mean()\n            sigma = df[col].std(ddof=0)\n            # avoid division by zero\n            if sigma == 0 or np.isnan(sigma):\n                df[col + '_std'] = 0.0\n            else:\n                df[col + '_std'] = (df[col] - mu) / sigma\n\n    # Final columns that will be used in modeling\n    # (keeps original continuous columns as well, but model will use standardized versions)\n    final_cols = [\n        'accept', 'female', 'black', 'self_employed', 'married', 'bad_history',\n        'mortgage_credit_std', 'consumer_credit_std', 'PI_ratio_std', 'loan_to_value_std', 'housing_expense_ratio_std'\n    ]\n\n    # Ensure final_cols exist (some may be missing if original data lacked them) -- keep those present\n    final_present = [c for c in final_cols if c in df.columns]\n    df = df.loc[:, final_present]\n\n    return df\n",
  "m_code": "def model(df: pd.DataFrame) -> dict:\n    \"\"\"\n    Fit a logistic regression predicting the probability of mortgage acceptance (accept=1) from applicant gender (female)\n    while adjusting for a set of controls capturing creditworthiness and demographics.\n\n    Returns a dictionary with the fitted model, a robust (HC3) results wrapper, an estimated average marginal effect for being female,\n    and a small summary with the female coefficient odds ratio and robust 95% CI.\n    \"\"\"\n    df = df.copy()\n\n    # Define model covariates (must match columns created in transform)\n    X_cols = [\n        'female', 'black', 'self_employed', 'married', 'bad_history',\n        'mortgage_credit_std', 'consumer_credit_std', 'PI_ratio_std', 'loan_to_value_std', 'housing_expense_ratio_std'\n    ]\n\n    # Ensure all required covariates exist in df\n    missing = [c for c in X_cols + ['accept'] if c not in df.columns]\n    if len(missing) > 0:\n        raise KeyError(f\"Missing columns required for modeling: {missing}\")\n\n    # Prepare design matrices\n    X = sm.add_constant(df[X_cols], has_constant='add')\n    y = df['accept']\n\n    # Fit logistic regression (maximum likelihood)\n    logit = sm.Logit(y, X)\n    # increase maxiter to ensure convergence if needed\n    res = logit.fit(disp=False, maxiter=200)\n\n    # Compute robust (heteroskedasticity-consistent) covariance results (HC3 recommended for small-sample robustness)\n    robust_res = res.get_robustcov_results(cov_type='HC3')\n\n    # Compute Average Marginal Effect (AME) of female by computing predicted probabilities when female=1 vs female=0\n    X_f1 = X.copy()\n    X_f0 = X.copy()\n    X_f1['female'] = 1\n    X_f0['female'] = 0\n    # Predicted probabilities from MLE estimates\n    pred_f1 = res.predict(X_f1)\n    pred_f0 = res.predict(X_f0)\n    avg_marginal_effect_female = (pred_f1 - pred_f0).mean()\n\n    # Odds ratio and robust 95% CI for the female coefficient\n    coef = robust_res.params['female']\n    se = robust_res.bse['female']\n    # robust confidence interval\n    ci_lower, ci_upper = robust_res.conf_int().loc['female'].tolist()\n    or_point = np.exp(coef)\n    or_ci_lower = np.exp(ci_lower)\n    or_ci_upper = np.exp(ci_upper)\n\n    summary = {\n        'n_obs': int(df.shape[0]),\n        'female_coef_mle': float(res.params['female']),\n        'female_se_robust': float(se),\n        'female_avg_marginal_effect': float(avg_marginal_effect_female),\n        'female_odds_ratio': float(or_point),\n        'female_odds_ratio_robust_CI_95': [float(or_ci_lower), float(or_ci_upper)]\n    }\n\n    # Return both raw fitted objects and a concise summary for downstream inspection\n    results = {\n        'mle_result': res,                 # statsmodels LogitResults (MLE)\n        'robust_result': robust_res,       # statsmodels results with robust cov\n        'avg_marginal_effect_female': avg_marginal_effect_female,\n        'female_odds_ratio': or_point,\n        'female_odds_ratio_robust_CI_95': [or_ci_lower, or_ci_upper],\n        'summary_dict': summary\n    }\n\n    return results\n"
}
