    # Keep only final columns (and drop rows with any remaining NaNs)\n    df_final = df[final_cols].dropna()\n\n    # Ensure dtypes are numeric\n    df_final = df_final.astype({c: float for c in df_final.columns})\n\n    return df_final\n",
