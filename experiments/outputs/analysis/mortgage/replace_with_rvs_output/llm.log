\n    # Compute average marginal effects if supported\n    try:\n        margeff = res.get_margeff(at='overall')\n        marg_df = margeff.summary_frame()\n    except Exception:\n        marg_df = None\n\n    return {\n        'model_results': res,\n        'odds_ratios': odds_ratios,\n        'odds_ratio_conf_int': conf_odds,\n        'marginal_effects': marg_df\n    }\n"
