  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw Fair \"affairs\" dataset into a modeling dataframe.\n\n    Produces these columns (exact names used later in modeling):\n      - AffairsCount : numeric version of the original 'affairs' column (coerced)\n      - HadAffair : binary outcome (1 = any/high affair, 0 = none/low) - heuristic mapping described below\n      - HasChildren : binary indicator of children in the marriage (1=yes, 0=no)\n      - Age : numeric derived from 'rating' (kept as-is numeric if possible)\n      - IsFemale : best-effort binary female indicator (1=female, 0=male); may be NaN if ambiguous\n      - GenderRaw : original gender column preserved (coerced if numeric)\n      - YearsMarried, Religiousness, Education, Occupation, MaritalSatisfaction : numeric covariates\n\n    Notes on HadAffair construction: If the 'affairs' column contains explicit zeros (i.e., some respondents coded 0), then HadAffair = (AffairsCount > 0).\n    If 'affairs' has no explicit zeros (dataset encoding ambiguity), we create a dichotomy at the median: HadAffair = (AffairsCount > median(AffairsCount)). This is a pragmatic fallback to separate higher vs lower reported affair engagement when 0 is not present in the data encoding.\n    \"\"\"\n    df = df.copy()\n\n    # Standard numeric coercions\n    df['AffairsCount'] = pd.to_numeric(df.get('affairs'), errors='coerce')\n\n    # Create binary HadAffair using a robust heuristic depending on whether zeros are present\n    if 'AffairsCount' in df.columns:\n        if df['AffairsCount'].notnull().any():\n            try:\n                min_val = df['AffairsCount'].min()\n                if not np.isnan(min_val) and min_val == 0:\n                    df['HadAffair'] = (df['AffairsCount'] > 0).astype(int)\n                else:\n                    # Fallback: no explicit zero in coding -> split at median to get high vs low engagement\n                    med = df['AffairsCount'].median(skipna=True)\n                    df['HadAffair'] = (df['AffairsCount'] > med).astype(int)\n            except Exception:\n                df['HadAffair'] = pd.NA\n        else:\n            df['HadAffair'] = pd.NA\n    else:\n        df['AffairsCount'] = pd.NA\n        df['HadAffair'] = pd.NA\n\n    # HasChildren: normalize varieties of yes/no coding\n    children = df.get('children')\n    def map_children(x):\n        if pd.isna(x):\n            return pd.NA\n        # numeric -> treat >0 as having children\n        if isinstance(x, (int, float, np.integer, np.floating)):\n            try:\n                return 1 if x > 0 else 0\n            except Exception:\n                return pd.NA\n        # string -> normalize\n        s = str(x).strip().lower()\n        if s in ('yes', 'y', 'true', 't', '1'):\n            return 1\n        if s in ('no', 'n', 'false', 'f', '0'):\n            return 0\n        # fallback: if string contains 'y' or 'n'\n        if 'yes' in s:\n            return 1\n        if 'no' in s:\n            return 0\n        return pd.NA\n\n    df['HasChildren'] = df['children'].apply(map_children)\n\n    # Age: try to use 'rating' (dataset uses a numeric age-code there in many versions)\n    df['Age'] = pd.to_numeric(df.get('rating'), errors='coerce')\n\n    # Years married\n    df['YearsMarried'] = pd.to_numeric(df.get('yearsmarried'), errors='coerce')\n\n    # Religiousness\n    df['Religiousness'] = pd.to_numeric(df.get('religiousness'), errors='coerce')\n\n    # Education and Occupation\n    df['Education'] = pd.to_numeric(df.get('education'), errors='coerce')\n    df['Occupation'] = pd.to_numeric(df.get('occupation'), errors='coerce')\n\n    # Marital satisfaction stored in 'rownames' in the provided schema\n    df['MaritalSatisfaction'] = pd.to_numeric(df.get('rownames'), errors='coerce')\n\n    # Gender: create GenderRaw and best-effort IsFemale\n    df['GenderRaw'] = df.get('gender')\n\n    def map_is_female(g):\n        if pd.isna(g):\n            return pd.NA\n        # strings\n        if isinstance(g, str):\n            s = g.strip().lower()\n            if 'f' in s:\n                return 1\n            if 'm' in s:\n                return 0\n            # treat 'female' and 'male' explicitly\n            if s in ('female', 'woman', 'f'): return 1\n            if s in ('male', 'man', 'm'): return 0\n            return pd.NA\n        # numeric\n        try:\n            gn = float(g)\n        except Exception:\n            return pd.NA\n        # common codings: 1=male, 2=female OR 0=male,1=female OR 0/1 binary\n        unique_vals = set(df['gender'].dropna().astype(float).unique())\n        # If values are subset of {0,1}, assume 1 = female\n        if unique_vals.issubset({0.0, 1.0}):\n            return 1 if gn == 1.0 else 0\n        # If values are subset of {1,2}, assume 2 = female (common in some datasets)\n        if unique_vals.issubset({1.0, 2.0}):\n            return 1 if gn == 2.0 else 0\n        # otherwise ambiguous: leave NA\n        return pd.NA\n\n    df['IsFemale'] = df['GenderRaw'].apply(map_is_female)\n\n    # Keep only columns we will use in modeling (but return full df with these present)\n    # No forced drop here; model function will drop rows with missing values in required model columns.\n\n    # Provide a brief summary column to help debugging downstream (optional)\n    df['_transform_note'] = (\n        'AffairsCount_missing=' + df['AffairsCount'].isna().astype(int).astype(str)\n    )\n\n    return df\n"
  ,
  "m_code": "def model(df: pd.DataFrame) -> dict:\n    \"\"\"\n    Fit statistical models to estimate the association between having children and engagement in extramarital affairs.\n\n    Models produced:\n      1) Logistic regression (binary outcome HadAffair) using statsmodels.Logit\n      2) Poisson regression (count outcome AffairsCount) using statsmodels.GLM with Poisson family\n\n    The function drops rows with missing values in the variables required by each model.\n    Returns a dict with fitted result objects for easy further inspection.\n    \"\"\"\n    results = {}\n\n    # Columns required for the models\n    base_covs = ['Age', 'IsFemale', 'YearsMarried', 'Religiousness', 'Education', 'Occupation', 'MaritalSatisfaction']\n\n    # Prepare dataset for logistic regression on HadAffair\n    model_cols_logit = ['HadAffair', 'HasChildren'] + base_covs\n    df_logit = df[model_cols_logit].copy()\n\n    # Drop rows with missing values in any of these columns\n    df_logit = df_logit.dropna(subset=model_cols_logit)\n\n    if df_logit.shape[0] < 10:\n        raise ValueError('Too few complete cases for logistic model after dropping NA: {}'.format(df_logit.shape[0]))\n\n    y_logit = df_logit['HadAffair'].astype(float)\n    X_logit = df_logit[['HasChildren'] + base_covs].astype(float)\n    X_logit = sm.add_constant(X_logit, has_constant='add')\n\n    # Fit logistic regression (use try/except to catch perfect separation or convergence issues)\n    try:\n        logit_model = sm.Logit(y_logit, X_logit)\n        logit_res = logit_model.fit(disp=False, maxiter=200)\n    except Exception as e:\n        # Retry with small ridge (L2) via adding a tiny constant to diagonal (approximate fallback)\n        # We'll add tiny gaussian noise to break perfect separation if needed\n        X_logit_jitter = X_logit + np.random.normal(scale=1e-8, size=X_logit.shape)\n        logit_model = sm.Logit(y_logit, X_logit_jitter)\n        logit_res = logit_model.fit(disp=False, maxiter=200)\n\n    results['logit_result'] = logit_res\n\n    # Prepare dataset for Poisson regression on AffairsCount (counts)\n    # Use only non-missing AffairsCount and covariates\n    model_cols_pois = ['AffairsCount', 'HasChildren'] + base_covs\n    df_pois = df[model_cols_pois].copy()\n    df_pois = df_pois.dropna(subset=model_cols_pois)\n\n    if df_pois.shape[0] >= 10:\n        y_pois = pd.to_numeric(df_pois['AffairsCount'], errors='coerce')\n        X_pois = df_pois[['HasChildren'] + base_covs].astype(float)\n        X_pois = sm.add_constant(X_pois, has_constant='add')\n\n        # Fit Poisson; if overdispersion is suspected, users can fit NegativeBinomial (not done here by default)\n        try:\n            pois_model = sm.GLM(y_pois, X_pois, family=sm.families.Poisson())\n            pois_res = pois_model.fit()\n            results['poisson_result'] = pois_res\n        except Exception as e:\n            results['poisson_result'] = None\n            results['_poisson_error'] = str(e)\n    else:\n        results['poisson_result'] = None\n        results['_poisson_note'] = 'Too few complete cases for Poisson model: {}'.format(df_pois.shape[0])\n\n    # Return fitted model objects and a short summary dictionary with coefficient of HasChildren\n    # Provide coefficient and p-value for the primary variable of interest when available\n    def extract_coef(res, varname='HasChildren'):\n        if res is None:\n            return None\n        try:\n            coef = float(res.params[varname])\n            pval = float(res.pvalues[varname]) if hasattr(res, 'pvalues') else None\n            se = float(res.bse[varname]) if hasattr(res, 'bse') else None\n            return {'coef': coef, 'se': se, 'pvalue': pval}\n        except Exception:\n            return None\n\n    results['summary'] = {\n        'logit_HasChildren': extract_coef(results.get('logit_result')),\n        'poisson_HasChildren': extract_coef(results.get('poisson_result'))\n    }\n\n    return results\n