  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw Simonsohn et al. hurricane dataset into a dataframe ready for modeling.\n\n    Final returned dataframe contains the following columns (used in models):\n      - StormID, Year, StormName, MasFem, MasFem_MT, FemaleName, Category,\n        Deaths, Damage2015, MaxWind, MinPressure, LogDamage2015, LogDeaths, MasFem_z\n\n    Notes on transformations:\n      - Rename generic feature columns to meaningful names.\n      - Coerce numeric columns to numeric, drop rows missing the primary variables (Deaths or MasFem).\n      - Create log-transformed outcomes/controls for OLS comparisons.\n      - Standardize the MasFem index into MasFem_z for interpretability.\n    \"\"\"\n    df = df.copy()\n\n    # 1) Rename the original feature columns to descriptive final column names\n    rename_map = {\n        'feature1': 'StormID',\n        'feature2': 'Year',\n        'feature3': 'StormName',\n        'feature4': 'MasFem',            # masculinity-femininity index (continuous)\n        'feature5': 'MinPressure',      # minimum central pressure at landfall\n        'feature6': 'FemaleName',       # binary gender indicator: 0 male, 1 female\n        'feature7': 'Category',         # Saffir-Simpson category\n        'feature8': 'Deaths',           # total number of deaths (count)\n        'feature9': 'DamageRaw',        # raw damage (unadjusted)\n        'feature10': 'YearsSince',\n        'feature11': 'Source',\n        'feature12': 'MasFem_MT',       # MTurk replication of masfem index\n        'feature13': 'MaxWind',         # maximum wind speed at landfall\n        'feature14': 'Damage2015'       # damage adjusted to 2015 dollars\n    }\n    df = df.rename(columns=rename_map)\n\n    # 2) Coerce key columns to numeric where appropriate (suppress coercion warnings)\n    numeric_cols = ['MasFem', 'MasFem_MT', 'MinPressure', 'FemaleName', 'Category', 'Deaths', 'Damage2015', 'MaxWind', 'Year']\n    for c in numeric_cols:\n        if c in df.columns:\n            df[c] = pd.to_numeric(df[c], errors='coerce')\n\n    # 3) Drop rows missing primary variables needed for the analysis\n    # Primary variables: MasFem (continuous name femininity) and Deaths (outcome)\n    df = df.dropna(subset=['MasFem', 'Deaths'])\n\n    # 4) Ensure Deaths is integer count (some datasets might have floats)\n    df['Deaths'] = df['Deaths'].astype(int)\n\n    # 5) Create log-transformed death variable for OLS / visualization: log(Deaths + 1)\n    df['LogDeaths'] = np.log(df['Deaths'] + 1)\n\n    # 6) Create a logged damage control (log(Damage2015 + 1)) and coerce non-negative\n    if 'Damage2015' in df.columns:\n        # some damage values may be missing or nonsensical; coerce then fill NA -> 0 when meaningful\n        df['Damage2015'] = pd.to_numeric(df['Damage2015'], errors='coerce')\n        # replace negatives or missing values with 0 for log transform conservatively\n        df['Damage2015'] = df['Damage2015'].fillna(0).clip(lower=0)\n        df['LogDamage2015'] = np.log(df['Damage2015'] + 1)\n    else:\n        df['LogDamage2015'] = 0.0\n\n    # 7) Standardize the MasFem index to a z-score for easier interpretation across models\n    mas_mean = df['MasFem'].mean()\n    mas_std = df['MasFem'].std(ddof=0)\n    if mas_std == 0 or np.isnan(mas_std):\n        df['MasFem_z'] = 0.0\n    else:\n        df['MasFem_z'] = (df['MasFem'] - mas_mean) / mas_std\n\n    # 8) Ensure FemaleName is binary integer 0/1 where possible\n    df['FemaleName'] = df['FemaleName'].fillna(0).astype(int)\n\n    # 9) Final housekeeping: keep only columns needed for the modeling and downstream checks\n    keep_cols = ['StormID', 'Year', 'StormName', 'MasFem', 'MasFem_MT', 'MasFem_z', 'FemaleName', 'Category', 'MaxWind', 'MinPressure', 'Deaths', 'Damage2015', 'LogDamage2015', 'LogDeaths', 'Source']\n    available_keep = [c for c in keep_cols if c in df.columns]\n    df = df[available_keep]\n\n    return df\n",
  "m_code": "def model(df: pd.DataFrame) -> dict:\n    \"\"\"\n    Fit statistical models to estimate whether more feminine hurricane names are associated\n    with fewer fatalities (the proxy for fewer precautionary measures).\n\n    Approach:\n      - Primary models: Negative binomial regression (appropriate for over-dispersed count outcomes)\n        using (a) standardized MasFem index and (b) the FemaleName binary indicator separately.\n      - Secondary model: OLS on log(Deaths + 1) with robust (HC3) standard errors as a comparison.\n\n    Returns a dictionary with fitted model results objects:\n      - 'nb_masfem': Negative binomial model with MasFem_z as focal predictor\n      - 'nb_femalebinary': Negative binomial model with FemaleName as focal predictor\n      - 'ols_logdeath': OLS on log-deaths with HC3 robust SE\n    \"\"\"\n    import statsmodels.formula.api as smf\n\n    df = df.copy()\n\n    # Ensure required columns exist\n    required = ['Deaths', 'MasFem_z', 'FemaleName', 'MaxWind', 'MinPressure', 'Category', 'Year', 'LogDamage2015']\n    missing = [c for c in required if c not in df.columns]\n    if len(missing) > 0:\n        raise ValueError(f\"Dataframe missing required columns for modeling: {missing}\")\n\n    # Define formulae: include the same set of controls in both focal specifications\n    base_controls = 'MaxWind + MinPressure + Category + Year + LogDamage2015'\n\n    formula_nb_masfem = f'Deaths ~ MasFem_z + {base_controls}'\n    formula_nb_female = f'Deaths ~ FemaleName + {base_controls}'\n\n    # 1) Negative binomial model with MasFem_z\n    try:\n        nb_masfem = smf.glm(formula_nb_masfem, data=df, family=sm.families.NegativeBinomial()).fit()\n    except Exception:\n        # Fallback: Poisson with robust covariance if NegativeBinomial fails to converge\n        nb_masfem = smf.glm(formula_nb_masfem, data=df, family=sm.families.Poisson()).fit(cov_type='HC3')\n\n    # 2) Negative binomial model with FemaleName (binary)\n    try:\n        nb_femalebinary = smf.glm(formula_nb_female, data=df, family=sm.families.NegativeBinomial()).fit()\n    except Exception:\n        nb_femalebinary = smf.glm(formula_nb_female, data=df, family=sm.families.Poisson()).fit(cov_type='HC3')\n\n    # 3) OLS on log-deaths for comparison, with robust standard errors (HC3)\n    formula_ols = f'LogDeaths ~ MasFem_z + FemaleName + {base_controls}'\n    ols_logdeath = smf.ols(formula_ols, data=df).fit(cov_type='HC3')\n\n    # Package results: return fitted model result objects so callers can inspect summaries, params, etc.\n    results = {\n        'nb_masfem': nb_masfem,\n        'nb_femalebinary': nb_femalebinary,\n        'ols_logdeath': ols_logdeath\n    }\n\n    return results\n"
