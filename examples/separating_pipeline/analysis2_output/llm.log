safely)\n    numeric_cols = ['MasFem', 'MinPressure', 'FemaleName', 'Category', 'Deaths', 'Damage2015', 'Damage2013', 'MaxWind', 'YearsSince', 'Year']\n    for c in numeric_cols:\n        if c in df.columns:\n            df[c] = pd.to_numeric(df[c], errors='coerce')\n\n    # Drop rows missing the primary variables needed for main analysis\n    required_for_analysis = [col for col in ['Deaths', 'MasFem', 'FemaleName', 'MaxWind', 'MinPressure'] if col in df.columns]\n    df = df.dropna(subset=required_for_analysis)\n\n    # Create the primary IV: Femininity (higher = more feminine). Use MasFem as provided.\n    df['Femininity'] = df['MasFem']\n\n    # Ensure the binary variable is 0/1 integer\n    if 'FemaleName' in df.columns:\n        # some datasets may already have 0/1 floats; force to 0/1 ints\n        df['FemaleName'] = df['FemaleName'].astype(float).round().astype(int)\n\n    # Create standardized (z-scored) versions of continuous controls for numerical stability\n    def zscore(col: pd.Series) -> pd.Series:\n        return (col - col.mean()) / (col.std(ddof=0) if col.std(ddof=0) != 0 else 1.0)\n\n    if 'MaxWind' in df.columns:\n        df['MaxWind_z'] = zscore(df['MaxWind'])\n    if 'MinPressure' in df.columns:\n        df['MinPressure_z'] = zscore(df['MinPressure'])\n    if 'Damage2015' in df.columns:\n        df['Damage2015_z'] = zscore(df['Damage2015'])\n    elif 'Damage2013' in df.columns:\n        # fallback if only Damage2013 is available\n        df['Damage2015_z'] = zscore(df['Damage2013'])\n    if 'YearsSince' in df.columns:\n        df['YearsSince_z'] = zscore(df['YearsSince'])\n\n    # Log transform of deaths for OLS robustness check\n    df['log_Deaths'] = np.log1p(df['Deaths'])\n\n    # Keep only columns required for modeling (and a few extras for diagnostics)\n    keep_cols = [\n        'Name', 'Year', 'Source',\n        'Deaths', 'log_Deaths',\n        'Femininity', 'FemaleName',\n        'MaxWind', 'MaxWind_z', 'MinPressure', 'MinPressure_z',\