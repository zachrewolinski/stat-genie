  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw hurricane dataset into a dataframe with the variables used in modeling.\n\n    Expected original columns (per provided schema):\n      - feature2: Year\n      - feature3: Name (string)\n      - feature4: masfem (continuous masculinity-femininity index)\n      - feature5: Min pressure\n      - feature6: binary name gender (0 male, 1 female)\n      - feature7: Saffir-Simpson category\n      - feature8: Deaths (count)\n      - feature9/feature14: Damage (normalized amounts), we'll use feature14 (2015 normalized)\n      - feature10: Years since (not strictly necessary)\n      - feature11: Source\n      - feature12: MTurk masfem rating\n      - feature13: Max wind\n\n    Returns a dataframe containing the columns named in the conceptual variables.\n    \"\"\"\n    # Work on a copy\n    df = df.copy()\n\n    # Rename features to meaningful column names used by the model\n    rename_map = {\n        'feature2': 'Year',\n        'feature3': 'Name',\n        'feature4': 'MasFem',\n        'feature5': 'MinPressure',\n        'feature6': 'NameFemale',\n        'feature7': 'Category',\n        'feature8': 'Deaths',\n        'feature9': 'DamageRaw',\n        'feature10': 'YearsSince',\n        'feature11': 'Source',\n        'feature12': 'MTurkMasFem',\n        'feature13': 'MaxWind',\n        'feature14': 'Damage2015'\n    }\n    df = df.rename(columns=rename_map)\n\n    # Convert numeric columns to numeric dtype (coerce errors to NaN)\n    numeric_cols = ['MasFem', 'MinPressure', 'NameFemale', 'Category', 'Deaths', 'YearsSince', 'MTurkMasFem', 'MaxWind', 'Damage2015', 'DamageRaw', 'Year']\n    for c in numeric_cols:\n        if c in df.columns:\n            df[c] = pd.to_numeric(df[c], errors='coerce')\n\n    # Clean categorical/string columns\n    if 'Name' in df.columns:\n        df['Name'] = df['Name'].astype('object')\n    if 'Source' in df.columns:\n        df['Source'] = df['Source'].astype('category')\n\n    # Ensure binary NameFemale is 0/1\n    if 'NameFemale' in df.columns:\n        # Coerce non-binary values to NaN, then to int where possible\n        df['NameFemale'] = df['NameFemale'].map({0: 0, 1: 1}).astype('float')\n\n    # Drop observations missing the primary IV or DV\n    df = df.dropna(subset=['MasFem', 'Deaths'])\n\n    # Create log-transformed deaths for OLS robustness\n    df['LogDeaths'] = np.log(df['Deaths'].fillna(0) + 1)\n\n    # Center Year to improve interpretability and numerical stability\n    if 'Year' in df.columns:\n        med_year = df['Year'].median()\n        df['Year_Centered'] = df['Year'] - med_year\n    else:\n        df['Year_Centered'] = 0\n\n    # Convert Category to categorical (Saffir-Simpson category)\n    if 'Category' in df.columns:\n        df['Category'] = pd.Categorical(df['Category']).as_ordered()\n\n    # Ensure Source is categorical\n    if 'Source' in df.columns:\n        df['Source'] = df['Source'].astype('category')\n\n    # If MTurkMasFem exists, coerce numeric\n    if 'MTurkMasFem' in df.columns:\n        df['MTurkMasFem'] = pd.to_numeric(df['MTurkMasFem'], errors='coerce')\n\n    # Fill small missing values for control variables with their column medians when appropriate\n    for c in ['MaxWind', 'MinPressure', 'Damage2015', 'MTurkMasFem']:\n        if c in df.columns:\n            if df[c].isnull().any():\n                df[c] = df[c].fillna(df[c].median())\n\n    # Keep only columns required by the modeling stage (but retain original name and source for traceability)\n    needed = ['MasFem', 'Deaths', 'LogDeaths', 'NameFemale', 'MaxWind', 'MinPressure', 'Category', 'Year_Centered', 'Damage2015', 'MTurkMasFem', 'Source']\n    # Keep columns that exist in df\n    final_cols = [c for c in needed if c in df.columns]\n    df = df[final_cols].reset_index(drop=True)\n\n    return df\n",
  "m_code": "def model(df: pd.DataFrame) -> dict:\n    \"\"\"\n    Fit the primary negative binomial model predicting Deaths from MasFem and controls.\n    Also fit an OLS robustness check on log(Deaths + 1).\n\n    Returns a dictionary with the fitted model results objects.\n    \"\"\"\n    import statsmodels.formula.api as smf\n\n    # Ensure the dataframe contains the expected columns\n    required = ['Deaths', 'MasFem']\n    for c in required:\n        if c not in df.columns:\n            raise ValueError(f\"Required column {c} not found in dataframe\")\n\n    # Formula for models. Use categorical encoding for Category and Source via C(...)\n    base_formula = (\n        'MasFem + MaxWind + MinPressure + C(Category) + Year_Centered + Damage2015 + MTurkMasFem + NameFemale + C(Source)'\n    )\n\n    nb_formula = 'Deaths ~ ' + base_formula\n    ols_formula = 'LogDeaths ~ ' + base_formula\n\n    # Fit negative binomial (GLM with NegativeBinomial family)\n    try:\n        nb_model = smf.glm(nb_formula, data=df, family=sm.families.NegativeBinomial()).fit()\n    except Exception as e:\n        # If negative binomial fails (rare), fall back to Poisson with robust SEs\n        nb_model = smf.glm(nb_formula, data=df, family=sm.families.Poisson()).fit(cov_type='HC3')\n\n    # Fit OLS on log-deaths as robustness check\n    ols_model = smf.ols(ols_formula, data=df).fit()\n\n    # Return both fitted result objects for inspection\n    results = {\n        'negative_binomial': nb_model,\n        'ols_log_deaths': ols_model\n    }\n\n    return results\n"
}
