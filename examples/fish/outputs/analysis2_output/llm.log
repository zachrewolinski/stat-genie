  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw dataset into the modeling dataframe. The function:\n    - Renames columns to meaningful names\n    - Drops rows with missing or invalid essential values (FishCaught, Hours)\n    - Ensures binary variables are integers (0/1)\n    - Creates GroupSize and PropChildren derived columns\n    - Creates FishPerHour as a descriptive column\n\n    Returns a dataframe with at least these columns:\n    ['FishCaught', 'UsedLiveBait', 'HadCamper', 'NumAdults', 'NumChildren', 'Hours', 'GroupSize', 'PropChildren', 'FishPerHour']\n    \"\"\"\n    # Copy to avoid modifying original\n    df = df.copy()\n\n    # Rename raw features to meaningful names\n    rename_map = {\n        'feature1': 'FishCaught',\n        'feature2': 'UsedLiveBait',\n        'feature3': 'HadCamper',\n        'feature4': 'NumAdults',\n        'feature5': 'NumChildren',\n        'feature6': 'Hours'\n    }\n    df = df.rename(columns=rename_map)\n\n    # Keep only rows with non-missing essential fields\n    essential_cols = ['FishCaught', 'UsedLiveBait', 'HadCamper', 'NumAdults', 'NumChildren', 'Hours']\n    df = df.dropna(subset=essential_cols)\n\n    # Ensure numeric types\n    for c in essential_cols:\n        df[c] = pd.to_numeric(df[c], errors='coerce')\n    df = df.dropna(subset=essential_cols)\n\n    # Remove or flag non-positive hours (cannot be exposure)\n    # Remove very small or zero Hours which would break log offset\n    df = df[df['Hours'] > 0]\n\n    # Ensure integer counts where appropriate\n    df['FishCaught'] = df['FishCaught'].astype(float)  # counts may be float in dataset; keep numeric\n    # Ensure binary indicators are 0/1\n    df['UsedLiveBait'] = df['UsedLiveBait'].apply(lambda x: 1 if float(x) != 0 else 0).astype(int)\n    df['HadCamper'] = df['HadCamper'].apply(lambda x: 1 if float(x) != 0 else 0).astype(int)\n\n    # Ensure number of people are non-negative integers\n    df['NumAdults'] = df['NumAdults'].apply(lambda x: int(round(x)) if pd.notnull(x) and x >= 0 else 0)\n    df['NumChildren'] = df['NumChildren'].apply(lambda x: int(round(x)) if pd.notnull(x) and x >= 0 else 0)\n\n    # Derive group size and proportion of children\n    df['GroupSize'] = df['NumAdults'] + df['NumChildren']\n    # Avoid division by zero for groups of size 0 (should be rare) -> set PropChildren = 0 when GroupSize == 0\n    df['PropChildren'] = df.apply(lambda r: (r['NumChildren'] / r['GroupSize']) if r['GroupSize'] > 0 else 0.0, axis=1)\n\n    # Derive fish per hour for descriptive purposes\n    df['FishPerHour'] = df['FishCaught'] / df['Hours']\n\n    # Final column order (keeps all necessary columns for modeling)\n    final_cols = ['FishCaught', 'UsedLiveBait', 'HadCamper', 'NumAdults', 'NumChildren', 'GroupSize', 'PropChildren', 'Hours', 'FishPerHour']\n    for c in final_cols:\n        if c not in df.columns:\n            df[c] = pd.NA\n\n    return df[final_cols]\n",
