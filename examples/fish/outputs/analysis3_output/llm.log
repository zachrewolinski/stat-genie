  "transform_code": "## Transformations and cleaning for fishing dataset\n# Assumes original columns: ['persons','child','livebait','hours','camper','fish_caught']\n# Make a copy to avoid modifying original\ndf = df.copy()\n\n# Coerce expected columns to numeric, coercing bad entries to NaN\ncols_num = ['persons', 'child', 'livebait', 'hours', 'camper', 'fish_caught']\nfor c in cols_num:\n    df[c] = pd.to_numeric(df[c], errors='coerce')\n\n# Remove rows missing the crucial outcome or exposure or group size\n# We need fish_caught (outcome), hours (exposure), and persons (to compute per-person metrics)\ndf = df.dropna(subset=['fish_caught', 'hours', 'persons'])\n\n# Remove implausible/invalid values: hours must be > 0, persons must be > 0\ndf = df[df['hours'] > 0]\ndf = df[df['persons'] > 0]\n\n# Ensure binary indicators are integers 0/1 (if non-binary values exist they were coerced earlier)\n# If values outside {0,1} remain, keep as-is but cast to int where appropriate\nfor bcol in ['livebait', 'child']:\n    # fill NaN with 0 if any remain after previous filters (assume missing -> no)\n    df[bcol] = df[bcol].fillna(0).astype(int)\n\n# Derived rate variables for descriptive analysis and diagnostics\n# fish_per_hour: primary simple rate (fish per hour)\ndf['fish_per_hour'] = df['fish_caught'] / df['hours']\n# fish_per_person_hour: fish per person per hour\ndf['fish_per_person_hour'] = df['fish_caught'] / (df['persons'] * df['hours'])\n\n# Remove any rows that resulted in infinite or NaN derived metrics (e.g., division issues)\ndf = df.replace([np.inf, -np.inf], np.nan)\ndf = df.dropna(subset=['fish_per_hour', 'fish_per_person_hour'])\n\n# Log of hours to use as offset in count-rate GLM\ndf['log_hours'] = np.log(df['hours'])\n\n# Final dataframe contains the original predictors and the derived columns used in modeling\n# Columns expected for modeling: ['fish_caught','hours','log_hours','livebait','camper','persons','child']\n\nreturn df",
  "m_code": "## Statistical model: estimate rate of fish caught per hour using a count model with exposure\n# We model total fish_caught using a Negative Binomial GLM with log(hours) as an offset (exposure).\n# Predictors: livebait, camper, persons, child. This estimates multiplicative effects on the fish-per-hour rate.\n\n# Prepare design matrix\npredictors = ['livebait', 'camper', 'persons', 'child']\nX = df[predictors].astype(float)\nX = sm.add_constant(X)\n\ny = df['fish_caught'].astype(float)\noffset = df['log_hours']  # log(exposure hours)\n\n# Fit Negative Binomial GLM to account for overdispersion typical of catch data\nmodel = sm.GLM(y, X, family=sm.families.NegativeBinomial(), offset=offset).fit()\n\n# For interpretation, compute incident-rate-ratios (IRRs) and 95% CI by exponentiating coefficients\nparams = model.params\nconf = model.conf_int()\nirrs = np.exp(params)\nirrs_ci = np.exp(conf)\n\n# Pack results to return: model object, textual summary, IRRs and CIs (as dictionaries)\nresults = {\n    'model': model,\n    'summary': model.summary().as_text(),\n    'irrs': irrs.to_dict(),\n    'irrs_ci': {k: (float(irrs_ci.loc[k, 0]), float(irrs_ci.loc[k, 1])) for k in irrs_ci.index}\n}\n\nreturn results"
