e',\n              'ComputersPerStudent', 'Enrollment', 'County', 'GradeSpan']\n    # Ensure all needed columns exist in the returned dataframe; if not, create with NaN so missingness is explicit\n    for col in needed:\n        if col not in df.columns:\n            df[col] = np.nan\n\n    return df\n",
