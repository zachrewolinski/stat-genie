  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw dataset into a dataframe suitable for modeling.\n    Produces the following columns used in the model:\n      - StudentTeacherRatio_clipped: Enrollment / NumTeachers, clipped to reduce extreme outliers\n      - AvgScore: mean of ReadingScore and MathScore\n      - NumComputers, ExpenditurePerStudent, DistrictIncomeK, PercEnglishLearners,\n        PercReducedLunch, PercCalWorks, County, GradeSpan, Enrollment, NumTeachers\n    \"\"\"\n    df = df.copy()\n\n    # Rename original feature columns to meaningful names used below\n    rename_map = {\n        'feature6': 'Enrollment',\n        'feature7': 'NumTeachers',\n        'feature10': 'NumComputers',\n        'feature11': 'ExpenditurePerStudent',\n        'feature12': 'DistrictIncomeK',\n        'feature13': 'PercEnglishLearners',\n        'feature9': 'PercReducedLunch',\n        'feature8': 'PercCalWorks',\n        'feature14': 'ReadingScore',\n        'feature15': 'MathScore',\n        'feature4': 'County',\n        'feature5': 'GradeSpan'\n    }\n    df = df.rename(columns=rename_map)\n\n    # Ensure numeric columns are numeric (coerce non-numeric to NaN)\n    numeric_cols = ['Enrollment', 'NumTeachers', 'NumComputers', 'ExpenditurePerStudent',\n                    'DistrictIncomeK', 'PercEnglishLearners', 'PercReducedLunch',\n                    'PercCalWorks', 'ReadingScore', 'MathScore']\n    for c in numeric_cols:\n        if c in df.columns:\n            df[c] = pd.to_numeric(df[c], errors='coerce')\n\n    # Compute student-teacher ratio; guard against division by zero\n    df['StudentTeacherRatio'] = df['Enrollment'] / df['NumTeachers']\n\n    # Compute average score from reading and math\n    if 'ReadingScore' in df.columns and 'MathScore' in df.columns:\n        df['AvgScore'] = df[['ReadingScore', 'MathScore']].mean(axis=1)\n    else:\n        # If one of the scores is missing entirely, create AvgScore as NaN to be dropped later\n        df['AvgScore'] = np.nan\n\n    # Replace infinite values and drop rows missing the core variables\n    df = df.replace([np.inf, -np.inf], np.nan)\n    df = df.dropna(subset=['StudentTeacherRatio', 'AvgScore'])\n\n    # Clip extreme StudentTeacherRatio values at 1st and 99th percentiles to reduce influence of outliers\n    lower = df['StudentTeacherRatio'].quantile(0.01)\n    upper = df['StudentTeacherRatio'].quantile(0.99)\n    # If there are not enough non-NA values quantiles might be NaN; guard against that\n    if pd.isna(lower) or pd.isna(upper):\n        df['StudentTeacherRatio_clipped'] = df['StudentTeacherRatio']\n    else:\n        df['StudentTeacherRatio_clipped'] = df['StudentTeacherRatio'].clip(lower, upper)\n\n    # Fill missing control variables with median (simple imputation)\n    control_cols = ['NumComputers', 'ExpenditurePerStudent', 'DistrictIncomeK',\n                    'PercEnglishLearners', 'PercReducedLunch', 'PercCalWorks']\n    for c in control_cols:\n        if c in df.columns:\n            median_val = df[c].median()\n            # If median is NaN (all values missing), leave as NaN\n            if not pd.isna(median_val):\n                df[c] = df[c].fillna(median_val)\n\n    # Ensure categorical controls are present (if missing, create as NA)\n    if 'GradeSpan' not in df.columns:\n        df['GradeSpan'] = np.nan\n    if 'County' not in df.columns:\n        df['County'] = np.nan\n\n    # Keep only the final columns needed for modeling\n    final_cols = [\n        'StudentTeacherRatio_clipped', 'AvgScore',\n        'NumComputers', 'ExpenditurePerStudent', 'DistrictIncomeK',\n        'PercEnglishLearners', 'PercReducedLunch', 'PercCalWorks',\n        'County', 'GradeSpan', 'Enrollment', 'NumTeachers'\n    ]\n\n    # Return a dataframe containing the final columns (if some final columns are absent, include those that exist)\n    existing_final_cols = [c for c in final_cols if c in df.columns]\n    return df[existing_final_cols]\n",
  "m_code": "def model(df: pd.DataFrame):\n    \"\"\"\n    Fit an OLS regression to estimate the association between student-teacher ratio and average academic performance.\n    Model specification:\n      AvgScore ~ StudentTeacherRatio_clipped + controls + categorical GradeSpan + categorical County\n\n    Uses heteroskedasticity-robust (HC3) standard errors.\n    Returns the fitted regression results object.\n    \"\"\"\n    import statsmodels.formula.api as smf\n\n    # Confirm required columns exist\n    required = ['AvgScore', 'StudentTeacherRatio_clipped']\n    for col in required:\n        if col not in df.columns:\n            raise ValueError(f\"Required column '{col}' not found in dataframe passed to model().\")\n\n    # Build formula with controls and categorical variables if present\n    cat_terms = []\n    if 'GradeSpan' in df.columns:\n        cat_terms.append('C(GradeSpan)')\n    if 'County' in df.columns:\n        cat_terms.append('C(County)')\n\n    controls = []\n    for c in ['NumComputers', 'ExpenditurePerStudent', 'DistrictIncomeK',\n              'PercEnglishLearners', 'PercReducedLunch', 'PercCalWorks']:\n        if c in df.columns:\n            controls.append(c)\n\n    rhs_terms = ['StudentTeacherRatio_clipped'] + controls + cat_terms\n    formula = 'AvgScore ~ ' + ' + '.join(rhs_terms)\n\n    # Fit OLS with robust (HC3) standard errors\n    model = smf.ols(formula=formula, data=df)\n    results = model.fit(cov_type='HC3')\n\n    # Return the full results object (caller can inspect params, summary(), etc.)\n    return results\n"
