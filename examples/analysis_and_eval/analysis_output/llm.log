ry_{c}' for c in [2,3,4,5]]]\n    df = pd.concat([df, cats], axis=1)\n\n    # Final columns we will use in modeling (keep original alldeaths too)\n    # Return the transformed dataframe (with all original columns plus newly created ones)\n    return df\n",
