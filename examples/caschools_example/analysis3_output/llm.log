  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw district-level dataframe into a modeling-ready dataframe.\n\n    Steps:\n    - Coerce relevant columns to numeric where appropriate.\n    - Drop rows with missing or invalid enrollment / teacher / score data.\n    - Compute StudentTeacherRatio = total enrollment ('calworks') / number of teachers ('teachers').\n    - Compute AvgTestScore as the mean of the two available test-score columns ('grades' and 'rownames').\n    - Drop rows missing any variables used in the model.\n    - Return the dataframe with newly created columns used in modeling: 'StudentTeacherRatio' and 'AvgTestScore'.\n    \"\"\"\n    # Work on a copy\n    df = df.copy()\n\n    # Coerce columns to numeric where possible (these names come from provided schema)\n    numeric_cols = ['calworks', 'teachers', 'grades', 'rownames', 'expenditure', 'math', 'district', 'english']\n    for col in numeric_cols:\n        if col in df.columns:\n            df[col] = pd.to_numeric(df[col], errors='coerce')\n\n    # Ensure 'school' exists (categorical control)\n    if 'school' in df.columns:\n        # keep as-is; convert to string category\n        df['school'] = df['school'].astype('category')\n    else:\n        # create a placeholder single-category if missing to avoid later errors\n        df['school'] = 'unknown'\n        df['school'] = df['school'].astype('category')\n\n    # Drop rows missing enrollment, teachers, or test scores used to compute outcome or IV\n    required_for_ratio_and_score = ['calworks', 'teachers', 'grades', 'rownames']\n    required_existing = [c for c in required_for_ratio_and_score if c in df.columns]\n    df = df.dropna(subset=required_existing)\n\n    # Remove implausible / invalid teacher counts (zero or negative)\n    if 'teachers' in df.columns:\n        df = df[df['teachers'] > 0]\n\n    # Compute student-teacher ratio\n    df['StudentTeacherRatio'] = df['calworks'] / df['teachers']\n\n    # Compute the average test score using the two provided score columns\n    df['AvgTestScore'] = df[['grades', 'rownames']].mean(axis=1)\n\n    # Keep rows that have all model columns (IV, DV, and controls)\n    model_columns = ['StudentTeacherRatio', 'AvgTestScore', 'expenditure', 'math', 'district', 'english', 'school']\n    # Only require those model columns that actually exist in the dataframe (robustness)\n    model_columns_present = [c for c in model_columns if c in df.columns]\n    df = df.dropna(subset=model_columns_present)\n\n    # Optional: reset index for a clean output\n    df = df.reset_index(drop=True)\n\n    return df\n",
  "m_code": "def model(df: pd.DataFrame) -> any:\n    \"\"\"\n    Fit an OLS regression predicting AvgTestScore from StudentTeacherRatio and controls.\n\n    Model specification:\n    AvgTestScore ~ StudentTeacherRatio + expenditure + math + district + english + categorical school fixed effects\n\n    Returns the fitted statsmodels regression results object.\n    \"\"\"\n    # Work on a copy\n    df = df.copy()\n\n    # Ensure required columns present\n    required = ['StudentTeacherRatio', 'AvgTestScore']\n    for c in required:\n        if c not in df.columns:\n            raise ValueError(f\"Required column '{c}' not found in dataframe\")\n\n    # Predictor matrix X\n    predictors = ['StudentTeacherRatio']\n    controls = [c for c in ['expenditure', 'math', 'district', 'english'] if c in df.columns]\n    predictors += controls\n\n    X = df[predictors].copy()\n\n    # Add school dummies (categorical fixed effects) if school column exists\n    if 'school' in df.columns:\n        school_dummies = pd.get_dummies(df['school'], prefix='school', drop_first=True, dtype=float)\n        if not school_dummies.empty:\n            X = pd.concat([X, school_dummies], axis=1)\n\n    # Add constant\n    X = sm.add_constant(X, has_constant='add')\n\n    # Outcome\n    y = df['AvgTestScore']\n\n    # Fit OLS\n    results = sm.OLS(y, X).fit()\n\n    return results\n"
