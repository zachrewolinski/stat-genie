  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw district-level dataframe to the modeling dataframe.\n\n    Produces the following new/derived columns used in modeling:\n      - StudentTeacherRatio: calworks / teachers (enrollment per teacher)\n      - AvgTestScore: mean of 'grades' and 'rownames' (reading & math average)\n      - *_z: z-score standardized versions of continuous predictors used in the model\n      - school_*: dummy(s) for the 'school' category with non-alphanumeric characters replaced by '_'\n\n    Notes about column mapping (based on the provided schema):\n      - 'calworks' is used as total enrollment\n      - 'teachers' is used as number of FTE teachers\n      - 'grades' and 'rownames' are used as district average reading and math scores\n    \"\"\"\n\n    # Work on a copy\n    df = df.copy()\n\n    # Ensure numeric columns are numeric where expected\n    numeric_cols = ['calworks', 'teachers', 'grades', 'rownames', 'expenditure', 'income', 'district', 'computer']\n    for col in numeric_cols:\n        if col in df.columns:\n            df[col] = pd.to_numeric(df[col], errors='coerce')\n\n    # Drop rows missing the key variables needed to compute ratio and outcome\n    required = ['calworks', 'teachers', 'grades', 'rownames']\n    df = df.dropna(subset=[c for c in required if c in df.columns])\n\n    # Remove implausible teacher counts (<=0) to avoid division by zero\n    if 'teachers' in df.columns:\n        df = df[df['teachers'] > 0]\n\n    # Compute student-teacher ratio\n    df['StudentTeacherRatio'] = df['calworks'] / df['teachers']\n\n    # Compute average test score as mean of reading and math\n    df['AvgTestScore'] = df[['grades', 'rownames']].mean(axis=1)\n\n    # Standardize continuous predictors (z-scores). Use ddof=0 for population-like standardization.\n    def zscore(s: pd.Series) -> pd.Series:\n        return (s - s.mean()) / (s.std(ddof=0) if s.std(ddof=0) != 0 else 1.0)\n\n    # Create z-scores for IV and continuous controls that will be used in the model\n    df['StudentTeacherRatio_z'] = zscore(df['StudentTeacherRatio'])\n\n    # Controls: expenditure, income, district, computer\n    for c in ['expenditure', 'income', 'district', 'computer']:\n        if c in df.columns:\n            df[c + '_z'] = zscore(df[c])\n        else:\n            # if a control is missing, create a NaN column so downstream code fails noisily rather than silently\n            df[c + '_z'] = np.nan\n\n    # Clean up school category strings to produce safe dummy column names\n    if 'school' in df.columns:\n        df['school'] = df['school'].astype(str).fillna('NA').str.replace('[^0-9A-Za-z_]+', '_', regex=True)\n        school_dummies = pd.get_dummies(df['school'], prefix='school', drop_first=True)\n        df = pd.concat([df, school_dummies], axis=1)\n    else:\n        # If school not present, create a placeholder column to keep model pipeline stable\n        df['school'] = 'NA'\n\n    # Final: keep only rows with non-missing values in model columns\n    model_cols_needed = ['StudentTeacherRatio_z', 'AvgTestScore', 'expenditure_z', 'income_z', 'district_z', 'computer_z']\n    # also add any school dummy columns that were created\n    school_dummy_cols = [c for c in df.columns if c.startswith('school_')]\n    model_cols_needed += school_dummy_cols\n\n    df = df.dropna(subset=[c for c in model_cols_needed if c in df.columns])\n\n    # Return the dataframe containing all columns (original + derived). The modeling function will select needed columns.\n    return df\n",
  "m_code": "def model(df: pd.DataFrame) -> Any:\n    \"\"\"\n    Fit an OLS model predicting AvgTestScore from StudentTeacherRatio (z-scored) controlling for expenditure, income,\n    percent English learners (district), computer resources, and school grade-span dummy(s).\n\n    Returns a fitted statsmodels regression results object (with robust HC3 standard errors).\n    \"\"\"\n\n    # Copy to avoid side-effects\n    df = df.copy()\n\n    # Identify school dummy columns created in transform\n    school_dummy_cols = [c for c in df.columns if c.startswith('school_')]\n\n    # Define predictors to include in the model\n    predictor_cols = ['StudentTeacherRatio_z', 'expenditure_z', 'income_z', 'district_z', 'computer_z'] + school_dummy_cols\n\n    # Ensure all predictors exist in df\n    missing = [c for c in predictor_cols if c not in df.columns]\n    if missing:\n        raise ValueError(f\"Missing predictors in dataframe required for model: {missing}\")\n\n    # Outcome and design matrix\n    y = df['AvgTestScore']\n    X = df[predictor_cols]\n    X = sm.add_constant(X)\n\n    # Fit OLS with robust (HC3) standard errors\n    model_fit = sm.OLS(y, X).fit(cov_type='HC3')\n\n    # Return fitted results object\n    return model_fit\n"
