  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw dataset into a dataframe suitable for modeling.\n\n    Produces the derived columns used in the model:\n    - Enrollment (feature6)\n    - NumTeachers (feature7)\n    - NumComputers (feature10)\n    - ExpenditurePerStudent (feature11)\n    - DistrictIncomeK (feature12)\n    - PctEnglishLearners (feature13)\n    - AvgReading (feature14)\n    - AvgMath (feature15)\n    - PctReducedLunch (feature9)\n    - StudentTeacherRatio = Enrollment / NumTeachers\n    - AvgScore = mean(AvgReading, AvgMath)\n    - ComputersPerStudent = NumComputers / Enrollment\n\n    Also drops rows with missing values in key variables and clips extreme StudentTeacherRatio values at the 1st/99th percentiles to limit the effect of outliers.\n    \"\"\"\n    df = df.copy()\n\n    # Map original features to clearer column names\n    df['Enrollment'] = df.get('feature6')\n    df['NumTeachers'] = df.get('feature7')\n    df['NumComputers'] = df.get('feature10')\n    df['ExpenditurePerStudent'] = df.get('feature11')\n    df['DistrictIncomeK'] = df.get('feature12')\n    df['PctEnglishLearners'] = df.get('feature13')\n    df['AvgReading'] = df.get('feature14')\n    df['AvgMath'] = df.get('feature15')\n    df['PctReducedLunch'] = df.get('feature9')\n\n    # Ensure numeric types where possible\n    num_cols = ['Enrollment', 'NumTeachers', 'NumComputers', 'ExpenditurePerStudent', 'DistrictIncomeK', 'PctEnglishLearners', 'AvgReading', 'AvgMath', 'PctReducedLunch']\n    for c in num_cols:\n        if c in df.columns:\n            df[c] = pd.to_numeric(df[c], errors='coerce')\n\n    # Replace zeros in denominator columns with NaN to avoid division by zero\n    df['NumTeachers'] = df['NumTeachers'].replace({0: np.nan})\n    df['Enrollment'] = df['Enrollment'].replace({0: np.nan})\n\n    # Derived variables\n    df['StudentTeacherRatio'] = df['Enrollment'] / df['NumTeachers']\n    df['AvgScore'] = df[['AvgReading', 'AvgMath']].mean(axis=1)\n    df['ComputersPerStudent'] = df['NumComputers'] / df['Enrollment']\n\n    # Drop rows missing any of the variables required for the model\n    required = ['StudentTeacherRatio', 'AvgScore', 'ExpenditurePerStudent', 'PctReducedLunch', 'PctEnglishLearners', 'DistrictIncomeK', 'ComputersPerStudent']\n    df = df.dropna(subset=required)\n\n    # Winsorize/clip extreme StudentTeacherRatio values at 1st and 99th percentiles to reduce influence of outliers\n    lower = df['StudentTeacherRatio'].quantile(0.01)\n    upper = df['StudentTeacherRatio'].quantile(0.99)\n    df['StudentTeacherRatio'] = df['StudentTeacherRatio'].clip(lower, upper)\n\n    # (Optional) Keep original features as well; return the dataframe with the new columns used by the model\n    return df\n",
  "m_code": "def model(df: pd.DataFrame) -> sm.regression.linear_model.RegressionResultsWrapper:\n    \"\"\"\n    Fit an OLS regression of AvgScore on StudentTeacherRatio controlling for relevant covariates.\n\n    Model specification:\n      AvgScore ~ StudentTeacherRatio + ExpenditurePerStudent + PctReducedLunch + PctEnglishLearners + DistrictIncomeK + ComputersPerStudent\n\n    Uses heteroskedasticity-robust (HC3) standard errors.\n\n    Returns the fitted statsmodels regression results object.\n    \"\"\"\n    df = df.copy()\n\n    # Ensure required columns exist and drop missing\n    model_cols = [\n        'AvgScore',\n        'StudentTeacherRatio',\n        'ExpenditurePerStudent',\n        'PctReducedLunch',\n        'PctEnglishLearners',\n        'DistrictIncomeK',\n        'ComputersPerStudent'\n    ]\n    missing = [c for c in model_cols if c not in df.columns]\n    if missing:\n        raise ValueError(f\"Missing required columns for modeling: {missing}\")\n\n    df_model = df.dropna(subset=model_cols)\n\n    y = df_model['AvgScore']\n    X = df_model[['StudentTeacherRatio', 'ExpenditurePerStudent', 'PctReducedLunch', 'PctEnglishLearners', 'DistrictIncomeK', 'ComputersPerStudent']]\n    X = sm.add_constant(X)\n\n    # Fit OLS with robust standard errors\n    results = sm.OLS(y, X).fit(cov_type='HC3')\n\n    # Return the fitted model object; caller can inspect .summary(), .params, .bse, etc.\n    return results\n"
