  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw dataset into the dataframe used for modeling.\n    Expected original columns: feature1 (choice), feature2 (gender), feature3 (age),\n    feature4 (majority-first flag), feature5 (site id).\n\n    Produces columns used in the model: MajorityChoice, Age, Age_c, Female, MajorityFirst, Site.\n    \"\"\"\n    df = df.copy()\n\n    # Rename raw columns to descriptive names\n    df = df.rename(columns={\n        'feature1': 'Choice',        # 1 = unchosen option, 2 = majority option, 3 = minority option\n        'feature2': 'Gender',        # 1 = girl, 2 = boy\n        'feature3': 'Age',           # age in years\n        'feature4': 'MajorityFirst', # whether majority was demonstrated first (0/1)\n        'feature5': 'Site'           # site id (integer)\n    })\n\n    # Drop rows with missing essential values\n    df = df.dropna(subset=['Choice', 'Gender', 'Age', 'MajorityFirst', 'Site'])\n\n    # Dependent variable: did child choose the majority-demonstrated option?\n    df['MajorityChoice'] = (df['Choice'] == 2).astype(int)\n\n    # Control: Female indicator (1 if girl, 0 if boy)\n    df['Female'] = (df['Gender'] == 1).astype(int)\n\n    # Ensure MajorityFirst is binary integer\n    df['MajorityFirst'] = df['MajorityFirst'].astype(int)\n\n    # Site as categorical variable (keep original ids but convert dtype)\n    df['Site'] = df['Site'].astype('category')\n\n    # Center age for interpretability (used in interactions)\n    df['Age_c'] = df['Age'] - df['Age'].mean()\n\n    # Keep columns necessary for modeling (plus some originals for traceability)\n    df = df[['MajorityChoice', 'Age', 'Age_c', 'Female', 'MajorityFirst', 'Site', 'Choice', 'Gender']]\n\n    return df\n",
  "m_code": "def model(df: pd.DataFrame) -> any:\n    \"\"\"\n    Fit a logistic (binomial) regression to model the probability of choosing the majority option.\n\n    Model specification:\n      MajorityChoice ~ Age_c * C(Site) + Female + MajorityFirst\n\n    This specification includes:\n      - main effect of age (centered)\n      - main effects of Site (categorical fixed effects)\n      - interactions Age_c:C(Site) to allow developmental slopes to vary by site\n      - controls for child's sex and demonstration order\n\n    We fit a binomial GLM and return results with cluster-robust standard errors clustered by Site.\n    \"\"\"\n    import statsmodels.api as sm\n    import statsmodels.formula.api as smf\n\n    # Ensure Site is categorical for the formula interface\n    df = df.copy()\n    df['Site'] = df['Site'].astype('category')\n\n    formula = 'MajorityChoice ~ Age_c * C(Site) + Female + MajorityFirst'\n\n    # Fit binomial GLM\n    glm_mod = smf.glm(formula=formula, data=df, family=sm.families.Binomial())\n    glm_res = glm_mod.fit()\n\n    # Obtain cluster-robust standard errors clustered by site id\n    # If clustering fails for any reason, fall back to the original fit\n    try:\n        results = glm_res.get_robustcov_results(cov_type='cluster', groups=df['Site'])\n    except Exception:\n        # fallback (no clustered SE)\n        results = glm_res\n\n    # Print summary for quick inspection (caller can use returned object programmatically)\n    print(results.summary())\n\n    return results\n"
