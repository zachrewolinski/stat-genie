  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw dataset into a modeling-ready dataframe. The final dataframe contains the columns:\n      - Choice (original outcome)\n      - Age (raw age in years)\n      - Age_c (mean-centered age)\n      - Site (categorical site identifier)\n      - MajorityChoice (DV: 1 if child chose majority option, 0 otherwise)\n      - IsBoy (control: 1 if boy, 0 if girl)\n      - MajorityFirst (control: 0/1 whether majority was demonstrated first)\n\n    Original column mapping:\n      feature1 -> Choice (1=unchosen, 2=majority, 3=minority)\n      feature2 -> Gender (1=girl, 2=boy)\n      feature3 -> Age (years)\n      feature4 -> MajorityFirst (0/1)\n      feature5 -> Site (1..8)\n    \"\"\"\n    # Work on a copy to avoid side-effects\n    df = df.copy()\n\n    # Rename raw features to clear names\n    rename_map = {\n        'feature1': 'Choice',\n        'feature2': 'Gender',\n        'feature3': 'Age',\n        'feature4': 'MajorityFirst',\n        'feature5': 'Site'\n    }\n    df = df.rename(columns=rename_map)\n\n    # Drop rows with missing values in essential columns\n    df = df.dropna(subset=['Choice', 'Gender', 'Age', 'MajorityFirst', 'Site'])\n\n    # Ensure proper dtypes\n    df['Choice'] = df['Choice'].astype(int)\n    # Age may be integer already but ensure numeric\n    df['Age'] = pd.to_numeric(df['Age'], errors='coerce')\n    df = df.dropna(subset=['Age'])\n    df['Age'] = df['Age'].astype(float)\n\n    df['Gender'] = df['Gender'].astype(int)\n    df['MajorityFirst'] = df['MajorityFirst'].astype(int)\n    # Site might be encoded 1..8; keep as category for modeling\n    df['Site'] = df['Site'].astype(int).astype('category')\n\n    # Create binary dependent variable: MajorityChoice (1 if majority option chosen)\n    df['MajorityChoice'] = (df['Choice'] == 2).astype(int)\n\n    # Create gender binary: IsBoy (1 = boy, 0 = girl)\n    df['IsBoy'] = df['Gender'].apply(lambda x: 1 if x == 2 else 0)\n\n    # Mean-center age for better interpretability and numerical stability\n    df['Age_c'] = df['Age'] - df['Age'].mean()\n\n    # Optional: If needed later, create a quadratic age term to capture nonlinearity\n    # df['Age_c2'] = df['Age_c'] ** 2\n\n    # Keep only columns needed for modeling (but return full df with these available)\n    # Return df with all original plus the new columns so downstream code can inspect anything needed\n    return df\n",
  "m_code": "def model(df: pd.DataFrame) -> any:\n    \"\"\"\n    Fit a logistic regression (binomial GLM) predicting the probability of choosing the majority option.\n    The model tests the main effect of Age and whether the Age effect differs across Sites (Age × Site interaction).\n    Controls: IsBoy and MajorityFirst.\n\n    Formula used:\n      MajorityChoice ~ Age_c * C(Site) + IsBoy + MajorityFirst\n\n    Returns the fitted GLM results object (statsmodels) so users can examine coefficients, standard errors,\n    and compute predicted probabilities or marginal effects.\n    \"\"\"\n    import statsmodels.api as sm\n    import statsmodels.formula.api as smf\n\n    # Ensure required columns exist\n    required_cols = ['MajorityChoice', 'Age_c', 'Site', 'IsBoy', 'MajorityFirst']\n    missing = [c for c in required_cols if c not in df.columns]\n    if missing:\n        raise ValueError(f\"Missing required columns for modeling: {missing}\")\n\n    # Define formula: Age main effect and Age x Site interaction, site treated as categorical\n    formula = 'MajorityChoice ~ Age_c * C(Site) + IsBoy + MajorityFirst'\n\n    # Fit binomial GLM (logistic regression)\n    results = smf.glm(formula=formula, data=df, family=sm.families.Binomial()).fit()\n\n    # For convenience, also compute and attach simple marginal effects of Age at the reference site\n    try:\n        marg_eff = results.get_margeff(at='overall', method='dydx', dummy=True)\n        results._marginal_effects = marg_eff\n    except Exception:\n        # If marginal effects computation fails for any reason, continue without attaching\n        results._marginal_effects = None\n\n    return results\n"
}
