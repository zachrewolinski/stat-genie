  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw hurricane dataset into a modeling-ready dataframe.\n    Produces the following key columns used in the model:\n      - FemininityScore: continuous name femininity score (from 'name')\n      - FemaleName: binary name-gender indicator (from 'elapsedyrs', 0=male,1=female)\n      - Deaths: total deaths caused by the hurricane (from 'ndam15')\n      - logDeaths: log(Deaths + 1)\n      - Wind: wind speed at landfall (from 'wind')\n      - MinPressure: minimum pressure at landfall (from 'min')\n      - SaffirCategory: numeric severity category (from 'masfem')\n      - PropertyDamage: normalized property damage (from 'ind')\n      - logPropertyDamage: log(PropertyDamage + 1)\n      - Year: year of the storm (from 'alldeaths')\n      - StormName: original hurricane name string (from 'ndam')\n    \"\"\"\n\n    # Work on a copy\n    df = df.copy()\n\n    # Standardize/rename columns we will use so downstream names are exact\n    # Note: use the columns as they exist in the provided schema\n    # 'name' is the continuous masculinity-femininity rating (higher = more feminine)\n    # 'elapsedyrs' is a binary gender indicator (0 male, 1 female)\n    # 'ndam15' is total deaths\n    # 'wind' wind speed\n    # 'min' minimum pressure\n    # 'masfem' category (Saffir-style numeric)\n    # 'ind' property damage (normalized)\n    # 'alldeaths' contains the year according to the provided schema\n\n    # Coerce numeric columns and handle non-numeric entries\n    numeric_cols = ['name', 'elapsedyrs', 'ndam15', 'wind', 'min', 'masfem', 'ind', 'alldeaths']\n    for col in numeric_cols:\n        if col in df.columns:\n            df[col] = pd.to_numeric(df[col], errors='coerce')\n\n    # Keep storm name string if present\n    if 'ndam' in df.columns:\n        df['StormName'] = df['ndam'].astype(str)\n    else:\n        df['StormName'] = pd.NA\n\n    # Rename to analysis-friendly exact column names (these are required by the model code)\n    # Femininity score (continuous)\n    if 'name' in df.columns:\n        df['FemininityScore'] = df['name']\n    else:\n        df['FemininityScore'] = pd.NA\n\n    # Binary female-coded name indicator\n    if 'elapsedyrs' in df.columns:\n        # Ensure binary 0/1\n        df['FemaleName'] = df['elapsedyrs'].apply(lambda x: 1 if x == 1 else (0 if x == 0 else pd.NA))\n    else:\n        df['FemaleName'] = pd.NA\n\n    # Dependent variable: death counts\n    if 'ndam15' in df.columns:\n        df['Deaths'] = df['ndam15'].astype(float)\n    else:\n        df['Deaths'] = pd.NA\n\n    # Controls\n    df['Wind'] = df['wind'] if 'wind' in df.columns else pd.NA\n    df['MinPressure'] = df['min'] if 'min' in df.columns else pd.NA\n    df['SaffirCategory'] = df['masfem'] if 'masfem' in df.columns else pd.NA\n    df['PropertyDamage'] = df['ind'] if 'ind' in df.columns else pd.NA\n    df['Year'] = df['alldeaths'] if 'alldeaths' in df.columns else pd.NA\n\n    # Derived transforms\n    # log transform deaths for OLS robustness\n    df['logDeaths'] = np.log1p(df['Deaths'])\n    # log transform property damage to reduce skew\n    df['logPropertyDamage'] = np.log1p(df['PropertyDamage'].clip(lower=0))\n\n    # Drop rows missing the core variables necessary for the primary analysis\n    required = ['FemininityScore', 'FemaleName', 'Deaths', 'Wind', 'MinPressure']\n    df = df.dropna(subset=required)\n\n    # Reset index\n    df = df.reset_index(drop=True)\n\n    return df\n",
  "m_code": "def model(df: pd.DataFrame) -> Any:\n    \"\"\"\n    Fit the primary statistical models to test whether more feminine hurricane names predict\n    lower human tolls (fewer deaths), controlling for storm severity and year.\n\n    Primary specification: Negative Binomial (counts, accommodates overdispersion):\n      Deaths ~ FemininityScore + FemaleName + Wind + MinPressure + SaffirCategory + logPropertyDamage + Year\n\n    Robustness: OLS on logDeaths with the same covariates.\n\n    Returns a dict with the fitted results objects for inspection.\n    \"\"\"\n    import statsmodels.formula.api as smf\n    import statsmodels.api as sm\n\n    # Ensure we have the expected columns\n    model_df = df.copy()\n\n    # Formula for models\n    formula = (\n        'Deaths ~ FemininityScore + FemaleName + Wind + MinPressure + '\n        'SaffirCategory + logPropertyDamage + Year'\n    )\n\n    # Fit Negative Binomial via GLM (handles overdispersion relative to Poisson)\n    try:\n        nb_model = smf.glm(formula=formula, data=model_df,\n                           family=sm.families.NegativeBinomial()).fit()\n    except Exception as e:\n        # If NegativeBinomial family not available or fails, fall back to Poisson and report\n        nb_model = None\n        poisson_model = None\n        try:\n            poisson_model = smf.glm(formula=formula, data=model_df,\n                                    family=sm.families.Poisson()).fit()\n        except Exception:\n            poisson_model = None\n\n    # Robustness OLS on log-transformed deaths\n    ols_formula = ('logDeaths ~ FemininityScore + FemaleName + Wind + MinPressure + '\n                   'SaffirCategory + logPropertyDamage + Year')\n    ols_model = smf.ols(formula=ols_formula, data=model_df).fit()\n\n    results = {\n        'nb_model': nb_model,\n        'poisson_model_fallback': poisson_model if 'poisson_model' in locals() else None,\n        'ols_model': ols_model\n    }\n\n    return results\n"
