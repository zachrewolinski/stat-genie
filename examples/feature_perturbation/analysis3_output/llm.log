  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    # Work on a copy\n    df = df.copy()\n\n    # Ensure relevant columns are numeric (coerce errors to NaN)\n    numeric_cols = ['ndam15', 'name', 'elapsedyrs', 'wind', 'min', 'masfem', 'alldeaths', 'ind']\n    for c in numeric_cols:\n        if c in df.columns:\n            df[c] = pd.to_numeric(df[c], errors='coerce')\n\n    # Keep only rows with the variables needed for the main analysis\n    # Main DV ndam15 (total deaths) and main IV name (masc-fem rating) and core controls\n    required = ['ndam15', 'name', 'wind', 'min', 'masfem', 'alldeaths', 'elapsedyrs']\n    present_required = [c for c in required if c in df.columns]\n    df = df.dropna(subset=present_required)\n\n    # Create dependent variable: log-transformed deaths to reduce skew\n    # Add 1 to allow zero-death storms\n    df['log_deaths'] = np.log(df['ndam15'] + 1)\n\n    # Center the continuous name femininity score for interpretability\n    df['name_c'] = df['name'] - df['name'].mean()\n\n    # Ensure binary elapsedyrs is 0/1\n    df['elapsedyrs'] = df['elapsedyrs'].astype(int)\n\n    # Optionally keep the original columns used in modeling\n    # Final dataframe will include: ndam15, log_deaths, name, name_c, elapsedyrs, wind, min, masfem, alldeaths\n    keep_cols = ['ndam15', 'log_deaths', 'name', 'name_c', 'elapsedyrs', 'wind', 'min', 'masfem', 'alldeaths']\n    keep_cols = [c for c in keep_cols if c in df.columns]\n    df = df[keep_cols]\n\n    return df\n",
  "m_code": "def model(df: pd.DataFrame) -> dict:\n    # Fit OLS models predicting log_deaths from name femininity and controls.\n    # Returns a dict with two fitted models for comparison:\n    #  - model_name: continuous name femininity (name_c) as primary IV\n    #  - model_binary: binary female-name indicator (elapsedyrs) as primary IV\n\n    import statsmodels.api as sm\n\n    results = {}\n\n    # Prepare design matrix for model using continuous name score\n    X_cols_name = [c for c in ['name_c', 'elapsedyrs', 'wind', 'min', 'masfem', 'alldeaths'] if c in df.columns]\n    X1 = df[X_cols_name]\n    X1 = sm.add_constant(X1)\n    y = df['log_deaths']\n    model_name = sm.OLS(y, X1).fit()\n    results['model_name'] = model_name\n\n    # Prepare design matrix for model using binary name gender as primary IV\n    X_cols_bin = [c for c in ['elapsedyrs', 'wind', 'min', 'masfem', 'alldeaths'] if c in df.columns]\n    X2 = df[X_cols_bin]\n    X2 = sm.add_constant(X2)\n    model_binary = sm.OLS(y, X2).fit()\n    results['model_binary'] = model_binary\n\n    # Return the fitted results objects (statsmodels.Result objects). Callers can inspect summary() or params, bse, pvalues, etc.\n    return results\n"
}
