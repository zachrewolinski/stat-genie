  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Clean and derive variables needed for modeling the relationship between hurricane name femininity\n    and casualties (proxy for precautionary behavior). The function returns a dataframe containing all\n    columns listed in the conceptual variables.\n    Created columns (used later in the model):\n      - Femininity: continuous femininity score (from original 'name' column)\n      - FemaleName: binary indicator (from 'elapsedyrs') 1=female name, 0=male name\n      - Deaths: raw deaths count from 'ndam15'\n      - LogDeaths: np.log(Deaths + 1)\n      - Wind: maximum wind speed at landfall from 'wind'\n      - MinPressure: minimum pressure at landfall from 'min'\n      - CategoryScale: category / Saffir-like numeric from 'masfem'\n      - Damage: economic damage from 'ind'\n      - LogDamage: np.log(Damage + 1)\n      - Year: year of storm from 'alldeaths'\n      - standardized (_z) versions for continuous predictors used in the model\n    \"\"\"\n    df = df.copy()\n\n    # Ensure numeric types where expected; coerce non-numeric to NaN\n    df['Femininity'] = pd.to_numeric(df.get('name', None), errors='coerce')\n    # elapsedyrs in this dataset is coded as binary gender indicator (0 male, 1 female)\n    df['FemaleName'] = pd.to_numeric(df.get('elapsedyrs', None), errors='coerce')\n\n    df['Deaths'] = pd.to_numeric(df.get('ndam15', None), errors='coerce')\n    df['Wind'] = pd.to_numeric(df.get('wind', None), errors='coerce')\n    df['MinPressure'] = pd.to_numeric(df.get('min', None), errors='coerce')\n    df['CategoryScale'] = pd.to_numeric(df.get('masfem', None), errors='coerce')\n    df['Damage'] = pd.to_numeric(df.get('ind', None), errors='coerce')\n    df['Year'] = pd.to_numeric(df.get('alldeaths', None), errors='coerce')\n\n    # Build log-transformed outcomes / controls (add small constant to avoid log(0))\n    df['LogDeaths'] = np.log(df['Deaths'].fillna(0) + 1)\n    df['LogDamage'] = np.log(df['Damage'].fillna(0) + 1)\n\n    # Drop rows missing primary variables required for model: Femininity (IV) and Deaths (DV)\n    # Also drop rows missing core intensity controls as those are essential confounds\n    required_cols = ['Femininity', 'Deaths', 'Wind', 'CategoryScale']\n    df = df.dropna(subset=required_cols)\n\n    # Standardize continuous predictors (z-scores) used in the model for easier interpretation\n    def z(col: pd.Series) -> pd.Series:\n        return (col - col.mean()) / (col.std(ddof=0) if col.std(ddof=0) != 0 else 1.0)\n\n    df['Femininity_z'] = z(df['Femininity'])\n    df['Wind_z'] = z(df['Wind'])\n    # For MinPressure, higher pressure often means weaker storm; keep as-is but z-score it\n    df['MinPressure_z'] = z(df['MinPressure'].fillna(df['MinPressure'].mean()))\n    df['CategoryScale_z'] = z(df['CategoryScale'])\n    df['LogDamage_z'] = z(df['LogDamage'])\n\n    # Ensure FemaleName is binary 0/1 where possible\n    df['FemaleName'] = df['FemaleName'].apply(lambda x: 1 if x == 1 else (0 if x == 0 else np.nan))\n\n    # Final drop of rows with any remaining NaNs in variables we will use in the model\n    model_columns = [\n        'LogDeaths', 'Femininity_z', 'FemaleName',\n        'Wind_z', 'MinPressure_z', 'CategoryScale_z', 'LogDamage_z', 'Year'\n    ]\n    df = df.dropna(subset=model_columns)\n\n    # Keep only the columns relevant for subsequent modeling (plus an identifier if available)\n    keep_cols = model_columns + ['Deaths', 'Femininity', 'Wind', 'MinPressure', 'CategoryScale', 'Damage']\n    # If source column exists include as ID\n    if 'source' in df.columns:\n        keep_cols = ['source'] + keep_cols\n\n    return df[keep_cols]\n",
  "m_code": "def model(df: pd.DataFrame) -> sm.regression.linear_model.RegressionResultsWrapper:\n    \"\"\"\n    Fit an OLS model predicting log deaths (LogDeaths) from name femininity and controls.\n    Primary specification: OLS on LogDeaths with robust (HC3) standard errors.\n\n    Primary independent variable: Femininity_z (continuous). Alternative indicator FemaleName is available\n    but the model below uses the continuous femininity index as the main test. If desired, run an\n    alternative specification replacing Femininity_z with FemaleName.\n\n    Returns the fitted statsmodels results object.\n    \"\"\"\n    # Required columns check\n    required = ['LogDeaths', 'Femininity_z', 'Wind_z', 'MinPressure_z', 'CategoryScale_z', 'LogDamage_z', 'Year']\n    missing = [c for c in required if c not in df.columns]\n    if missing:\n        raise ValueError(f\"Dataframe is missing required columns for modeling: {missing}\")\n\n    # Design matrix\n    X_cols = ['Femininity_z', 'Wind_z', 'MinPressure_z', 'CategoryScale_z', 'LogDamage_z', 'Year']\n    X = df[X_cols].astype(float)\n    X = sm.add_constant(X)\n    y = df['LogDeaths'].astype(float)\n\n    # Fit OLS with robust standard errors (HC3)\n    model = sm.OLS(y, X).fit(cov_type='HC3')\n\n    # Return the fitted results object (user can inspect .summary(), .params, .bse, etc.)\n    return model\n"
