  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Transform the raw hurricane dataframe into a modeling-ready dataframe.\n\n    Produces the following new columns used in the model:\n      - masfem: continuous femininity index (from feature4)\n      - female_name: binary gender indicator (from feature6)\n      - deaths: raw fatalities (from feature8)\n      - log_deaths: np.log(deaths + 1)\n      - max_wind: maximum wind speed at landfall (from feature13)\n      - min_pressure: minimum pressure at landfall (from feature5)\n      - saffir_cat: raw Saffir-Simpson category (from feature7)\n      - saffir_2..saffir_5: dummy variables for Saffir categories 2-5 (category 1 is reference)\n      - year: calendar year (from feature2)\n      - year_centered: year - mean(year)\n      - log_damage: np.log(feature14 + 1)\n\n    Drops rows with missing values in key variables.\n    \"\"\"\n    df = df.copy()\n\n    # Required raw columns referenced in the dataset description\n    required_cols = [\n        'feature2',  # year\n        'feature4',  # masfem index\n        'feature5',  # min pressure\n        'feature7',  # saffir category\n        'feature8',  # deaths\n        'feature13', # max wind\n        'feature14', # property damage (2015 normalized)\n        'feature6'   # binary gender indicator\n    ]\n\n    # Drop rows that are missing any of the variables we will use\n    df = df.dropna(subset=required_cols)\n\n    # Create analysis columns\n    df['masfem'] = df['feature4'].astype(float)  # higher = more feminine (1-11 scale in description)\n    # keep masfem standardized for interpretability in models\n    df['masfem_z'] = (df['masfem'] - df['masfem'].mean()) / (df['masfem'].std(ddof=0) if df['masfem'].std(ddof=0) != 0 else 1.0)\n\n    df['female_name'] = df['feature6'].astype(int)  # 0 male, 1 female\n\n    df['deaths'] = df['feature8'].astype(float)\n    df['log_deaths'] = np.log(df['deaths'] + 1.0)\n\n    df['max_wind'] = df['feature13'].astype(float)\n    df['min_pressure'] = df['feature5'].astype(float)\n\n    df['saffir_cat'] = df['feature7'].astype(int)\n\n    # Create Saffir category dummies, drop category 1 to use as reference\n    saffir_dummies = pd.get_dummies(df['saffir_cat'], prefix='saffir')\n    if 'saffir_1' in saffir_dummies.columns:\n        saffir_dummies = saffir_dummies.drop(columns=['saffir_1'])\n    # Ensure columns for saffir_2..saffir_5 exist even if some categories are not present in small samples\n    for k in range(2, 6):\n        col = f'saffir_{k}'\n        if col not in saffir_dummies.columns:\n            saffir_dummies[col] = 0\n\n    # Align column order\n    saffir_dummies = saffir_dummies[[f'saffir_{k}' for k in range(2, 6)]]\n    df = pd.concat([df, saffir_dummies], axis=1)\n\n    # Year variables\n    df['year'] = df['feature2'].astype(int)\n    df['year_centered'] = df['year'] - df['year'].mean()\n\n    # Logged property damage as proxy for exposure/impact\n    # Fill missing damages with 0 before logging (no reported damage)\n    df['log_damage'] = np.log(df['feature14'].fillna(0.0) + 1.0)\n\n    # Keep only the columns necessary for modeling and diagnostics. Also keep masfem_z for modeling.\n    keep_cols = [\n        'masfem', 'masfem_z', 'female_name', 'deaths', 'log_deaths', 'max_wind', 'min_pressure',\n        'saffir_2', 'saffir_3', 'saffir_4', 'saffir_5', 'year', 'year_centered', 'log_damage'\n    ]\n\n    # If any of the newly created columns are missing (shouldn't be), fill with zeros as a fallback\n    for c in keep_cols:\n        if c not in df.columns:\n            df[c] = 0\n\n    return df[keep_cols]\n",
  "m_code": "def model(df: pd.DataFrame):\n    \"\"\"\n    Fit two linear OLS models predicting log_deaths.\n\n    Model A: continuous femininity index (masfem_z) + controls\n    Model B: binary female_name indicator + controls (sensitivity)\n\n    Both models use heteroskedasticity-robust (HC3) standard errors.\n\n    Returns a dictionary with fitted model Result objects.\n    \"\"\"\n    import statsmodels.api as sm\n\n    # Ensure the expected columns are present\n    required = ['log_deaths', 'masfem_z', 'female_name', 'max_wind', 'min_pressure',\n                'saffir_2', 'saffir_3', 'saffir_4', 'saffir_5', 'year_centered', 'log_damage']\n    missing = [c for c in required if c not in df.columns]\n    if missing:\n        raise ValueError(f\"Dataframe is missing required columns for modeling: {missing}\")\n\n    # Common controls\n    control_cols = ['max_wind', 'min_pressure', 'year_centered', 'log_damage',\n                    'saffir_2', 'saffir_3', 'saffir_4', 'saffir_5']\n\n    # Model A: continuous masfem (standardized)\n    XA = df[['masfem_z'] + control_cols].astype(float)\n    XA = sm.add_constant(XA)\n    y = df['log_deaths'].astype(float)\n    model_a = sm.OLS(y, XA).fit(cov_type='HC3')\n\n    # Model B: binary female_name\n    XB = df[['female_name'] + control_cols].astype(float)\n    XB = sm.add_constant(XB)\n    model_b = sm.OLS(y, XB).fit(cov_type='HC3')\n\n    # Return both fitted results for inspection. Caller can print model.summary() as needed.\n    return {\n        'model_masfem_continuous': model_a,\n        'model_gender_binary': model_b\n    }\n"
}
