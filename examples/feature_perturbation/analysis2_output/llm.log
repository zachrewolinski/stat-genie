  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    # Rename features to meaningful variable names and work on a copy\n    df = df.rename(columns={\n        'feature1': 'StormID',\n        'feature2': 'Year',\n        'feature3': 'Name',\n        'feature4': 'MasFem',\n        'feature5': 'MinPressure',\n        'feature6': 'NameGender',\n        'feature7': 'Category',\n        'feature8': 'Fatalities',\n        'feature9': 'Damage_norm2013',\n        'feature10': 'YearsSince',\n        'feature11': 'Source',\n        'feature12': 'MTurkMasFem',\n        'feature13': 'MaxWind',\n        'feature14': 'Damage_norm2015'\n    }).copy()\n\n    # Coerce key columns to numeric where appropriate (safely)\n    numeric_cols = ['MasFem', 'MinPressure', 'NameGender', 'Category', 'Fatalities',\n                    'Damage_norm2013', 'YearsSince', 'MTurkMasFem', 'MaxWind',\n                    'Damage_norm2015', 'Year']\n    for c in numeric_cols:\n        if c in df.columns:\n            df[c] = pd.to_numeric(df[c], errors='coerce')\n\n    # Drop rows missing essential variables needed for modeling\n    required = ['MasFem', 'Fatalities', 'MaxWind', 'MinPressure', 'Category', 'Year']\n    df = df.dropna(subset=[c for c in required if c in df.columns])\n\n    # Standardize continuous femininity measures for interpretation\n    # Use population std (ddof=0) for stable z-score\n    df['MasFem_z'] = (df['MasFem'] - df['MasFem'].mean()) / (df['MasFem'].std(ddof=0) if df['MasFem'].std(ddof=0) != 0 else 1)\n\n    if 'MTurkMasFem' in df.columns:\n        df['MTurkMasFem_z'] = (df['MTurkMasFem'] - df['MTurkMasFem'].mean()) / (df['MTurkMasFem'].std(ddof=0) if df['MTurkMasFem'].std(ddof=0) != 0 else 1)\n    else:\n        df['MTurkMasFem_z'] = np.nan\n\n    # Ensure binary gender indicator is integer 0/1\n    df['NameGender'] = df['NameGender'].round().astype(int)\n\n    # Create a centered year covariate to aid interpretation and reduce collinearity\n    df['Year_c'] = df['Year'] - df['Year'].mean()\n\n    # Ensure Category is treated as integer-coded categorical\n    df['Category'] = df['Category'].astype(int)\n\n    # Final check: Fatalities must be non-negative integer counts\n    df['Fatalities'] = df['Fatalities'].fillna(0).astype(int)\n\n    # Return transformed dataframe containing all columns used in modeling\n    # (plus useful originals)\n    keep_cols = ['StormID', 'Year', 'Year_c', 'Name', 'MasFem', 'MasFem_z', 'MTurkMasFem', 'MTurkMasFem_z',\n                 'NameGender', 'Category', 'MaxWind', 'MinPressure', 'Fatalities',\n                 'Damage_norm2013', 'Damage_norm2015', 'Source', 'YearsSince']\n    cols_present = [c for c in keep_cols if c in df.columns]\n    return df[cols_present]\n",
  "m_code": "def model(df: pd.DataFrame) -> dict:\n    \"\"\"\n    Runs several regression specifications appropriate for a count outcome (Fatalities).\n    Primary specification: negative binomial GLM with continuous MasFem_z.\n    Secondary specification: negative binomial GLM with binary NameGender.\n    Returns a dict of fitted results objects for further inspection.\n    \"\"\"\n    import statsmodels.formula.api as smf\n    import statsmodels.api as sm\n\n    results = {}\n\n    # Formula using standardized femininity score\n    formula_mas = 'Fatalities ~ MasFem_z + MaxWind + MinPressure + C(Category) + Year_c'\n\n    # Negative binomial (preferred for overdispersed counts)\n    try:\n        nb1 = smf.glm(formula=formula_mas, data=df, family=sm.families.NegativeBinomial()).fit()\n        results['masfem_nb'] = nb1\n    except Exception as e:\n        # If NegativeBinomial is unavailable or fails, fall back to Poisson with robust SEs\n        pois1 = smf.glm(formula=formula_mas, data=df, family=sm.families.Poisson()).fit(cov_type='HC0')\n        results['masfem_poisson_robust'] = pois1\n\n    # Binary name-gender specification\n    formula_bin = 'Fatalities ~ NameGender + MaxWind + MinPressure + C(Category) + Year_c'\n    try:\n        nb2 = smf.glm(formula=formula_bin, data=df, family=sm.families.NegativeBinomial()).fit()\n        results['genderbin_nb'] = nb2\n    except Exception as e:\n        pois2 = smf.glm(formula=formula_bin, data=df, family=sm.families.Poisson()).fit(cov_type='HC0')\n        results['genderbin_poisson_robust'] = pois2\n\n    # Robustness: use MTurk rating if available\n    if 'MTurkMasFem_z' in df.columns and not df['MTurkMasFem_z'].isna().all():\n        formula_mturk = 'Fatalities ~ MTurkMasFem_z + MaxWind + MinPressure + C(Category) + Year_c'\n        try:\n            nb3 = smf.glm(formula=formula_mturk, data=df, family=sm.families.NegativeBinomial()).fit()\n            results['mturk_masfem_nb'] = nb3\n        except Exception:\n            pois3 = smf.glm(formula=formula_mturk, data=df, family=sm.families.Poisson()).fit(cov_type='HC0')\n            results['mturk_masfem_poisson_robust'] = pois3\n\n    # Return dictionary of fitted results (statsmodels results objects). The caller can inspect .summary().\n    return results\n"
}
