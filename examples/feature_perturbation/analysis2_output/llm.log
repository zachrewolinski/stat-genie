  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    # Work on a copy\n    df = df.copy()\n\n    # Rename raw feature columns to meaningful names used in modeling\n    rename_map = {\n        'feature1': 'StormID',\n        'feature2': 'Year',\n        'feature3': 'Name',\n        'feature4': 'MasFem',            # continuous masculinity-femininity index\n        'feature5': 'MinPressure',\n        'feature6': 'FemaleName',        # binary 0 male / 1 female\n        'feature7': 'Category',\n        'feature8': 'Deaths',\n        'feature9': 'Damage2013',\n        'feature10': 'YearsSince',\n        'feature11': 'Source',\n        'feature12': 'MasFem_MTurk',     # MTurk alternative femininity rating\n        'feature13': 'MaxWind',\n        'feature14': 'Damage2015'\n    }\n    df = df.rename(columns=rename_map)\n\n    # Ensure numeric types where expected\n    numeric_cols = ['MasFem', 'MinPressure', 'FemaleName', 'Category', 'Deaths', 'Damage2013',\n                    'YearsSince', 'MasFem_MTurk', 'MaxWind', 'Damage2015', 'Year']\n    for c in numeric_cols:\n        if c in df.columns:\n            # coerce to numeric; keep NaN if cannot parse\n            df[c] = pd.to_numeric(df[c], errors='coerce')\n\n    # Drop rows missing the dependent variable or primary independent variable or core intensity controls\n    required = ['Deaths', 'MasFem', 'MaxWind', 'MinPressure', 'Category', 'Year']\n    required = [c for c in required if c in df.columns]\n    df = df.dropna(subset=required)\n\n    # Create log-transformed fatalities outcome to reduce skew\n    df['LogDeaths'] = np.log(df['Deaths'].fillna(0) + 1)\n\n    # Log-transform Damage2015 if available for potential secondary analyses\n    if 'Damage2015' in df.columns:\n        df['LogDamage2015'] = np.log(df['Damage2015'].fillna(0) + 1)\n\n    # If FemaleName is not strictly 0/1, coerce to 0/1\n    if 'FemaleName' in df.columns:\n        df['FemaleName'] = df['FemaleName'].apply(lambda v: 1 if v == 1 else (0 if v == 0 else np.nan))\n        # do not drop rows where FemaleName is NA here; we'll keep MasFem as primary IV\n\n    # Create dummy variables for Source (drop first to avoid multicollinearity)\n    if 'Source' in df.columns:\n        # Clean source strings (trim) and create dummies\n        df['Source'] = df['Source'].astype(str).str.strip()\n        source_dummies = pd.get_dummies(df['Source'], prefix='Source', dummy_na=False)\n        if source_dummies.shape[1] > 0:\n            # drop the first column to serve as reference\n            source_dummies = source_dummies.iloc[:, 1:]\n            df = pd.concat([df, source_dummies], axis=1)\n\n    # Keep only columns needed for modeling to simplify downstream usage\n    keep_cols = ['StormID', 'Year', 'Name', 'MasFem', 'FemaleName', 'MasFem_MTurk',\n                 'MaxWind', 'MinPressure', 'Category', 'Deaths', 'LogDeaths']\n    if 'LogDamage2015' in df.columns:\n        keep_cols.append('LogDamage2015')\n    # include any Source_* dummies that were created\n    keep_cols += [c for c in df.columns if c.startswith('Source_')]\n\n    keep_cols = [c for c in keep_cols if c in df.columns]\n    df = df[keep_cols]\n\n    return df\n",
  "m_code": "def model(df: pd.DataFrame):\n    # Fit an OLS model predicting log fatalities from name femininity and controls.\n    # Uses heteroskedasticity-consistent (HC3) standard errors.\n\n    df = df.copy()\n\n    # Define predictors to use. Source dummies (if present) are included automatically.\n    source_cols = [c for c in df.columns if c.startswith('Source_')]\n\n    # Core regressors\n    regressors = ['MasFem', 'FemaleName', 'MaxWind', 'MinPressure', 'Category', 'Year']\n    regressors = [r for r in regressors if r in df.columns]\n    regressors += source_cols\n\n    # Prepare X and y\n    X = df[regressors].astype(float)\n    X = sm.add_constant(X)\n    y = df['LogDeaths']\n\n    # Fit model with robust (HC3) standard errors\n    model = sm.OLS(y, X).fit(cov_type='HC3')\n\n    # Return the fitted model object (has .summary(), .params, etc.)\n    return model\n"
