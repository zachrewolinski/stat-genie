        ]
      }
    ],
    "dv": {
      "description": "Total number of fish caught during the visit (count outcome). Modeled as a rate per hour using an offset.",
      "columns": [
        "fish_caught"
      ]
    },
    "controls": [
      {
        "description": "Total hours the group spent in the park (positive numeric). Treated as an exposure (offset) in the count model; models the rate of fish caught per hour.",
