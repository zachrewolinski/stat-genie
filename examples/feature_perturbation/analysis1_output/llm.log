alldeaths + 1)\n    if 'log_alldeaths_plus1' in model_df.columns:\n        ols_formula = 'log_alldeaths_plus1 ~ ' + ' + '.join(formula_terms[0:])\n        ols_model = smf.ols(formula=ols_formula, data=model_df)\n        ols_result = ols_model.fit(cov_type='HC3')\n        results['ols_result'] = ols_result\n\n    # Return fitted results objects for inspection. Users can call .summary() on each as needed.\n    return results\n"
