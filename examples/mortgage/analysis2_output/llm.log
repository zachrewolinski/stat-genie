  "transform_code": "def transform(df: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"\n    Prepare the dataset for modeling.\n    - Constructs a single approval column 'approved' (1=approved,0=denied).\n    - Maps relevant features to clear column names.\n    - Standardizes continuous variables used as controls (z-scores): amount, debt_to_income, loan_to_value.\n    - Drops rows with missing values in the final modeling columns.\n\n    Final columns created and returned (minimum set used by the model):\n      - approved, female, black, self_employed, married, bad_credit,\n        mortgage_score, consumer_score, amount_z, debt_to_income_z, loan_to_value_z, pmi_denied\n    \"\"\"\n    df = df.copy()\n\n    # Create approval indicator. Prefer feature14 if present (1=accepted,0=denied).\n    if 'feature14' in df.columns:\n        df['approved'] = pd.to_numeric(df['feature14'], errors='coerce')\n    elif 'feature11' in df.columns:\n        # feature11: 1 if denied, 0 if accepted -> invert\n        df['approved'] = 1 - pd.to_numeric(df['feature11'], errors='coerce')\n    else:\n        raise ValueError('Neither feature14 nor feature11 found to derive approval outcome')\n\n    # Map main independent variable (gender)\n    if 'feature2' in df.columns:\n        df['female'] = pd.to_numeric(df['feature2'], errors='coerce')\n    else:\n        raise ValueError('feature2 (gender) is required but not present')\n\n    # Controls mapping (binary flags and numeric predictors)\n    df['black'] = pd.to_numeric(df['feature3'], errors='coerce') if 'feature3' in df.columns else np.nan\n    df['self_employed'] = pd.to_numeric(df['feature5'], errors='coerce') if 'feature5' in df.columns else np.nan\n    df['married'] = pd.to_numeric(df['feature6'], errors='coerce') if 'feature6' in df.columns else np.nan\n    df['mortgage_score'] = pd.to_numeric(df['feature7'], errors='coerce') if 'feature7' in df.columns else np.nan\n    df['consumer_score'] = pd.to_numeric(df['feature8'], errors='coerce') if 'feature8' in df.columns else np.nan\n    df['bad_credit'] = pd.to_numeric(df['feature9'], errors='coerce') if 'feature9' in df.columns else np.nan\n    df['debt_to_income'] = pd.to_numeric(df['feature10'], errors='coerce') if 'feature10' in df.columns else np.nan\n    df['pmi_denied'] = pd.to_numeric(df['feature13'], errors='coerce') if 'feature13' in df.columns else np.nan\n    df['loan_to_value'] = pd.to_numeric(df['feature12'], errors='coerce') if 'feature12' in df.columns else np.nan\n    df['amount'] = pd.to_numeric(df['feature1'], errors='coerce') if 'feature1' in df.columns else np.nan\n\n    # Specify the final columns we will use in the model\n    final_cols = [\n        'approved', 'female', 'black', 'self_employed', 'married', 'bad_credit',\n        'mortgage_score', 'consumer_score', 'amount', 'debt_to_income', 'loan_to_value', 'pmi_denied'\n    ]\n\n    # Drop rows with missing values in any of the modeling columns\n    df = df.dropna(subset=final_cols)\n\n    # Standardize continuous predictors (z-score). Using sample std (ddof=1) for scaling.\n    for col in ['amount', 'debt_to_income', 'loan_to_value']:\n        zcol = col + '_z'\n        mean = df[col].mean()\n        std = df[col].std(ddof=1)\n        if std == 0 or np.isnan(std):\n            # If no variation, create zero column to avoid division by zero.\n            df[zcol] = 0.0\n        else:\n            df[zcol] = (df[col] - mean) / std\n\n    # Keep only the columns required for modeling (makes the downstream model code explicit)\n    model_ready_cols = [\n        'approved', 'female', 'black', 'self_employed', 'married', 'bad_credit',\n        'mortgage_score', 'consumer_score', 'amount_z', 'debt_to_income_z', 'loan_to_value_z', 'pmi_denied'\n    ]\n\n    return df[model_ready_cols]\n",
